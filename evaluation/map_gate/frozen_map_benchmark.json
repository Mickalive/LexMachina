  "gates": {
    "MAP::cluster_membership_enumerable": {
      "bar": "0 cluster-assigned decisions unreachable and 0 clusters whose declared size != enumerated member_ids",
      "definition": "Every decision carrying a cluster_id must appear in its cluster's member_ids, and every cluster's declared `size` must equal len(member_ids). A shipped group the consumer cannot enumerate is not 'a coherent group of retrieved decisions'; drill-down, cluster-scoped relation edges and cluster-level counter-authority sweeps are all truncated with it.",
      "fails_when": "unreachable_count > 0 or size_mismatch_count > 0"
    },
    "MAP::counter_authority_selectable": {
      "bar": "every counter-status decision is cluster-enumerable AND not stranded in an over-full coordinate cell",
      "definition": "Master Prompt: counter authorities must remain visible and 'visually discoverable'. This gate is the conjunction of two already-frozen primitives applied to the counter subset, so it introduces NO new threshold. A bundle with no counter-status row is not_measurable with an explicit reason and never counts as a pass.",
      "fails_when": "any counter decision fails either primitive"
    },
    "MAP::label_language_matches_query": {
      "bar": "label_language_min_share (0.8) of clusters not unambiguously off-language",
      "definition": "A cluster label is off-language when every one of its lexicon-attributed tokens belongs to exactly one language and that language is not the bundle's query language. Tokens attributed to several languages, and tokens absent from the lexicon (all content words), are ignored -- so the gate only fires on unambiguous evidence and under-reports otherwise.",
      "fails_when": "share_of_off_language_labels > 1 - 0.8"
    },
    "MAP::outlier_degree_consistent": {
      "bar": "mean relation degree of flagged outliers < mean relation degree of non-flagged rows; an empty relations list is DEGENERATE and FAILS",
      "definition": "Master Prompt: 'outlier = weakly connected/isolated result worth inspecting'. The flag is checked against the SHIPPED relations graph only -- no clustering, no re-projection, no numpy. A degenerate graph cannot support the claim, so it fails rather than passes vacuously.",
      "fails_when": "degenerate or mean_outlier_degree >= mean_other_degree"
    },
    "MAP::points_distinguishable": {
      "bar": "max_coincident_cell_share <= 0.01",
      "definition": "No single rounded (x, y) cell may hold more than 1% of the bundle's decisions. Measures whether each decision is individually selectable as a point.",
      "fails_when": "max_cell_share > 0.01"
    }
  },
  "inclusion_rule": {
    "min_clusters": 2,
    "min_decisions": 50,
    "order": "ascending by repository-relative path",
    "require_finite_xy_on_every_row": true,
    "root": "results/product",
    "selection_discretion": "none; the benchmark is the whole in-scope inventory"
  },
