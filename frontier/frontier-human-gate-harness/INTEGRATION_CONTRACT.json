  "boot_snippet": "LexGateSwitch.attach({ getBundle: function(){ return BUNDLE; }, mapEl: document.getElementById('mapWrap'), listEl: document.getElementById('lexListView'), toolbarEl: document.getElementById('toolbar'), statusEl: document.getElementById('status'), session_id: null, mountExportButton: true })",
