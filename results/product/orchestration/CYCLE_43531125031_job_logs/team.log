2026-11-14T00:03:14.4802499Z }
2026-11-14T00:03:14.4802599Z 
2026-11-14T00:03:14.4802805Z #: The accepted guarded/unguarded arm measurement this cycle must not regress.
2026-11-14T00:03:14.4803261Z #: Read-only comparison baseline; its numbers are NEVER rewritten.
2026-11-14T00:03:14.4803583Z ACCEPTED_V3_ARM_ARTIFACT = (
2026-11-14T00:03:14.4803843Z     ROOT / "results" / "product" / "counter_span"
2026-11-14T00:03:14.4804124Z     / "CYCLE_39986094168_span_selection.json"
2026-11-14T00:03:14.4804363Z )
2026-11-14T00:03:14.4804457Z 
2026-11-14T00:03:14.4804460Z 
2026-11-14T00:03:14.4804644Z #: Ad-hoc verification outputs (``<run>_verify/`` or ``*_verify/``) are written
2026-11-14T00:03:14.4805077Z #: by every cycle that re-renders the slice.  They carry the same fixed-path
2026-11-14T00:03:14.4805528Z #: provenance as a flagship bundle, so a provenance-only selector would grow the
2026-11-14T00:03:14.4805969Z #: "fixed-path family" by one 100-decision bundle on every verification cycle
2026-11-14T00:03:14.4806392Z #: and thereby move a previously published family measurement (49 bundles /
2026-11-14T00:03:14.4806819Z #: 4900 decisions / 55 verified) without any change to the shipped pipeline.
2026-11-14T00:03:14.4807262Z #: Those outputs are still measured under ``all_committed`` and reported by the
2026-11-14T00:03:14.4807693Z #: end-to-end slice summary; they are simply not members of the frozen
2026-11-14T00:03:14.4808190Z #: flagship family.  This keeps the family definition stable across cycles.
2026-11-14T00:03:14.4808569Z _VERIFY_DIR_RE = re.compile(r"(?:^|/)[^/]*_verify/")
2026-11-14T00:03:14.4808763Z 
2026-11-14T00:03:14.4808767Z 
2026-11-14T00:03:14.4808877Z def all_bundle_paths() -> list[Path]:
2026-11-14T00:03:14.4809210Z     """Every committed bundle, including ad-hoc verification outputs."""
2026-11-14T00:03:14.4809533Z     patterns = (
2026-11-14T00:03:14.4809781Z         "results/product/offline_slice/*/*.bundle.json",
2026-11-14T00:03:14.4810109Z         "results/product/server_slice/*/*.bundle.json",
2026-11-14T00:03:14.4810378Z     )
2026-11-14T00:03:14.4810566Z     out: list[Path] = []
2026-11-14T00:03:14.4810792Z     for pat in patterns:
2026-11-14T00:03:14.4811169Z         out.extend(Path(p) for p in glob.glob(str(ROOT / pat)))
2026-11-14T00:03:14.4811479Z     return sorted(set(out))
2026-11-14T00:03:14.4811623Z 
2026-11-14T00:03:14.4811631Z 
2026-11-14T00:03:14.4811766Z def is_verification_bundle(path: str | Path) -> bool:
2026-11-14T00:03:14.4812137Z     """True when the bundle lives in a ``*_verify/`` verification directory."""
2026-11-14T00:03:14.4812470Z     p = Path(path)
2026-11-14T00:03:14.4812766Z     rel = p.relative_to(ROOT).as_posix() if p.is_absolute() else p.as_posix()
2026-11-14T00:03:14.4813124Z     return bool(_VERIFY_DIR_RE.search(rel))
2026-11-14T00:03:14.4813304Z 
2026-11-14T00:03:14.4813307Z 
2026-11-14T00:03:14.4813407Z def bundle_paths() -> list[Path]:
2026-11-14T00:03:14.4813716Z     """Every committed *flagship* bundle, sorted for determinism.
2026-11-14T00:03:14.4813949Z 
2026-11-14T00:03:14.4814141Z     Verification-only directories are excluded (see :data:`_VERIFY_DIR_RE`):
2026-11-14T00:03:14.4814675Z     each cycle writes one, and letting them join the family would silently move
2026-11-14T00:03:14.4815089Z     the frozen 49-bundle / 4900-decision baseline.  They remain in
2026-11-14T00:03:14.4815449Z     ``all_committed`` and in the per-cycle slice summary.
2026-11-14T00:03:14.4815726Z     """
2026-11-14T00:03:14.4815998Z     return [p for p in all_bundle_paths() if not is_verification_bundle(p)]
2026-11-14T00:03:14.4816247Z 
2026-11-14T00:03:14.4816250Z 
2026-11-14T00:03:14.4816371Z def _has_fixed_path_provenance(doc: dict) -> bool:
2026-11-14T00:03:14.4816742Z     cf = ((doc.get("provenance") or {}).get("counter_evidence_span") or {}).get(
2026-11-14T00:03:14.4817089Z         "content_filter"
2026-11-14T00:03:14.4817289Z     )
2026-11-14T00:03:14.4817494Z     return isinstance(cf, dict) and bool(cf)
2026-11-14T00:03:14.4817665Z 
