2026-11-14T00:04:27.6879593Z     assert orch["audit"]["gate_step"] == "skipped"
2026-11-14T00:04:27.6879994Z     assert orch["audit"]["persist_step"] == "skipped"
2026-11-14T00:04:27.6880312Z     assert orch["audit"]["gate_file_written"] is False
2026-11-14T00:04:27.6880634Z     assert orch["integrate"]["conclusion"] == "skipped"
2026-11-14T00:04:27.6880978Z 
