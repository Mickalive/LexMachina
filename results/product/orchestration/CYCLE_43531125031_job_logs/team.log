2026-11-14T00:04:44.5311497Z def test_cancelled_team_is_its_own_class_and_not_a_failure():
2026-11-14T00:04:44.5311937Z     out = oe.classify(
2026-11-14T00:04:44.5312187Z         observation={"conclusion": "cancelled"},
2026-11-14T00:04:44.5312704Z         jobs={"team": "cancelled", "audit": "cancelled", "integrate": "cancelled"},
2026-11-14T00:04:44.5313060Z         steps=[],
2026-11-14T00:04:44.5313353Z         team_branch_exists=True,
2026-11-14T00:04:44.5313591Z     )
2026-11-14T00:04:44.5313805Z     assert out["class"] == "TEAM_JOB_CANCELLED"
2026-11-14T00:04:44.5314434Z     # The lane lever differs from a failure: the product survived on the branch.
2026-11-14T00:04:44.5314950Z     assert out["producing_snapshot_survived"] is True
2026-11-14T00:04:44.5315381Z     assert out["verdict_exists"] is False
