2026-11-14T00:04:57.1628159Z def test_log_parser_separates_workflow_annotations_from_quoted_history():
2026-11-14T00:04:57.1628700Z     """The parser's core invariant, proven on synthetic text.
2026-11-14T00:04:57.1629077Z 
2026-11-14T00:04:57.1629236Z     An agent that writes its own diagnosis QUOTES old annotations
2026-11-14T00:04:57.1629640Z     (``"annotation": "LEX_WORK_QUANTUM_EXPIRED seconds=2700"``).  Honouring
2026-11-14T00:04:57.1630066Z     that quote would label a model-gateway rejection as a work-quantum
2026-11-14T00:04:57.1630554Z     expiry - exactly the misclassification that stalled this snapshot's
2026-11-14T00:04:57.1632502Z ##[error]``-prefixed annotation
2026-11-14T00:04:57.1633825Z     lines are the run's own verdicts.
2026-11-14T00:04:57.1634092Z     """
2026-11-14T00:04:57.1634349Z     from product import lane_cycle_log_evidence as lcle
2026-11-14T00:04:57.1634866Z 
2026-11-14T00:04:57.1634960Z     quoted_only = (
2026-11-14T00:04:57.1635245Z         '2026-10-26T03:14:49.1742084Z    "quantum_seconds": 2700,\n'
2026-11-14T00:04:57.1635607Z         '2026-10-26T03:14:49.1742314Z    "exit_code": 78,\n'
2026-11-14T00:04:57.1635936Z         '2026-10-26T03:14:49.1742592Z    "annotation": '
2026-11-14T00:04:57.1636270Z         '"LEX_WORK_QUANTUM_EXPIRED seconds=2700 pid=2468",\n'
2026-11-14T00:04:57.1636724Z         "2026-10-26T03:20:49.1000000Z LEX_MODEL_POOL size=4 "
2026-11-14T00:04:57.1637294Z         "slot=core:product:v68:40263483436 requested=opencode/x-preview-f-free "
2026-11-14T00:04:57.1637837Z         "selected=opencode/beam-free index=3\n"
2026-11-14T00:04:57.1638314Z         "2026-10-26T03:20:49.1800000Z Upstream request failed: "
2026-11-14T00:04:57.1638919Z         "[unsupported_parameter] Unrecognized request argument supplied: "
2026-11-14T00:04:57.1639501Z         "permissions.\n"
2026-11-14T00:04:57.1640118Z         "2026-10-26T03:20:49.2000000Z OpenCode failed without transient/auth "
2026-11-14T00:04:57.1640731Z         "signature (rc=1)\n"
2026-11-14T00:04:57.1641367Z         "2026-10-26T03:20:49.3000000Z LEX_AGENT_CARD_OK product\n"
2026-11-14T00:04:57.1642609Z ##[error]Process completed with exit "
2026-11-14T00:04:57.1643882Z         "code 1.\n"
2026-11-14T00:04:57.1644209Z     )
2026-11-14T00:04:57.1644552Z     rec = lcle.parse_lane_cycle_log(quoted_only)
2026-11-14T00:04:57.1645170Z     assert rec["classification"] == "MODEL_UPSTREAM_REJECTED_REQUEST_PARAMETER"
2026-11-14T00:04:57.1645823Z     assert rec["markers"]["quantum_expired"] is False
2026-11-14T00:04:57.1646366Z     assert rec["markers"]["markers_quoted_from_history_only"] == [
2026-11-14T00:04:57.1646826Z         "LEX_WORK_QUANTUM_EXPIRED"]
2026-11-14T00:04:57.1647495Z     assert rec["upstream_error"]["signature"] == UPSTREAM_SIGNATURE
2026-11-14T00:04:57.1647853Z 
2026-11-14T00:04:57.1647963Z     annotated = (
2026-11-14T00:04:57.1648307Z         "2026-10-26T03:16:52Z LEX_AGENT_CARD_OK product\n"
2026-11-14T00:04:57.1649382Z ##[error]LEX_WORK_QUANTUM_EXPIRED "
2026-11-14T00:04:57.1650422Z         "seconds=2700 pid=2468\n"
2026-11-14T00:04:57.1651684Z ##[error]Process completed with exit code 78.\n"
2026-11-14T00:04:57.1652853Z     )
2026-11-14T00:04:57.1653164Z     rec2 = lcle.parse_lane_cycle_log(annotated)
2026-11-14T00:04:57.1653623Z     assert rec2["markers"]["quantum_expired"] is True
2026-11-14T00:04:57.1654088Z     assert rec2["classification"] == "WORK_QUANTUM_EXPIRED"
2026-11-14T00:04:57.1654524Z     assert rec2["exit_codes"] == [78]
2026-11-14T00:04:57.1654699Z 
