2026-11-14T00:04:40.6962629Z def _fresh_runner_probe() -> dict[str, Any]:
2026-11-14T00:04:40.6962986Z     """Probe the query runtime with ``-S`` to reproduce a fresh runner.
2026-11-14T00:04:40.6963237Z 
2026-11-14T00:04:40.6963423Z     The core-lane team job installs nothing, so a fresh runner has neither
2026-11-14T00:04:40.6963864Z     numpy nor scikit-learn.  ``python -S`` skips the user site where the
2026-11-14T00:04:40.6964313Z     bootstrap installs them, which makes that validation gap reproducible
2026-11-14T00:04:40.6964692Z     without touching the current environment.
2026-11-14T00:04:40.6964954Z     """
2026-11-14T00:04:40.6965133Z     code = (
2026-11-14T00:04:40.6965336Z         "import json,sys;"
2026-11-14T00:04:40.6965581Z         "sys.path.insert(0, '.');"
2026-11-14T00:04:40.6965842Z         "from product import query_env;"
2026-11-14T00:04:40.6966122Z         "print(json.dumps(query_env.probe()))"
2026-11-14T00:04:40.6966385Z     )
2026-11-14T00:04:40.6966564Z     try:
2026-11-14T00:04:40.6966764Z         proc = subprocess.run(
2026-11-14T00:04:40.6967072Z             [sys.executable, "-S", "-c", code], cwd=str(REPO_ROOT),
2026-11-14T00:04:40.6967449Z             capture_output=True, text=True, timeout=60, check=False,
2026-11-14T00:04:40.6967808Z         )
2026-11-14T00:04:40.6968295Z     except (OSError, subprocess.SubprocessError) as exc:  # pragma: no cover
2026-11-14T00:04:40.6968722Z         return {"ok": None, "error": f"{type(exc).__name__}: {exc}"}
2026-11-14T00:04:40.6969054Z     probe: dict[str, Any] = {}
2026-11-14T00:04:40.6969299Z     if proc.stdout.strip():
2026-11-14T00:04:40.6969521Z         try:
2026-11-14T00:04:40.6969733Z             probe = json.loads(proc.stdout)
2026-11-14T00:04:40.6970012Z         except json.JSONDecodeError:
2026-11-14T00:04:40.6970258Z             probe = {}
2026-11-14T00:04:40.6970461Z     return {
2026-11-14T00:04:40.6970656Z         "ok": probe.get("ok"),
2026-11-14T00:04:40.6970998Z         "missing": probe.get("missing"),
2026-11-14T00:04:40.6971265Z         "exit_code": proc.returncode,
2026-11-14T00:04:40.6971589Z         "stderr_tail": (proc.stderr or "").strip().splitlines()[-3:],
2026-11-14T00:04:40.6971905Z         "meaning": (
2026-11-14T00:04:40.6972201Z             "python -S skips the user site used by bootstrap_query_env.sh; "
2026-11-14T00:04:40.6972620Z             "missing modules here are the fresh-runner validation gap, not a "
2026-11-14T00:04:40.6972965Z             "product defect"
2026-11-14T00:04:40.6973268Z         ),
2026-11-14T00:04:40.6973450Z     }
2026-11-14T00:04:40.6973556Z 
2026-11-14T00:04:40.6973561Z 
2026-11-14T00:04:40.6973771Z def _validation_findings(run_id: str, predecessor_run_id: str) -> dict[str, Any]:
2026-11-14T00:04:40.6974248Z     """Reproduce the validation gaps that can stop a snapshot before its gate.
2026-11-14T00:04:40.6974518Z 
2026-11-14T00:04:40.6974705Z     This is deliberately narrow and offline.  It does not infer a provider
2026-11-14T00:04:40.6975130Z     mechanism; it records three checkable things a resume must repair:
2026-11-14T00:04:40.6975370Z 
2026-11-14T00:04:40.6975566Z     * a ``product/tests/test_cycle_*.py`` path the snapshot's own report claims
2026-11-14T00:04:40.6975932Z       but the snapshot did not commit;
2026-11-14T00:04:40.6976293Z     * an audit-readiness dossier produced with its mandatory re-runs skipped;
2026-11-14T00:04:40.6976720Z     * the pinned query runtime's presence on the machine that consumes the
2026-11-14T00:04:40.6977136Z       snapshot (the core-lane team job installs nothing, so a fresh runner
2026-11-14T00:04:40.6977663Z       fails with ModuleNotFoundError before any product claim can be tested).
2026-11-14T00:04:40.6978013Z     """
2026-11-14T00:04:40.6978195Z     candidates = [
2026-11-14T00:04:40.6978470Z         REPO_ROOT / "reports" / "product" / f"CYCLE_{run_id}.md",
2026-11-14T00:04:40.6978868Z         REPO_ROOT / "reports" / "product" / f"CYCLE_{predecessor_run_id}.md",
2026-11-14T00:04:40.6979195Z     ]
2026-11-14T00:04:40.6979412Z     claimed_tests: list[dict[str, Any]] = []
2026-11-14T00:04:40.6979683Z     seen: set[str] = set()
2026-11-14T00:04:40.6979922Z     for report in candidates:
2026-11-14T00:04:40.6980169Z         if not report.is_file():
2026-11-14T00:04:40.6980409Z             continue
2026-11-14T00:04:40.6980654Z         for rel in sorted(set(CYCLE_TEST_RE.findall(
2026-11-14T00:04:40.6981243Z                 report.read_text(encoding="utf-8", errors="replace")))):
2026-11-14T00:04:40.6981559Z             if rel in seen:
2026-11-14T00:04:40.6981783Z                 continue
2026-11-14T00:04:40.6981994Z             seen.add(rel)
2026-11-14T00:04:40.6982220Z             claimed_tests.append({
2026-11-14T00:04:40.6982461Z                 "path": rel,
2026-11-14T00:04:40.6982719Z                 "claimed_by_report": _repo_relative(report),
2026-11-14T00:04:40.6983026Z                 "present": (REPO_ROOT / rel).is_file(),
2026-11-14T00:04:40.6983279Z             })
2026-11-14T00:04:40.6983396Z 
2026-11-14T00:04:40.6983483Z     dossiers = [
2026-11-14T00:04:40.6983727Z         REPO_ROOT / "results" / "product" / "audit_readiness"
2026-11-14T00:04:40.6984034Z         / f"CYCLE_{rid}_audit_readiness.json"
2026-11-14T00:04:40.6984324Z         for rid in (run_id, predecessor_run_id) if rid
2026-11-14T00:04:40.6984583Z     ]
2026-11-14T00:04:40.6984848Z     dossier_summary = []
2026-11-14T00:04:40.6985072Z     for dossier in dossiers:
2026-11-14T00:04:40.6985301Z         if not dossier.is_file():
2026-11-14T00:04:40.6985531Z             continue
2026-11-14T00:04:40.6985721Z         try:
2026-11-14T00:04:40.6985970Z             data = json.loads(dossier.read_text(encoding="utf-8"))
2026-11-14T00:04:40.6986297Z         except json.JSONDecodeError:
2026-11-14T00:04:40.6986539Z             continue
2026-11-14T00:04:40.6986752Z         dossier_summary.append({
2026-11-14T00:04:40.6987028Z             "path": _repo_relative(dossier),
2026-11-14T00:04:40.6987313Z             "overall_status": data.get("overall_status"),
2026-11-14T00:04:40.6987630Z             "skipped_checks": data.get("skipped_checks") or [],
2026-11-14T00:04:40.6987966Z             "failed_checks": data.get("failed_checks") or [],
2026-11-14T00:04:40.6988230Z         })
2026-11-14T00:04:40.6988332Z 
2026-11-14T00:04:40.6988433Z     fresh = _fresh_runner_probe()
2026-11-14T00:04:40.6988589Z 
2026-11-14T00:04:40.6988680Z     historical = sorted(
2026-11-14T00:04:40.6988903Z         _repo_relative(path)
2026-11-14T00:04:40.6989215Z         for path in (REPO_ROOT / "results" / "product" / "reality_check").glob(
2026-11-14T00:04:40.6989557Z             "*missing-deps*.json")
2026-11-14T00:04:40.6989776Z     )
2026-11-14T00:04:40.6989964Z     probe = query_env.probe()
2026-11-14T00:04:40.6990180Z     return {
2026-11-14T00:04:40.6990389Z         "claimed_cycle_tests": claimed_tests,
2026-11-14T00:04:40.6990650Z         "missing_claimed_cycle_tests": [
2026-11-14T00:04:40.6991147Z             row["path"] for row in claimed_tests if not row["present"]
2026-11-14T00:04:40.6991446Z         ],
2026-11-14T00:04:40.6991659Z         "audit_readiness_dossiers": dossier_summary,
2026-11-14T00:04:40.6991954Z         "dossiers_with_skipped_mandatory_reruns": [
2026-11-14T00:04:40.6992300Z             row["path"] for row in dossier_summary if row["skipped_checks"]
2026-11-14T00:04:40.6992610Z         ],
2026-11-14T00:04:40.6992801Z         "runtime_preflight": {
2026-11-14T00:04:40.6993036Z             "ok": probe["ok"],
2026-11-14T00:04:40.6993275Z             "missing": probe["missing"],
2026-11-14T00:04:40.6993621Z             "installed": probe["installed"],
2026-11-14T00:04:40.6993893Z             "pinned": probe["pinned"],
2026-11-14T00:04:40.6994152Z             "remedy": probe["remedy"],
2026-11-14T00:04:40.6994424Z             "workflow_gap": probe["workflow_gap"],
2026-11-14T00:04:40.6994716Z             "fresh_runner_no_site_probe": fresh,
2026-11-14T00:04:40.6994971Z         },
2026-11-14T00:04:40.6995229Z         "historical_missing_dependency_artifacts": historical[:5],
2026-11-14T00:04:40.6995546Z         "meaning": (
2026-11-14T00:04:40.6995833Z             "These are reproducible validation gaps, not a provider/auth "
2026-11-14T00:04:40.6996252Z             "mechanism and not a product verdict. Missing deps and a missing "
2026-11-14T00:04:40.6996670Z             "claimed test make a green snapshot fail its own self-check on a "
2026-11-14T00:04:40.6997077Z             "fresh runner; they are repaired by the resuming cycle, never by "
2026-11-14T00:04:40.6997416Z             "weakening a frozen bar."
2026-11-14T00:04:40.6997652Z         ),
2026-11-14T00:04:40.6997828Z     }
2026-11-14T00:04:40.6997931Z 
2026-11-14T00:04:40.6997934Z 
2026-11-14T00:04:40.6998112Z def _orchestration_without_raw(raw_path: Path | None) -> dict[str, Any]:
2026-11-14T00:04:40.6998540Z     """Honest placeholder when no public run/jobs snapshot was captured.
2026-11-14T00:04:40.6998791Z 
2026-11-14T00:04:40.6998976Z     The missing artefact is recorded as such.  A git-ref delta and the absence
2026-11-14T00:04:40.6999414Z     of an audit half still prove a great deal, but they cannot name a provider,
2026-11-14T00:04:40.6999790Z     auth or quantum mechanism, so none is invented.
2026-11-14T00:04:40.7000061Z     """
2026-11-14T00:04:40.7000242Z     return {
2026-11-14T00:04:40.7000512Z         "schema": asd.SCHEMA,
2026-11-14T00:04:40.7000782Z         "classification": "RAW_SNAPSHOT_UNAVAILABLE",
2026-11-14T00:04:40.7001227Z         "mechanism_unobserved": True,
2026-11-14T00:04:40.7001550Z         "raw_snapshot": _repo_relative(raw_path) if raw_path else None,
2026-11-14T00:04:40.7001868Z         "meaning": (
2026-11-14T00:04:40.7002166Z             "No committed run/jobs snapshot exists for this failed run in the "
2026-11-14T00:04:40.7002579Z             "producer checkout (job logs require admin rights). The durable "
2026-11-14T00:04:40.7002977Z             "delta and the absent audit half are still proven from git refs; "
2026-11-14T00:04:40.7003353Z             "the provider/auth/timeout mechanism is NOT claimed."
2026-11-14T00:04:40.7003638Z         ),
2026-11-14T00:04:40.7003810Z     }
2026-11-14T00:04:40.7003909Z 
2026-11-14T00:04:40.7003913Z 
2026-11-14T00:04:40.7003986Z def run(
2026-11-14T00:04:40.7004161Z     run_id: str,
2026-11-14T00:04:40.7004365Z     predecessor_run_id: str = "",
2026-11-14T00:04:40.7004619Z     raw_path: Path | None = None,
2026-11-14T00:04:40.7004840Z     *,
2026-11-14T00:04:40.7005031Z     predecessor_ref: str | None = None,
2026-11-14T00:04:40.7005275Z ) -> dict[str, Any]:
2026-11-14T00:04:40.7005483Z     orchestration = (
2026-11-14T00:04:40.7005785Z         asd.classify(json.loads(Path(raw_path).read_text(encoding="utf-8")))
2026-11-14T00:04:40.7006121Z         if raw_path is not None
2026-11-14T00:04:40.7006369Z         else _orchestration_without_raw(None)
2026-11-14T00:04:40.7006613Z     )
2026-11-14T00:04:40.7006797Z     if predecessor_ref:
2026-11-14T00:04:40.7007126Z         delta = _delta(f"origin/cycle/core/product/{run_id}/team", predecessor_ref)
2026-11-14T00:04:40.7007495Z     elif predecessor_run_id:
2026-11-14T00:04:40.7007723Z         delta = _delta(
2026-11-14T00:04:40.7007962Z             f"origin/cycle/core/product/{run_id}/team",
2026-11-14T00:04:40.7008293Z             f"origin/cycle/core/product/{predecessor_run_id}/team",
2026-11-14T00:04:40.7008596Z         )
2026-11-14T00:04:40.7008766Z     else:
2026-11-14T00:04:40.7009038Z         delta = _delta(f"origin/cycle/core/product/{run_id}/team", ACCEPTED_REF)
2026-11-14T00:04:40.7009377Z     accept = _accept_commit(run_id)
2026-11-14T00:04:40.7009710Z     audit = _audit_half(run_id)
2026-11-14T00:04:40.7009997Z     accepted = bool(accept.get("accept_commit")) and bool(
2026-11-14T00:04:40.7010319Z         audit.get("gate_verdict") == "PASS"
2026-11-14T00:04:40.7010608Z         and audit.get("safe_to_integrate") is True
2026-11-14T00:04:40.7010963Z     )
2026-11-14T00:04:40.7011165Z     record: dict[str, Any] = {
2026-11-14T00:04:40.7011399Z         "schema": SCHEMA,
2026-11-14T00:04:40.7011731Z         "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
2026-11-14T00:04:40.7012089Z         "run_id": run_id,
2026-11-14T00:04:40.7012334Z         "predecessor_run_id": predecessor_run_id,
2026-11-14T00:04:40.7012696Z         "raw_snapshot": _repo_relative(Path(raw_path)) if raw_path else None,
2026-11-14T00:04:40.7013062Z         "orchestration": orchestration,
2026-11-14T00:04:40.7013329Z         "durable_delta": delta,
2026-11-14T00:04:40.7013565Z         "adjudication": {
2026-11-14T00:04:40.7013786Z             "audit": audit,
2026-11-14T00:04:40.7014009Z             "accept": accept,
2026-11-14T00:04:40.7014244Z             "accepted": accepted,
2026-11-14T00:04:40.7014535Z             "status": "ACCEPTED" if accepted else "UNADJUDICATED",
2026-11-14T00:04:40.7014853Z             "product_defect": False,
2026-11-14T00:04:40.7015103Z             "verdict_written": False,
2026-11-14T00:04:40.7015350Z             "why_not_accepted": (
2026-11-14T00:04:40.7015595Z                 None if accepted else
2026-11-14T00:04:40.7015927Z                 "requirement 4 needs BOTH an independent PASS gate on the "
2026-11-14T00:04:40.7016329Z                 "audit ref AND an accept commit on lab/product; at least one "
2026-11-14T00:04:40.7016662Z                 "half is absent for this run"
2026-11-14T00:04:40.7016985Z             ),
2026-11-14T00:04:40.7017174Z         },
2026-11-14T00:04:40.7017383Z         "audit_namespace": _audit_namespace(),
2026-11-14T00:04:40.7017748Z         "validation_findings": _validation_findings(run_id, predecessor_run_id),
2026-11-14T00:04:40.7018110Z         "claim_ceiling": (
2026-11-14T00:04:40.7018485Z             "This artifact classifies an orchestration outcome and a git-ref "
2026-11-14T00:04:40.7018912Z             "delta. It writes no gate, labels no run accepted or rejected, "
2026-11-14T00:04:40.7019335Z             "asserts no cause the committed run/jobs snapshot cannot show, and "
2026-11-14T00:04:40.7019713Z             "makes no product, legal or serve claim."
2026-11-14T00:04:40.7019984Z         ),
2026-11-14T00:04:40.7020165Z     }
2026-11-14T00:04:40.7020354Z     if raw_path is None:
2026-11-14T00:04:40.7020797Z         # Only the raw-free mode needs to name the delta baseline; preserving
2026-11-14T00:04:40.7021427Z         # the historical raw-mode record byte shape keeps accepted cycle tests
2026-11-14T00:04:40.7021782Z         # reproducible.
2026-11-14T00:04:40.7022078Z         record["predecessor_ref"] = predecessor_ref or ACCEPTED_REF
2026-11-14T00:04:40.7022412Z     return record
2026-11-14T00:04:40.7022533Z 
2026-11-14T00:04:40.7022537Z 
2026-11-14T00:04:40.7022668Z def main(argv: list[str] | None = None) -> int:
2026-11-14T00:04:40.7022998Z     ap = argparse.ArgumentParser(description=__doc__)
2026-11-14T00:04:40.7023317Z     ap.add_argument("--run-id", required=True)
2026-11-14T00:04:40.7023635Z     ap.add_argument("--predecessor-run-id", default="",
2026-11-14T00:04:40.7024061Z                     help="previous cycle's team ref (optional when --predecessor-ref is given)")
2026-11-14T00:04:40.7024482Z     ap.add_argument("--predecessor-ref", default="",
2026-11-14T00:04:40.7024918Z                     help="explicit git ref for the durable-delta baseline (default origin/lab/product)")
2026-11-14T00:04:40.7025350Z     ap.add_argument("--raw", default=None,
2026-11-14T00:04:40.7025723Z                     help="committed run/jobs snapshot for --run-id; omit when unavailable")
2026-11-14T00:04:40.7026109Z     ap.add_argument("--out", required=True)
2026-11-14T00:04:40.7026471Z     args = ap.parse_args(argv)
2026-11-14T00:04:40.7026779Z     if not args.predecessor_run_id and not args.predecessor_ref:
2026-11-14T00:04:40.7027111Z         args.predecessor_ref = ACCEPTED_REF
2026-11-14T00:04:40.7027366Z     rec = run(
2026-11-14T00:04:40.7027562Z         args.run_id,
2026-11-14T00:04:40.7027783Z         args.predecessor_run_id,
2026-11-14T00:04:40.7028140Z [0m
2026-11-14T00:04:44.0308078Z [0m$ [0mcd /home/runner/work/LexMachina/LexMachina && sed -n '1,140p' product/lane_cycle_log_evidence.py; echo "..."; grep -n "def \|LEX_\|classification\|cause" product/lane_cycle_log_evidence.py | head -80
2026-11-14T00:04:44.0308904Z #!/usr/bin/env python3
2026-11-14T00:04:44.0309263Z """Parse committed core-lane job logs into machine-checkable failure evidence.
2026-11-14T00:04:44.0309595Z 
2026-11-14T00:04:44.0309766Z Why this module exists (operational resume of run 40263483436)
2026-11-14T00:04:44.0310141Z ---------------------------------------------------------------
2026-11-14T00:04:44.0310633Z Every earlier resume in this chain had to publish
2026-11-14T00:04:44.0311456Z ``mechanism.status = "UNOBSERVED"`` because the GitHub job-log endpoint answers
2026-11-14T00:04:44.0311925Z **403** to unauthenticated callers (``logs_endpoint_status: 403`` in the
2026-11-14T00:04:44.0312394Z committed run/jobs snapshots, asserted by ``test_cycle_40193974025``).  Inside
2026-11-14T00:04:44.0312875Z an Actions run the runner's own persisted git-credentials token **can** read
2026-11-14T00:04:44.0313332Z those logs (HTTP 200), so during run 40263666190 the three failed predecessor
2026-11-14T00:04:44.0313747Z runs' ``Run lane cycle`` logs were fetched and committed under
2026-11-14T00:04:44.0314148Z ``results/product/orchestration/CYCLE_40263666190_lane_cycle_logs/``.
2026-11-14T00:04:44.0314619Z 
2026-11-14T00:04:44.0314814Z That turns the chain's cause from prose into evidence.  Two *distinct* death
2026-11-14T00:04:44.0315258Z classes are visible in those bytes, and conflating them would mis-aim the
2026-11-14T00:04:44.0315605Z repair:
2026-11-14T00:04:44.0315718Z 
2026-11-14T00:04:44.0315916Z * ``MODEL_UPSTREAM_REJECTED_REQUEST_PARAMETER`` - the model pool selected a
2026-11-14T00:04:44.0316349Z   free model whose upstream rejects a request argument OpenCode sends
2026-11-14T00:04:44.0316787Z   (``[unsupported_parameter] ... permissions``).  The wrapper classifies it as
2026-11-14T00:04:44.0317255Z   non-transient and exits without retrying, so the agent never starts.  Control
2026-11-14T00:04:44.0317760Z   plane: model-health probe does not reproduce the real agent request shape.
2026-11-14T00:04:44.0318213Z * ``AGENT_FINISHED_ZERO_DURABLE_DELTA`` - the agent ran, hit the fresh-runner
2026-11-14T00:04:44.0318660Z   validation cascade (missing numpy/sklearn, absent legacy map data), and
2026-11-14T00:04:44.0319085Z   exited 0 with a clean tree, so the wrapper's delta guard fired
2026-11-14T00:04:44.0319490Z   (``LEX_ZERO_DELTA_REPAIR``, exit 67).  Product: the lane's own instruments
2026-11-14T00:04:44.0319851Z   self-heal on a fresh runner.
2026-11-14T00:04:44.0319998Z 
2026-11-14T00:04:44.0320088Z Design notes
2026-11-14T00:04:44.0320279Z ------------
2026-11-14T00:04:44.0320568Z * ``parse_lane_cycle_log`` is a **pure function** of log text: no network, no
2026-11-14T00:04:44.0321214Z   git, no state.  The committed logs are the input, so the evidence JSON and
2026-11-14T00:04:44.0321627Z   the cycle test re-derive the same numbers from the same bytes.
2026-11-14T00:04:44.0322040Z * Nothing here writes a gate, labels a run, or edits ``.github/**`` (control
2026-11-14T00:04:44.0322480Z   plane, never edited from this lane).  It names control-plane items for the
2026-11-14T00:04:44.0322822Z   director instead.
2026-11-14T00:04:44.0323129Z * Logs are fetched once by hand inside a run that has the token; this module
2026-11-14T00:04:44.0323560Z   only **reads** the committed copies.  The fetch is recorded in the artifact
2026-11-14T00:04:44.0323979Z   (``fetched_via`` / ``logs_endpoint_status``) so a reader can tell observed
2026-11-14T00:04:44.0324439Z   evidence from an unobserved mechanism.
2026-11-14T00:04:44.0324615Z 
2026-11-14T00:04:44.0324689Z Usage
2026-11-14T00:04:44.0324865Z -----
2026-11-14T00:04:44.0325090Z     python3 product/lane_cycle_log_evidence.py \
2026-11-14T00:04:44.0325501Z         --logs-dir results/product/orchestration/CYCLE_40263666190_lane_cycle_logs \
2026-11-14T00:04:44.0325907Z         --run-ids 40262401687 40263308953 40263483436 \
2026-11-14T00:04:44.0326317Z         --out results/product/orchestration/CYCLE_40263666190_lane_cycle_log_evidence.json
2026-11-14T00:04:44.0326696Z """
2026-11-14T00:04:44.0326896Z from __future__ import annotations
2026-11-14T00:04:44.0327062Z 
2026-11-14T00:04:44.0327144Z import argparse
2026-11-14T00:04:44.0327343Z import hashlib
2026-11-14T00:04:44.0327539Z import json
2026-11-14T00:04:44.0327726Z import re
2026-11-14T00:04:44.0327935Z from datetime import datetime, timezone
2026-11-14T00:04:44.0328212Z from pathlib import Path
2026-11-14T00:04:44.0328445Z from typing import Any
2026-11-14T00:04:44.0328574Z 
2026-11-14T00:04:44.0328700Z SCHEMA = "product-lane-cycle-log-evidence/1"
2026-11-14T00:04:44.0329040Z DEFAULT_LOGS_DIR = Path("results/product/orchestration") / (
2026-11-14T00:04:44.0329359Z     "CYCLE_40263666190_lane_cycle_logs"
2026-11-14T00:04:44.0329595Z )
2026-11-14T00:04:44.0329694Z 
2026-11-14T00:04:44.0329794Z #: One pool line per attempt, e.g.
2026-11-14T00:04:44.0330123Z #: ``LEX_MODEL_POOL size=4 slot=core:product:v68:40263483436 requested=...
2026-11-14T00:04:44.0330477Z #:  selected=opencode/beam-free index=3``.
2026-11-14T00:04:44.0330748Z POOL_RE = re.compile(
2026-11-14T00:04:44.0331303Z     r"LEX_MODEL_POOL size=(?P<size>\d+) slot=(?P<slot>\S+) "
2026-11-14T00:04:44.0331821Z     r"requested=(?P<requested>\S+) selected=(?P<selected>\S+) index=(?P<index>\d+)"
2026-11-14T00:04:44.0332186Z )
2026-11-14T00:04:44.0332463Z EXIT_RE = re.compile(r"Process completed with exit code\s+(-?\d+)")
2026-11-14T00:04:44.0332817Z UPSTREAM_RE = re.compile(
2026-11-14T00:04:44.0333148Z     r"Upstream request failed: \[(?P<signature>[^\]]+)\]\s*(?P<detail>.*)"
2026-11-14T00:04:44.0333482Z )
2026-11-14T00:04:44.0333737Z MISSING_MODULE_RE = re.compile(r"No module named '([^']+)'")
2026-11-14T00:04:44.0334162Z #: Canonical Python/interpreter error form only.  The bare regex above also
2026-11-14T00:04:44.0334617Z #: matches the agent's own source (``MISSING_MODULE_RE = re.compile(r"No
2026-11-14T00:04:44.0335024Z #: module named '([^']+)'")``) and its comment prose while it writes the
2026-11-14T00:04:44.0335432Z #: diagnosis, which is how ``([^`` once reached a published artifact.
2026-11-14T00:04:44.0335772Z MODULE_ERR_RE = re.compile(
2026-11-14T00:04:44.0336086Z     r"(?:ModuleNotFoundError|ImportError): No module named '([^']+)'"
2026-11-14T00:04:44.0336403Z )
2026-11-14T00:04:44.0336685Z #: The wrapper prints this with a resolved code (``rc=1``); the wrapper's own
2026-11-14T00:04:44.0337125Z #: script source echoes ``rc=$rc``, and a diagnosis agent quotes that source.
2026-11-14T00:04:44.0337487Z NON_TRANSIENT_RE = re.compile(
2026-11-14T00:04:44.0337811Z     r"failed without transient(?:/auth)? signature \(rc=(-?\d+)\)"
2026-11-14T00:04:44.0338127Z )
2026-11-14T00:04:44.0338380Z #: The genuine signal is a pytest ``AssertionError: Map data missing
2026-11-14T00:04:44.0338795Z #: positions: ...``; the agent's dict-literal source line has a closing quote
2026-11-14T00:04:44.0339148Z #: between the string and ``in text``.
2026-11-14T00:04:44.0339451Z MAP_POS_RE = re.compile(r"Map data missing positions:")
2026-11-14T00:04:44.0339788Z ATTEMPT_RE = re.compile(r"LEX_OX_ATTEMPT=(\d+)/(\d+)")
2026-11-14T00:04:44.0343582Z ##[error]TEXT`` inside
2026-11-14T00:04:44.0344690Z #: the downloaded log.  Only those lines are the *run's own* verdicts: an agent
2026-11-14T00:04:44.0345094Z #: legitimately quotes older annotations (``"annotation":
2026-11-14T00:04:44.0345489Z #: "LEX_WORK_QUANTUM_EXPIRED seconds=2700 ..."``) while writing its diagnosis,
2026-11-14T00:04:44.0346055Z #: and honouring that quote would mislabel this run's cause.  The annotation
2026-11-14T00:04:44.0346461Z #: prefix is therefore what separates observation from quotation.
2026-11-14T00:04:44.0346801Z ANNOTATION_LINE_RE = re.compile(
2026-11-14T00:04:44.0347080Z     r"##\[(?P<level>error|warning|notice)\](?P<text>.*)"
2026-11-14T00:04:44.0347350Z )
2026-11-14T00:04:44.0347621Z # ``selected=`` is also echoed by resolve_model_args in some wrapper versions;
2026-11-14T00:04:44.0347990Z # the pool line above is the authoritative one.
2026-11-14T00:04:44.0348180Z 
2026-11-14T00:04:44.0348311Z CLASS_ZERO_DELTA = "AGENT_FINISHED_ZERO_DURABLE_DELTA"
