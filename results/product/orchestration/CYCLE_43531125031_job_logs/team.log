2026-11-14T00:04:27.6881409Z     assert mech["status"] == "OBSERVED_QUANTUM_EXPIRED"
2026-11-14T00:04:27.6881712Z     assert mech["quantum_expired"] is True
2026-11-14T00:04:27.6881986Z     assert mech["quantum_seconds"] == 2700
2026-11-14T00:04:27.6882251Z     assert mech["exit_code"] == 78
