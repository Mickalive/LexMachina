2026-11-14T00:03:25.9334538Z #!/usr/bin/env python3
2026-11-14T00:03:25.9334915Z """One-command offline clickable slice: frozen question -> bundle -> verified map.
2026-11-14T00:03:25.9335227Z 
2026-11-14T00:03:25.9335418Z     python product/offline_slice.py                      # rent-default fixture
2026-11-14T00:03:25.9335879Z     python product/offline_slice.py --slug business-judgment-rule --verify
2026-11-14T00:03:25.9336358Z     python product/offline_slice.py --no-enrich          # map-only, skip answer
2026-11-14T00:03:25.9336631Z 
2026-11-14T00:03:25.9336799Z What it proves in a single command (no network, no owner time):
2026-11-14T00:03:25.9337035Z 
2026-11-14T00:03:25.9337218Z * ``query -> query_result_bundle`` from the recorded OpenCaseLaw envelopes
2026-11-14T00:03:25.9337652Z   (``retrieval_mode="fixture"``, ``socket.connect`` booby-trapped so any
2026-11-14T00:03:25.9338004Z   network attempt fails loudly);
2026-11-14T00:03:25.9338341Z * the sourced answer + counter-authority pass of the SAME loop, from the
2026-11-14T00:03:25.9338781Z   generative-audit fixture provider (``fixture_generation=True``), so the
2026-11-14T00:03:25.9339246Z   offline slice covers question -> answer -> counter -> map, not just the map;
2026-11-14T00:03:25.9339720Z * enrichment never moves a rendered point (the geometry of the first map is
2026-11-14T00:03:25.9340102Z   compared row by row against the final bundle);
2026-11-14T00:03:25.9340471Z * the bundle is a *clickable* map input: every row carries ``x`` / ``y`` /
2026-11-14T00:03:25.9341277Z   ``cluster_id`` and a ``canonical_url`` source link, and every decision the
2026-11-14T00:03:25.9341672Z   answer cites is reachable from the answer panel;
2026-11-14T00:03:25.9342065Z * ``product/verify_query_page.js`` (the product's own DOM contract) renders it,
2026-11-14T00:03:25.9342496Z   so "source-linked clickable map" is checked, not asserted.
2026-11-14T00:03:25.9342729Z 
2026-11-14T00:03:25.9342913Z It is a developer/CI entry point for the FAST-MVP vertical slice. It never
2026-11-14T00:03:25.9343366Z touches the network, never claims legal usefulness, and never evaluates a
2026-11-14T00:03:25.9343892Z frozen live gate (fixture runs are wiring evidence only).
2026-11-14T00:03:25.9344186Z """
2026-11-14T00:03:25.9344390Z from __future__ import annotations
2026-11-14T00:03:25.9344554Z 
2026-11-14T00:03:25.9344645Z import argparse
2026-11-14T00:03:25.9344847Z import json
2026-11-14T00:03:25.9345040Z import socket
2026-11-14T00:03:25.9345244Z import subprocess
2026-11-14T00:03:25.9345446Z import sys
2026-11-14T00:03:25.9345627Z import time
2026-11-14T00:03:25.9345829Z from pathlib import Path
2026-11-14T00:03:25.9345975Z 
2026-11-14T00:03:25.9346094Z PRODUCT_ROOT = Path(__file__).resolve().parent
2026-11-14T00:03:25.9346380Z REPO_ROOT = PRODUCT_ROOT.parent
2026-11-14T00:03:25.9346640Z sys.path.insert(0, str(PRODUCT_ROOT))
2026-11-14T00:03:25.9346917Z sys.path.insert(0, str(REPO_ROOT))
2026-11-14T00:03:25.9347076Z 
2026-11-14T00:03:25.9347263Z # RF1: one shared definition of "counter authority" across the product.
2026-11-14T00:03:25.9347666Z from product.query.counter_status import (  # noqa: E402
2026-11-14T00:03:25.9347974Z     counter_authority_count,
2026-11-14T00:03:25.9348221Z     counter_status_bearing_count,
2026-11-14T00:03:25.9348453Z )
2026-11-14T00:03:25.9348721Z from product.query.bundle import content_coverage  # noqa: E402
2026-11-14T00:03:25.9348957Z 
2026-11-14T00:03:25.9349058Z DEFAULT_SLUG = "rent-default"
2026-11-14T00:03:25.9349205Z 
2026-11-14T00:03:25.9349208Z 
2026-11-14T00:03:25.9349383Z def _no_network(*_a, **_k):  # pragma: no cover - exercised on every run
2026-11-14T00:03:25.9349791Z     raise AssertionError("offline slice attempted network access")
2026-11-14T00:03:25.9350033Z 
2026-11-14T00:03:25.9350036Z 
2026-11-14T00:03:25.9350138Z def _geometry(bundle: dict) -> dict:
2026-11-14T00:03:25.9350460Z     return {
2026-11-14T00:03:25.9350739Z         d.get("decision_id"): (d.get("x"), d.get("y"), d.get("cluster_id"))
2026-11-14T00:03:25.9351387Z         for d in bundle.get("decisions") or []
2026-11-14T00:03:25.9351661Z     }
2026-11-14T00:03:25.9351763Z 
2026-11-14T00:03:25.9351766Z 
2026-11-14T00:03:25.9351950Z def build_bundle(slug: str, top_n: int, *, enrich: bool = True) -> dict:
2026-11-14T00:03:25.9352350Z     from query import enrich_query_bundle, run_query_initial
2026-11-14T00:03:25.9352668Z     from reality_check import LEGS
2026-11-14T00:03:25.9352832Z 
2026-11-14T00:03:25.9352918Z     if slug not in LEGS:
2026-11-14T00:03:25.9353249Z         raise SystemExit(f"unknown slug {slug!r}; known: {', '.join(sorted(LEGS))}")
2026-11-14T00:03:25.9353639Z     real_connect = socket.socket.connect
2026-11-14T00:03:25.9353912Z     socket.socket.connect = _no_network
2026-11-14T00:03:25.9354167Z     try:
2026-11-14T00:03:25.9354478Z         initial = run_query_initial(LEGS[slug], top_n=top_n, retrieval_mode="fixture")
2026-11-14T00:03:25.9354846Z         if not enrich:
2026-11-14T00:03:25.9355059Z             return initial
2026-11-14T00:03:25.9355380Z         # Full offline loop: sourced answer + counter-authority pass from the
2026-11-14T00:03:25.9355824Z         # fixture provider. Hydration/generation/adversarial retrieval are all
2026-11-14T00:03:25.9356281Z         # fixture-configured, so the network trap above stays armed throughout.
2026-11-14T00:03:25.9356639Z         final = enrich_query_bundle(
2026-11-14T00:03:25.9356962Z             initial, retrieval_mode="fixture", fixture_generation=True)
2026-11-14T00:03:25.9357337Z         before, after = _geometry(initial), _geometry(final)
2026-11-14T00:03:25.9357640Z         preserved = (
2026-11-14T00:03:25.9357867Z             set(before) <= set(after)
2026-11-14T00:03:25.9358186Z             and all(after.get(did) == geo for did, geo in before.items())
2026-11-14T00:03:25.9358543Z         )
2026-11-14T00:03:25.9358801Z         final.setdefault("provenance", {})["offline_slice"] = {
2026-11-14T00:03:25.9359104Z             "enriched": True,
2026-11-14T00:03:25.9359346Z             "geometry_preserved": preserved,
2026-11-14T00:03:25.9359609Z             "n_first_map": len(before),
2026-11-14T00:03:25.9359979Z             "n_final": len(after),
2026-11-14T00:03:25.9360222Z             "network": "none",
2026-11-14T00:03:25.9360443Z         }
2026-11-14T00:03:25.9360624Z         return final
2026-11-14T00:03:25.9360950Z     finally:
2026-11-14T00:03:25.9361189Z         socket.socket.connect = real_connect
2026-11-14T00:03:25.9361360Z 
2026-11-14T00:03:25.9361364Z 
2026-11-14T00:03:25.9361478Z def _repo_relative(path: Path) -> str:
2026-11-14T00:03:25.9361834Z     """Repo-relative when inside the checkout, absolute otherwise (``--out`` may
2026-11-14T00:03:25.9362277Z     legitimately point at a scratch directory outside the repository)."""
2026-11-14T00:03:25.9362607Z     try:
2026-11-14T00:03:25.9362820Z         return str(path.relative_to(REPO_ROOT))
2026-11-14T00:03:25.9363103Z     except ValueError:
2026-11-14T00:03:25.9363319Z         return str(path)
2026-11-14T00:03:25.9363446Z 
2026-11-14T00:03:25.9363450Z 
2026-11-14T00:03:25.9363554Z def summarise(bundle: dict) -> dict:
2026-11-14T00:03:25.9363810Z     rows = bundle.get("decisions") or []
2026-11-14T00:03:25.9364053Z     clusters: dict = {}
2026-11-14T00:03:25.9364260Z     for r in rows:
2026-11-14T00:03:25.9364464Z         cid = r.get("cluster_id")
2026-11-14T00:03:25.9364692Z         if cid is None:
2026-11-14T00:03:25.9364967Z             continue  # a None-keyed bucket is not a cluster (audit D3)
2026-11-14T00:03:25.9365300Z         clusters[cid] = clusters.get(cid, 0) + 1
2026-11-14T00:03:25.9365663Z     # RF1: the old test was `counter_status.startswith("candidate")`, which is
2026-11-14T00:03:25.9366089Z     # both too narrow (it misses `abstained_unevidenced`, a real counter status
2026-11-14T00:03:25.9366522Z     # the frozen counter-anchor classifier emits) and definitionally wrong. Use
2026-11-14T00:03:25.9367017Z     # the accepted single source of truth and publish both counts.
2026-11-14T00:03:25.9367368Z     counter_authorities = counter_authority_count(rows)
2026-11-14T00:03:25.9367712Z     counter_status_bearing = counter_status_bearing_count(rows)
2026-11-14T00:03:25.9368011Z ---tests init---
