2026-11-14T00:07:55.6567526Z def select_profile(run_id: str) -> dict[str, Any]:
2026-11-14T00:07:55.6567916Z     """Resolve the dossier profile for ``run_id`` (aliases are followed).
2026-11-14T00:07:55.6568194Z 
2026-11-14T00:07:55.6568392Z     A dossier for the wrong run is worse than no dossier: it would re-derive
2026-11-14T00:07:55.6568844Z     another run's claims and label them with this run's id.  Unknown run ids
2026-11-14T00:07:55.6569329Z     therefore fail closed instead of silently inheriting the default profile.
2026-11-14T00:07:55.6569682Z     """
2026-11-14T00:07:55.6569873Z     key = str(run_id)
2026-11-14T00:07:55.6570106Z     prof = PROFILES.get(key)
2026-11-14T00:07:55.6570394Z     while isinstance(prof, dict) and "alias_of" in prof:
2026-11-14T00:07:55.6570725Z         prof = PROFILES.get(str(prof["alias_of"]))
2026-11-14T00:07:55.6571285Z     if prof is None:
2026-11-14T00:07:55.6571512Z         raise SystemExit(
2026-11-14T00:07:55.6572089Z             f"no audit-readiness profile for run {key}; refusing to fall back "
2026-11-14T00:07:55.6572519Z             f"to {DEFAULT_PROFILE_KEY} and publish another run's claims")
2026-11-14T00:07:55.6572866Z     return dict(prof)
2026-11-14T00:07:55.6572998Z 
2026-11-14T00:07:55.6573002Z 
2026-11-14T00:07:55.6573135Z def p(field: str, default: Any = None) -> Any:
2026-11-14T00:07:55.6573496Z     """Profile field with a fallback to the pinned module constants."""
2026-11-14T00:07:55.6573839Z     if field in PROFILE:
2026-11-14T00:07:55.6574077Z         return PROFILE[field]
2026-11-14T00:07:55.6574310Z     return default
2026-11-14T00:07:55.6574435Z 
