2026-11-14T00:04:44.5279227Z """The orchestration-death classifier must name classes, not moods.
2026-11-14T00:04:44.5279494Z 
2026-11-14T00:04:44.5279735Z Every case here is a hand-built record, so the whole module is testable with no
2026-11-14T00:04:44.5280192Z network and no GitHub access.  Two properties matter more than coverage:
2026-11-14T00:04:44.5280441Z 
2026-11-14T00:04:44.5280708Z * the classes must be **mutually distinguishable** — an audit that died because
2026-11-14T00:04:44.5281377Z   its gate file was misplaced must not be filed under "cancelled", because the
2026-11-14T00:04:44.5281745Z   two have opposite lane levers;
2026-11-14T00:04:44.5282091Z * the classifier must be **non-vacuous**: a record that merely *looks* like the
2026-11-14T00:04:44.5282544Z   39082232157 record must still be classified, so the label is not an artefact of
2026-11-14T00:04:44.5282898Z   a hard-coded run id.
2026-11-14T00:04:44.5283115Z """
2026-11-14T00:04:44.5283325Z from __future__ import annotations
2026-11-14T00:04:44.5283485Z 
2026-11-14T00:04:44.5283570Z import json
2026-11-14T00:04:44.5283760Z import subprocess
2026-11-14T00:04:44.5284219Z from pathlib import Path
2026-11-14T00:04:44.5284357Z 
2026-11-14T00:04:44.5284447Z import pytest
2026-11-14T00:04:44.5284564Z 
2026-11-14T00:04:44.5284683Z from product import orchestration_evidence as oe
2026-11-14T00:04:44.5284881Z 
2026-11-14T00:04:44.5284986Z ROOT = Path(__file__).resolve().parents[2]
2026-11-14T00:04:44.5285164Z 
2026-11-14T00:04:44.5285168Z 
2026-11-14T00:04:44.5285301Z def _step(job, name, conclusion, duration, *, number=1):
2026-11-14T00:04:44.5285584Z     return {
2026-11-14T00:04:44.5285772Z         "job": job,
2026-11-14T00:04:44.5285983Z         "job_conclusion": conclusion,
2026-11-14T00:04:44.5286232Z         "step_number": number,
2026-11-14T00:04:44.5286457Z         "step": name,
2026-11-14T00:04:44.5286669Z         "status": "completed",
2026-11-14T00:04:44.5286909Z         "conclusion": conclusion,
2026-11-14T00:04:44.5287146Z         "duration_s": duration,
2026-11-14T00:04:44.5287362Z     }
2026-11-14T00:04:44.5287464Z 
2026-11-14T00:04:44.5287473Z 
2026-11-14T00:04:44.5287566Z AUDIT_AGENT = "Independent audit"
2026-11-14T00:04:44.5287835Z GATE_READER = "Enforce audit scope and read gate"
2026-11-14T00:04:44.5288131Z PERSIST = "Persist audit snapshot"
2026-11-14T00:04:44.5288290Z 
2026-11-14T00:04:44.5288294Z 
2026-11-14T00:04:44.5288487Z def test_read_wrapper_quantum_reads_the_real_script_when_present(tmp_path):
2026-11-14T00:04:44.5288966Z     """The quantum must come from the wrapper, not from a constant in this module.
2026-11-14T00:04:44.5289232Z 
2026-11-14T00:04:44.5289425Z     Hard-coding it would make the "the step outran the watchdog" claim silently
2026-11-14T00:04:44.5289839Z     wrong the first time the control plane changes the budget.
2026-11-14T00:04:44.5290189Z     """
2026-11-14T00:04:44.5290402Z     modern = tmp_path / ".github" / "scripts"
2026-11-14T00:04:44.5290968Z     modern.mkdir(parents=True)
2026-11-14T00:04:44.5291407Z     (modern / "run-ox-with-retry.sh").write_text(
2026-11-14T00:04:44.5291954Z         'WORK_QUANTUM_SECONDS="${LEX_AGENT_QUANTUM_SECONDS:-1234}"\n', encoding="utf-8"
2026-11-14T00:04:44.5292370Z     )
2026-11-14T00:04:44.5292591Z     assert oe.read_wrapper_quantum(tmp_path) == 1234
2026-11-14T00:04:44.5292786Z 
2026-11-14T00:04:44.5292924Z     # ... and against the checkout this cycle actually ran in.
2026-11-14T00:04:44.5293248Z     checked_out = oe.read_wrapper_quantum(ROOT)
2026-11-14T00:04:44.5293560Z     assert isinstance(checked_out, int) and checked_out > 0
2026-11-14T00:04:44.5293770Z 
2026-11-14T00:04:44.5293773Z 
2026-11-14T00:04:44.5293956Z def test_read_wrapper_quantum_degrades_to_the_documented_default(tmp_path):
2026-11-14T00:04:44.5294425Z     assert oe.read_wrapper_quantum(tmp_path) == oe.DEFAULT_WRAPPER_QUANTUM_SECONDS
2026-11-14T00:04:44.5294792Z     (tmp_path / ".github").mkdir()
2026-11-14T00:04:44.5295066Z     (tmp_path / ".github" / "scripts").mkdir()
2026-11-14T00:04:44.5295414Z     (tmp_path / ".github" / "scripts" / "run-ox-with-retry.sh").write_text(
2026-11-14T00:04:44.5295757Z         "no quantum here\n", encoding="utf-8"
2026-11-14T00:04:44.5296003Z     )
2026-11-14T00:04:44.5296289Z     assert oe.read_wrapper_quantum(tmp_path) == oe.DEFAULT_WRAPPER_QUANTUM_SECONDS
2026-11-14T00:04:44.5296559Z 
