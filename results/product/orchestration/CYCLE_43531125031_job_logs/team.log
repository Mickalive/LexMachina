2026-11-14T00:04:57.1654841Z def test_resume_diagnosis_is_observed_and_zero_delta():
2026-11-14T00:04:57.1655208Z     diag = _load(DIAGNOSIS)
2026-11-14T00:04:57.1655542Z     assert diag["run_id"] == SNAPSHOT
2026-11-14T00:04:57.1655939Z     assert diag["predecessor_run_id"] == PREDECESSOR
2026-11-14T00:04:57.1656276Z     orch = diag["orchestration"]
2026-11-14T00:04:57.1656628Z     assert orch["classification"] == "TEAM_JOB_LANE_CYCLE_STEP_FAILED_NO_GATE"
2026-11-14T00:04:57.1657037Z     assert orch["team"]["failed_step"] == "Run lane cycle"
2026-11-14T00:04:57.1657369Z     assert orch["team"]["failed_step_seconds"] == 16.0
