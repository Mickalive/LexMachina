2026-11-14T00:02:16.4633962Z def _annotations(job: dict, token: str, repo: str) -> list[dict]:
2026-11-14T00:02:16.4634673Z     """Check-run annotations for ``job``; job id doubles as the check-run id.
2026-11-14T00:02:16.4635298Z 
2026-11-14T00:02:16.4635611Z     Annotations are the only public channel that carries the wrapper's
2026-11-14T00:02:16.4636375Z     ``LEX_WORK_QUANTUM_EXPIRED`` / ``exit code`` lines.  An endpoint failure
2026-11-14T00:02:16.4636990Z     is recorded as an empty list - never guessed at - because
2026-11-14T00:02:16.4637597Z     :func:`product.audit_step_diagnosis.classify` reports
2026-11-14T00:02:16.4638258Z     ``annotations_available=false`` honestly in that case.
2026-11-14T00:02:16.4638891Z     """
2026-11-14T00:02:16.4639391Z     status, body = _request(
2026-11-14T00:02:16.4640267Z         f"https://api.github.com/repos/{repo}/check-runs/{job['id']}/annotations",
2026-11-14T00:02:16.4641483Z         token)
2026-11-14T00:02:16.4641907Z     if status != 200:
2026-11-14T00:02:16.4642379Z         return []
2026-11-14T00:02:16.4642796Z     rows = json.loads(body)
2026-11-14T00:02:16.4643243Z     if not isinstance(rows, list):
2026-11-14T00:02:16.4643816Z         return []
2026-11-14T00:02:16.4644406Z     keep = ("annotation_level", "message", "path", "start_line", "end_line")
2026-11-14T00:02:16.4645193Z     return [{k: row.get(k) for k in keep if k in row} for row in rows
2026-11-14T00:02:16.4645793Z             if isinstance(row, dict)]
2026-11-14T00:02:16.4646031Z 
