2026-11-14T00:03:14.4800638Z     ROOT / "results" / "product" / "gate_packet" / "39319405429" / "questions"
2026-11-14T00:03:14.4801085Z )
2026-11-14T00:03:14.4801271Z PACKET_V3_QIDS = {
