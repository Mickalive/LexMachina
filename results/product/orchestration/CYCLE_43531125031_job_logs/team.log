2026-11-14T00:04:27.6883719Z     assert observed["source"] == "github_actions_check_run_annotations"
2026-11-14T00:04:27.6884078Z     assert observed["quantum_message"] == (
2026-11-14T00:04:27.6884384Z         "LEX_WORK_QUANTUM_EXPIRED seconds=2700 pid=3075")
2026-11-14T00:04:27.6884885Z     assert "No provider or auth cause is claimed" in mech["claim"]
2026-11-14T00:04:27.6885117Z 
