2026-11-14T00:02:16.4646233Z class _StripAuthOnRedirect(urllib.request.HTTPRedirectHandler):
2026-11-14T00:02:16.4646792Z     """Do not forward the API credential to the storage redirect target.
2026-11-14T00:02:16.4647109Z 
2026-11-14T00:02:16.4647348Z     Without this, urllib replays ``<REDACTED-CREDENTIAL> onto the
2026-11-14T00:02:16.4647937Z     pre-signed blob URL and Azure answers ``AuthenticationFailed`` (HTTP 403),
2026-11-14T00:02:16.4648493Z     which is indistinguishable from "logs are admin-only" unless you look at
2026-11-14T00:02:16.4649007Z     the XML body.  ``curl`` never made this mistake because it drops the
2026-11-14T00:02:16.4649468Z     header across hosts by default.
2026-11-14T00:02:16.4649829Z     """
2026-11-14T00:02:16.4649986Z 
2026-11-14T00:02:16.4650239Z     def redirect_request(self, req, fp, code, msg, headers, newurl):  # noqa: ANN001
2026-11-14T00:02:16.4650997Z         new_req = super().redirect_request(req, fp, code, msg, headers, newurl)
2026-11-14T00:02:16.4651514Z         if new_req is not None:
2026-11-14T00:02:16.4651988Z             for key in list(new_req.headers):
2026-11-14T00:02:16.4652572Z                 if key.lower() == "authorization":
2026-11-14T00:02:16.4653139Z                     del new_req.headers[key]
2026-11-14T00:02:16.4653670Z         return new_req
