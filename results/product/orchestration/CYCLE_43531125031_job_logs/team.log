2026-11-14T00:03:07.3146978Z # Bootstrap invariant: persistent lab/cycle branches never execute an obsolete
2026-11-14T00:03:07.3147630Z # launcher. Re-exec the exact current wrapper from main when it differs.
2026-11-14T00:03:07.3148137Z if [[ "${LEX_WRAPPER_REEXEC:-0}" != "1" ]]; then
2026-11-14T00:03:07.3148796Z   LATEST_WRAPPER="$(mktemp)"
2026-11-14T00:03:07.3149546Z   if git fetch -q origin main 2>/dev/null && git show origin/main:.github/scripts/run-ox-with-retry.sh > "$LATEST_WRAPPER" 2>/dev/null; then
2026-11-14T00:03:07.3150291Z     if ! cmp -s "$0" "$LATEST_WRAPPER"; then
2026-11-14T00:03:07.3150704Z       chmod +x "$LATEST_WRAPPER"
2026-11-14T00:03:07.3151220Z       export LEX_WRAPPER_REEXEC=1
2026-11-14T00:03:07.3151495Z       exec bash "$LATEST_WRAPPER" "$@"
2026-11-14T00:03:07.3151741Z     fi
2026-11-14T00:03:07.3151922Z   fi
2026-11-14T00:03:07.3152114Z   rm -f "$LATEST_WRAPPER"
2026-11-14T00:03:07.3152337Z fi
2026-11-14T00:03:07.3152443Z 
2026-11-14T00:03:07.3152578Z REAL="${OPENCODE_BIN:-$HOME/.opencode/bin/opencode}"
