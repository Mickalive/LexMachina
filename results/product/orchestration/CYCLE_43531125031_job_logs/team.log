2026-11-14T00:03:14.4790508Z #: bstger_SK.2023.49 stays verified/sound".
2026-11-14T00:03:14.4790769Z CONFIRMED_SOUND_ROW = (
2026-11-14T00:03:14.4791256Z     "results/product/offline_slice/20261024T185300Z"
