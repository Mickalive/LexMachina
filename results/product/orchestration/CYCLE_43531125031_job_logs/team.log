2026-11-14T00:02:16.4555024Z [0m$ [0mcd /home/runner/work/LexMachina/LexMachina && sed -n '1,200p' product/fetch_run_jobs_snapshot.py
2026-11-14T00:02:16.4556106Z #!/usr/bin/env python3
2026-11-14T00:02:16.4561813Z """Capture a public GitHub Actions run/jobs snapshot for an operational resume.
2026-11-14T00:02:16.4562637Z 
2026-11-14T00:02:16.4562852Z Why this exists
2026-11-14T00:02:16.4563322Z ---------------
2026-11-14T00:02:16.4563979Z Every operational resume of this lane has to answer "why did the previous run
2026-11-14T00:02:16.4564870Z stop before a gate?".  The answer has to come from a *committed* snapshot, not
2026-11-14T00:02:16.4565720Z from prose: the run record, every job, every step conclusion and duration, and
2026-11-14T00:02:16.4566665Z the check-run annotations.  Annotations are public even when job logs are not
2026-11-14T00:02:16.4567586Z (the logs endpoint answers HTTP 403 ``Must have admin rights to Repository``
2026-11-14T00:02:16.4568399Z for the runner's own ``actions: write`` token - observed on run 43357207555),
2026-11-14T00:02:16.4569325Z and they are what turns "mechanism unobserved" into an observed
2026-11-14T00:02:16.4570060Z ``LEX_WORK_QUANTUM_EXPIRED`` / ``exit code 78`` fact.
2026-11-14T00:02:16.4570420Z 
2026-11-14T00:02:16.4570783Z Logs are also reachable: the earlier ``HTTP 403 Must have admin rights to
2026-11-14T00:02:16.4571937Z Repository`` observation for this endpoint came from sending the checkout's
2026-11-14T00:02:16.4572804Z ``basic`` extraheader, not from the endpoint's policy.  With the ``token``
2026-11-14T00:02:16.4573670Z scheme and without forwarding credentials to the storage redirect the job log
2026-11-14T00:02:16.4574541Z downloads at HTTP 200, so this tool captures redacted logs as well - and the
2026-11-14T00:02:16.4575788Z ``logs_endpoint_status`` field then records 200, which is what
2026-11-14T00:02:16.4576608Z :func:`product.audit_step_diagnosis.classify` needs before it may say the
2026-11-14T00:02:16.4577332Z log-level cause is readable.
2026-11-14T00:02:16.4577641Z 
2026-11-14T00:02:16.4577841Z What it does
2026-11-14T00:02:16.4578248Z ------------
2026-11-14T00:02:16.4578837Z * reads credentials from the checkout's own git HTTP extraheader (or
2026-11-14T00:02:16.4579686Z   ``GITHUB_TOKEN`` / ``GH_TOKEN``); the token is used for the request and is
2026-11-14T00:02:16.4580343Z   NEVER written to the artifact;
2026-11-14T00:02:16.4581319Z * fetches the run, its jobs (with per-step conclusions and timestamps) and the
2026-11-14T00:02:16.4582136Z   check-run annotations for every job;
2026-11-14T00:02:16.4582944Z * probes the job-logs endpoint and records only the HTTP status code, because
2026-11-14T00:02:16.4583848Z   "logs downloadable: yes/no" changes how :func:`product.audit_step_diagnosis.classify`
2026-11-14T00:02:16.4584580Z   words its mechanism claim;
2026-11-14T00:02:16.4585289Z * fails closed: a non-2xx API answer raises instead of writing a half-empty
2026-11-14T00:02:16.4585980Z   snapshot that later looks like evidence.
2026-11-14T00:02:16.4586347Z 
2026-11-14T00:02:16.4586547Z Usage
2026-11-14T00:02:16.4586982Z -----
2026-11-14T00:02:16.4587579Z     python3 product/fetch_run_jobs_snapshot.py --run-id 43357207555 \\
2026-11-14T00:02:16.4588341Z         --note "audit job died before a gate" \\
2026-11-14T00:02:16.4589126Z         --out results/product/orchestration/CYCLE_43357207555_run_jobs_raw.json
2026-11-14T00:02:16.4589859Z """
2026-11-14T00:02:16.4590349Z from __future__ import annotations
2026-11-14T00:02:16.4590696Z 
2026-11-14T00:02:16.4591668Z import argparse
2026-11-14T00:02:16.4592231Z import base64
2026-11-14T00:02:16.4592623Z import json
2026-11-14T00:02:16.4592996Z import os
2026-11-14T00:02:16.4593502Z import re
2026-11-14T00:02:16.4593884Z import subprocess
2026-11-14T00:02:16.4594323Z import sys
2026-11-14T00:02:16.4594712Z import urllib.error
2026-11-14T00:02:16.4595153Z import urllib.request
2026-11-14T00:02:16.4595769Z from datetime import datetime, timezone
2026-11-14T00:02:16.4596363Z from pathlib import Path
2026-11-14T00:02:16.4596886Z from typing import Any
2026-11-14T00:02:16.4597445Z 
2026-11-14T00:02:16.4597640Z ROOT = Path(__file__).resolve().parents[1]
2026-11-14T00:02:16.4598272Z SCHEMA = "github-actions-run-jobs-snapshot/1"
2026-11-14T00:02:16.4599116Z REPO_RE = re.compile(r"^https://api\.github\.com/repos/([^/]+)/([^/]+)")
2026-11-14T00:02:16.4599898Z FUZZY = 60  # seconds of clock skew tolerated between run and job timestamps
2026-11-14T00:02:16.4600352Z 
2026-11-14T00:02:16.4600359Z 
2026-11-14T00:02:16.4600591Z def repo_slug() -> str:
2026-11-14T00:02:16.4601465Z     """``owner/name`` from the checkout, so the tool is never pinned to one fork."""
2026-11-14T00:02:16.4602276Z     env = os.environ.get("GITHUB_REPOSITORY", "").strip()
2026-11-14T00:02:16.4602964Z     if env.count("/") == 1:
2026-11-14T00:02:16.4603388Z         return env
2026-11-14T00:02:16.4604006Z     url = _git("config", "--get", "remote.origin.url").stdout.strip()
2026-11-14T00:02:16.4604774Z     match = re.search(r"github\.com[:/]([^/]+/[^/.]+?)(?:\.git)?$", url)
2026-11-14T00:02:16.4605432Z     if match:
2026-11-14T00:02:16.4605876Z         return match.group(1)
2026-11-14T00:02:16.4606533Z     raise SystemExit(f"cannot determine the GitHub repository from {url!r}")
2026-11-14T00:02:16.4607067Z 
2026-11-14T00:02:16.4607074Z 
2026-11-14T00:02:16.4607310Z def _git(*args: str) -> subprocess.CompletedProcess:
2026-11-14T00:02:16.4608072Z     return subprocess.run(["git", *args], cwd=str(ROOT), capture_output=True,
2026-11-14T00:02:16.4608800Z                           text=True, check=False)
2026-11-14T00:02:16.4609155Z 
2026-11-14T00:02:16.4609160Z 
2026-11-14T00:02:16.4609410Z def api_token() -> str:
2026-11-14T00:02:16.4609927Z     """Token from the checkout's git config, then the standard env vars."""
2026-11-14T00:02:16.4610547Z     header = _git("config", "--get",
2026-11-14T00:02:16.4611629Z                   "http.https://github.com/.extraheader").stdout or ""
2026-11-14T00:02:16.4612368Z     match = re.search(r"basic\s+(\S+)", header, re.IGNORECASE)
2026-11-14T00:02:16.4612990Z     if match:
2026-11-14T00:02:16.4613378Z         try:
2026-11-14T00:02:16.4613863Z             decoded = base64.b64decode(match.group(1)).decode("utf-8")
2026-11-14T00:02:16.4614629Z         except (ValueError, UnicodeDecodeError):
2026-11-14T00:02:16.4615255Z             decoded = ""
2026-11-14T00:02:16.4615931Z         if ":" in decoded:
2026-11-14T00:02:16.4616522Z             _, token = decoded.split(":", 1)
2026-11-14T00:02:16.4616924Z             if token:
2026-11-14T00:02:16.4617329Z                 return token
2026-11-14T00:02:16.4617736Z     for name in ("GITHUB_TOKEN", "GH_TOKEN", "LEX_GITHUB_TOKEN"):
2026-11-14T00:02:16.4618248Z         value = os.environ.get(name, "").strip()
2026-11-14T00:02:16.4618667Z         if value:
2026-11-14T00:02:16.4619074Z             return value
2026-11-14T00:02:16.4619608Z     raise SystemExit(
2026-11-14T00:02:16.4619998Z         "no GitHub token available: git http.extraheader and GITHUB_TOKEN/"
2026-11-14T00:02:16.4620765Z         "GH_TOKEN are all empty; refusing to write an annotation-free "
2026-11-14T00:02:16.4621630Z         "snapshot that would read as 'mechanism unobserved'")
2026-11-14T00:02:16.4622039Z 
2026-11-14T00:02:16.4622046Z 
2026-11-14T00:02:16.4622289Z def _request(url: str, token: str) -> tuple[int, bytes]:
2026-11-14T00:02:16.4622858Z     req = urllib.request.Request(
2026-11-14T00:02:16.4623414Z         url, headers={
2026-11-14T00:02:16.4624329Z             "Authorization": f"***",
2026-11-14T00:02:16.4624739Z             "Accept": "application/vnd.github+json",
2026-11-14T00:02:16.4625246Z             "User-Agent": "lexmachina-product-resume",
2026-11-14T00:02:16.4625783Z         })
2026-11-14T00:02:16.4626092Z     try:
2026-11-14T00:02:16.4626425Z         with urllib.request.urlopen(req, timeout=60) as resp:
2026-11-14T00:02:16.4626858Z             return resp.status, resp.read()
2026-11-14T00:02:16.4627308Z     except urllib.error.HTTPError as exc:  # HTTP status is data, not a crash
