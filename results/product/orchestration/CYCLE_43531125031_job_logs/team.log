2026-11-14T00:04:40.3037699Z #!/usr/bin/env python3
2026-11-14T00:04:40.3038162Z """Classify why a core-lane run stopped before an independent audit gate.
2026-11-14T00:04:40.3038547Z 
2026-11-14T00:04:40.3038671Z Why this exists
2026-11-14T00:04:40.3038942Z ---------------
2026-11-14T00:04:40.3039377Z The product cycle is routinely resumed with the instruction "diagnose the
2026-11-14T00:04:40.3039844Z orchestration/validation failure".  From the producer tree alone the important
2026-11-14T00:04:40.3040693Z facts are: did the team job persist its snapshot, did the provider/agent step
2026-11-14T00:04:40.3041362Z fail, and did an independent gate ever get written?  This module answers those
2026-11-14T00:04:40.3041869Z questions from a committed GitHub Actions run/jobs snapshot -- no token, no job
2026-11-14T00:04:40.3042270Z logs, no guessing at a cause it cannot observe.
2026-11-14T00:04:40.3042461Z 
2026-11-14T00:04:40.3042562Z It deliberately does NOT:
2026-11-14T00:04:40.3042894Z * claim a provider/auth/quantum mechanism when the log is unavailable;
2026-11-14T00:04:40.3043329Z * treat a failed audit *or team* job as a product defect or as a verdict;
2026-11-14T00:04:40.3043766Z * write ``results/audit/**`` (only the independent auditor may write there).
2026-11-14T00:04:40.3044037Z 
2026-11-14T00:04:40.3044226Z The ``team`` block reports the persist step's OWN conclusion.  This matters
2026-11-14T00:04:40.3044679Z because the workflow guards that step with ``if: always()``: a failed producer
2026-11-14T00:04:40.3045161Z still publishes its (possibly unchanged) tree to the team ref, so "team job
2026-11-14T00:04:40.3045620Z failed" must never be reported as "no snapshot exists".  Whether that snapshot
2026-11-14T00:04:40.3046090Z carries a durable delta is a separate, git-ref fact and is deliberately not
2026-11-14T00:04:40.3046440Z inferred here.
2026-11-14T00:04:40.3046557Z 
2026-11-14T00:04:40.3046639Z Usage
2026-11-14T00:04:40.3046815Z -----
2026-11-14T00:04:40.3047132Z     python3 product/audit_step_diagnosis.py --raw <snapshot.json> --out <dir>
2026-11-14T00:04:40.3047484Z """
2026-11-14T00:04:40.3047686Z from __future__ import annotations
2026-11-14T00:04:40.3047858Z 
2026-11-14T00:04:40.3047948Z import argparse
2026-11-14T00:04:40.3048146Z import json
2026-11-14T00:04:40.3048331Z import re
2026-11-14T00:04:40.3048541Z from datetime import datetime, timezone
2026-11-14T00:04:40.3048814Z from pathlib import Path
2026-11-14T00:04:40.3048955Z 
2026-11-14T00:04:40.3049083Z SCHEMA = "product-audit-step-diagnosis/1"
2026-11-14T00:04:40.3049356Z TEAM_JOB = "team"
2026-11-14T00:04:40.3049561Z AUDIT_JOB = "audit"
2026-11-14T00:04:40.3049784Z AUDIT_STEP = "Independent audit"
2026-11-14T00:04:40.3050108Z QUANTUM_RE = re.compile(r"LEX_WORK_QUANTUM_EXPIRED\s+seconds=(\d+)")
2026-11-14T00:04:40.3050627Z EXIT_CODE_RE = re.compile(r"exit code\s+(\d+)", re.IGNORECASE)
2026-11-14T00:04:40.3051066Z 
2026-11-14T00:04:40.3051072Z 
2026-11-14T00:04:40.3051207Z def _step(job: dict, name: str) -> dict | None:
2026-11-14T00:04:40.3051597Z     return next((s for s in job.get("steps") or [] if s.get("name") == name), None)
2026-11-14T00:04:40.3051872Z 
2026-11-14T00:04:40.3051875Z 
2026-11-14T00:04:40.3052064Z def _seconds_between(start: str | None, end: str | None) -> float | None:
2026-11-14T00:04:40.3052418Z     if not start or not end:
2026-11-14T00:04:40.3052647Z         return None
2026-11-14T00:04:40.3052864Z     fmt = "%Y-%m-%dT%H:%M:%SZ"
2026-11-14T00:04:40.3053215Z     return round((datetime.strptime(end, fmt) - datetime.strptime(start, fmt))
2026-11-14T00:04:40.3053596Z                  .total_seconds(), 1)
2026-11-14T00:04:40.3053765Z 
2026-11-14T00:04:40.3053768Z 
2026-11-14T00:04:40.3053927Z def _job_annotations(snapshot: dict, job: dict) -> list[dict]:
2026-11-14T00:04:40.3054339Z     """Return the check-run annotations for ``job`` from a committed snapshot.
2026-11-14T00:04:40.3054599Z 
2026-11-14T00:04:40.3054791Z     Two layouts are accepted because the raw snapshots were captured by hand:
2026-11-14T00:04:40.3055239Z     ``snapshot["annotations"][<job id>]`` (what the workflow-adjacent fetcher
2026-11-14T00:04:40.3055674Z     writes) and a job-local ``job["annotations"]`` list.  Anything else is
2026-11-14T00:04:40.3056035Z     treated as "not captured", never guessed.
2026-11-14T00:04:40.3056290Z     """
2026-11-14T00:04:40.3056504Z     ann = snapshot.get("annotations")
2026-11-14T00:04:40.3056765Z     if isinstance(ann, dict):
2026-11-14T00:04:40.3057035Z         for key in (str(job.get("id")), job.get("id")):
2026-11-14T00:04:40.3057441Z             if key in ann and isinstance(ann[key], list):
2026-11-14T00:04:40.3057734Z                 return ann[key]
2026-11-14T00:04:40.3057975Z     job_ann = job.get("annotations")
2026-11-14T00:04:40.3058235Z     if isinstance(job_ann, list):
2026-11-14T00:04:40.3058477Z         return job_ann
2026-11-14T00:04:40.3058684Z     return []
2026-11-14T00:04:40.3058801Z 
2026-11-14T00:04:40.3058805Z 
2026-11-14T00:04:40.3058966Z def _failure_annotations(snapshot: dict, team: dict, audit: dict,
2026-11-14T00:04:40.3059376Z                          audit_step_failed: bool, failed_team_step: dict | None
2026-11-14T00:04:40.3059704Z                          ) -> dict:
2026-11-14T00:04:40.3060044Z     """Extract the *observable* failure annotations, if the snapshot has them.
2026-11-14T00:04:40.3060304Z 
2026-11-14T00:04:40.3060499Z     GitHub check-run annotations are public even when job logs require admin
2026-11-14T00:04:40.3061137Z     rights.  The workflow's own 45-minute agent wrapper announces
2026-11-14T00:04:40.3061566Z     ``LEX_WORK_QUANTUM_EXPIRED seconds=2700`` and exit code 78, so a quantum
2026-11-14T00:04:40.3062002Z     expiry can be stated as observed evidence instead of "mechanism unknown".
2026-11-14T00:04:40.3062343Z     """
2026-11-14T00:04:40.3062545Z     if audit_step_failed:
2026-11-14T00:04:40.3062786Z         job_name, job = AUDIT_JOB, audit
2026-11-14T00:04:40.3063062Z     elif failed_team_step is not None:
2026-11-14T00:04:40.3063325Z         job_name, job = TEAM_JOB, team
2026-11-14T00:04:40.3063564Z     else:
2026-11-14T00:04:40.3063758Z         job_name, job = None, {}
2026-11-14T00:04:40.3063992Z     messages = [
2026-11-14T00:04:40.3064199Z         str(a.get("message") or "")
2026-11-14T00:04:40.3064464Z         for a in _job_annotations(snapshot, job)
2026-11-14T00:04:40.3064740Z         if isinstance(a, dict)
2026-11-14T00:04:40.3064961Z     ]
2026-11-14T00:04:40.3065151Z     quantum_seconds = None
2026-11-14T00:04:40.3065377Z     exit_code = None
2026-11-14T00:04:40.3065629Z     quantum_message = None
2026-11-14T00:04:40.3065868Z     for message in messages:
2026-11-14T00:04:40.3066109Z         m = QUANTUM_RE.search(message)
2026-11-14T00:04:40.3066349Z         if m:
2026-11-14T00:04:40.3066650Z             quantum_seconds = int(m.group(1))
2026-11-14T00:04:40.3066938Z             quantum_message = message.strip()
2026-11-14T00:04:40.3067214Z         e = EXIT_CODE_RE.search(message)
2026-11-14T00:04:40.3067472Z         if e and exit_code is None:
2026-11-14T00:04:40.3067727Z             exit_code = int(e.group(1))
2026-11-14T00:04:40.3067975Z     return {
2026-11-14T00:04:40.3068166Z         "source": (
2026-11-14T00:04:40.3068452Z             "github_actions_check_run_annotations" if messages else "none"
2026-11-14T00:04:40.3068775Z         ),
2026-11-14T00:04:40.3068990Z         "annotations_available": bool(messages),
2026-11-14T00:04:40.3069259Z         "job": job_name,
2026-11-14T00:04:40.3069479Z         "exit_code": exit_code,
2026-11-14T00:04:40.3069755Z         "quantum_expired": quantum_seconds is not None,
2026-11-14T00:04:40.3070050Z         "quantum_seconds": quantum_seconds,
2026-11-14T00:04:40.3070440Z         "quantum_message": quantum_message,
2026-11-14T00:04:40.3070714Z         "messages": messages,
2026-11-14T00:04:40.3071133Z     }
2026-11-14T00:04:40.3071236Z 
2026-11-14T00:04:40.3071240Z 
2026-11-14T00:04:40.3071350Z def classify(snapshot: dict) -> dict:
2026-11-14T00:04:40.3071675Z     """Pure classification of a committed run/jobs snapshot."""
2026-11-14T00:04:40.3072000Z     run = snapshot.get("run") or {}
2026-11-14T00:04:40.3072312Z     jobs = {j.get("name"): j for j in snapshot.get("jobs") or []}
2026-11-14T00:04:40.3072630Z     team = jobs.get(TEAM_JOB) or {}
2026-11-14T00:04:40.3072890Z     audit = jobs.get(AUDIT_JOB) or {}
2026-11-14T00:04:40.3073157Z     audit_step = _step(audit, AUDIT_STEP)
2026-11-14T00:04:40.3073482Z     gate_step = _step(audit, "Enforce audit scope and read gate")
2026-11-14T00:04:40.3073943Z     persist_step = _step(audit, "Persist audit snapshot")
2026-11-14T00:04:40.3074321Z     validate_step = _step(team, "Validate active MVP producer state")
2026-11-14T00:04:40.3074693Z     scope_step = _step(team, "Enforce lane write scope")
2026-11-14T00:04:40.3075032Z     snapshot_step = _step(team, "Persist team snapshot")
2026-11-14T00:04:40.3075346Z     integrate = jobs.get("integrate") or {}
2026-11-14T00:04:40.3075526Z 
2026-11-14T00:04:40.3075639Z     team_ok = team.get("conclusion") == "success"
2026-11-14T00:04:40.3075954Z     audit_failed = audit.get("conclusion") == "failure"
2026-11-14T00:04:40.3076355Z     audit_step_failed = bool(audit_step and audit_step.get("conclusion") == "failure")
2026-11-14T00:04:40.3076836Z     gate_skipped = bool(gate_step and gate_step.get("conclusion") == "skipped")
2026-11-14T00:04:40.3077274Z     # The workflow guards "Persist team snapshot" with `if: always()`, so the
2026-11-14T00:04:40.3077709Z     # step conclusion is the FACT about the snapshot, independent of whether
2026-11-14T00:04:40.3078145Z     # the team job succeeded.  Reporting it as `team_ok and persist_ok` hides
2026-11-14T00:04:40.3078589Z     # the always-publish behaviour that lets a failed producer's (empty) tree
2026-11-14T00:04:40.3078948Z     # reach the team ref anyway.
2026-11-14T00:04:40.3079198Z     team_snapshot_persisted = bool(
2026-11-14T00:04:40.3079516Z         snapshot_step and snapshot_step.get("conclusion") == "success"
2026-11-14T00:04:40.3079829Z     )
2026-11-14T00:04:40.3080022Z     failed_team_step = next(
2026-11-14T00:04:40.3080346Z         (s for s in team.get("steps") or [] if s.get("conclusion") == "failure"),
2026-11-14T00:04:40.3080673Z         None,
2026-11-14T00:04:40.3080983Z     )
2026-11-14T00:04:40.3081241Z     audit_skipped = audit.get("conclusion") == "skipped"
2026-11-14T00:04:40.3081552Z     annotations = _failure_annotations(
2026-11-14T00:04:40.3081881Z         snapshot, team, audit, audit_step_failed, failed_team_step
2026-11-14T00:04:40.3082188Z     )
2026-11-14T00:04:40.3082427Z     quantum_seconds = annotations.get("quantum_seconds")
2026-11-14T00:04:40.3082787Z     quantum_expired = bool(annotations.get("quantum_expired"))
2026-11-14T00:04:40.3083197Z     # HTTP 200 on the run-jobs logs endpoint means the producing cycle (or a
2026-11-14T00:04:40.3083700Z     # later resume holding the producer token) actually downloaded the job
2026-11-14T00:04:40.3084136Z     # logs; "not downloadable" is then a false sentence, see the branch below.
2026-11-14T00:04:40.3084559Z     logs_available = bool(snapshot.get("logs_endpoint_status") == 200)
2026-11-14T00:04:40.3084801Z 
2026-11-14T00:04:40.3084944Z     if not team_ok and failed_team_step and audit_skipped:
2026-11-14T00:04:40.3085277Z         if failed_team_step.get("name") == "Run lane cycle":
2026-11-14T00:04:40.3085628Z             classification = "TEAM_JOB_LANE_CYCLE_STEP_FAILED_NO_GATE"
2026-11-14T00:04:40.3085941Z         else:
2026-11-14T00:04:40.3086180Z             classification = "TEAM_JOB_FAILED_OTHER_STEP"
2026-11-14T00:04:40.3086556Z     elif team_ok and audit_failed and audit_step_failed and gate_skipped:
2026-11-14T00:04:40.3086972Z         classification = "AUDIT_JOB_INDEPENDENT_AUDIT_STEP_FAILED_NO_GATE"
2026-11-14T00:04:40.3087319Z     elif team_ok and audit_failed:
2026-11-14T00:04:40.3087596Z         classification = "AUDIT_JOB_FAILED_OTHER_STEP"
2026-11-14T00:04:40.3087921Z     elif team_ok and audit.get("conclusion") == "success":
2026-11-14T00:04:40.3088242Z         classification = "AUDIT_JOB_COMPLETED"
2026-11-14T00:04:40.3088501Z     else:
2026-11-14T00:04:40.3088755Z         classification = "TEAM_JOB_DID_NOT_COMPLETE_SUCCESSFULLY"
2026-11-14T00:04:40.3088986Z 
2026-11-14T00:04:40.3089091Z     audit_step_seconds = _seconds_between(
2026-11-14T00:04:40.3089376Z         (audit_step or {}).get("started_at"),
2026-11-14T00:04:40.3089661Z         (audit_step or {}).get("completed_at"),
2026-11-14T00:04:40.3089912Z     )
2026-11-14T00:04:40.3090123Z     failed_team_step_seconds = _seconds_between(
2026-11-14T00:04:40.3090496Z         (failed_team_step or {}).get("started_at"),
2026-11-14T00:04:40.3090918Z         (failed_team_step or {}).get("completed_at"),
2026-11-14T00:04:40.3091196Z     )
2026-11-14T00:04:40.3091381Z     if quantum_expired:
2026-11-14T00:04:40.3091683Z         who = ("the independent-audit agent" if failed_team_step is None
2026-11-14T00:04:40.3092063Z                else "the lane-cycle (producer) agent")
2026-11-14T00:04:40.3092388Z         mechanism_status = "OBSERVED_QUANTUM_EXPIRED"
2026-11-14T00:04:40.3092673Z         mechanism_claim = (
2026-11-14T00:04:40.3092980Z             "The agent was stopped by the workflow's own work quantum: the "
2026-11-14T00:04:40.3093332Z             f"public check-run annotation reads "
2026-11-14T00:04:40.3093628Z             f"{annotations.get('quantum_message')!r}"
2026-11-14T00:04:40.3093943Z             + (f" with exit code {annotations.get('exit_code')}"
2026-11-14T00:04:40.3094292Z                if annotations.get("exit_code") is not None else "")
2026-11-14T00:04:40.3094664Z             + f" after {audit_step_seconds or failed_team_step_seconds} s. "
2026-11-14T00:04:40.3094979Z             + (
2026-11-14T00:04:40.3095250Z                 "No gate was written because the quantum ended before the "
2026-11-14T00:04:40.3095575Z                 "agent could write one."
2026-11-14T00:04:40.3095835Z                 if failed_team_step is None
2026-11-14T00:04:40.3096155Z                 else "The producer was stopped before the workflow's state "
2026-11-14T00:04:40.3096536Z                      "validation and write-scope steps could run, so those "
2026-11-14T00:04:40.3096906Z                      "steps report 'skipped'; the always-run persist step "
2026-11-14T00:04:40.3097243Z                      "then published the tree it had."
2026-11-14T00:04:40.3097498Z             )
2026-11-14T00:04:40.3097721Z             + " No provider or auth cause is claimed."
2026-11-14T00:04:40.3097985Z         )
2026-11-14T00:04:40.3098168Z     elif not team_ok:
2026-11-14T00:04:40.3098471Z         # The mechanism block's vocabulary used to be binary: observed quantum
2026-11-14T00:04:40.3098877Z         # expiry, or UNOBSERVED with a claim that "job logs are not
2026-11-14T00:04:40.3099365Z         # downloadable without admin rights".  Producer cycles 40263308953 and
2026-11-14T00:04:40.3099790Z         # 40263483436 falsified the second half: with the producer token the
2026-11-14T00:04:40.3100201Z         # logs endpoint answers HTTP 200 and the cause is readable (model
2026-11-14T00:04:40.3100620Z         # gateway rejected the request parameter ``permissions``).  When the
2026-11-14T00:04:40.3101135Z         # snapshot records that the logs WERE fetched, claiming "not
2026-11-14T00:04:40.3101556Z         # downloadable" would publish a false sentence, and the status says so
2026-11-14T00:04:40.3101979Z         # honestly: the orchestration facts are observed, no quantum expiry
2026-11-14T00:04:40.3102380Z         # occurred, and the log-level cause belongs to the committed
2026-11-14T00:04:40.3102802Z         # lane-cycle log-evidence artifact (product/lane_cycle_log_evidence.py)
2026-11-14T00:04:40.3103175Z         # rather than to this instrument.
2026-11-14T00:04:40.3103495Z         mechanism_status = ("OBSERVED_LOGS_AVAILABLE_NO_QUANTUM"
2026-11-14T00:04:40.3103851Z                             if logs_available else "UNOBSERVED")
2026-11-14T00:04:40.3104145Z         if logs_available:
2026-11-14T00:04:40.3104376Z             mechanism_claim = (
2026-11-14T00:04:40.3104675Z                 "The lane-cycle agent process exited non-zero after "
2026-11-14T00:04:40.3105046Z                 f"{(failed_team_step or {}).get('started_at')} and before "
2026-11-14T00:04:40.3105412Z                 f"{(failed_team_step or {}).get('completed_at')}. The "
2026-11-14T00:04:40.3105780Z                 "workflow's 'Persist team snapshot' step is guarded by "
2026-11-14T00:04:40.3106115Z                 "`if: always()` and concluded "
2026-11-14T00:04:40.3106571Z                 f"{(snapshot_step or {}).get('conclusion')!r}, so the team "
2026-11-14T00:04:40.3106962Z                 "ref can be published with ZERO durable delta. The job logs "
2026-11-14T00:04:40.3107337Z                 "WERE downloadable in the producing cycle (HTTP "
2026-11-14T00:04:40.3107727Z                 f"{snapshot.get('logs_endpoint_status')}) and are committed "
2026-11-14T00:04:40.3108145Z                 "beside this diagnosis, so the log-level cause is observable "
2026-11-14T00:04:40.3108546Z                 "and is classified by the lane-cycle log-evidence artifact "
2026-11-14T00:04:40.3108923Z                 "built with product/lane_cycle_log_evidence.py. This "
2026-11-14T00:04:40.3109294Z                 "instrument reports only the orchestration facts (step "
2026-11-14T00:04:40.3109691Z                 "conclusions, durations) and observed no work-quantum expiry "
2026-11-14T00:04:40.3110083Z                 "(quantum_expired=false); no provider, auth or token cause "
2026-11-14T00:04:40.3110412Z                 "is asserted here."
2026-11-14T00:04:40.3110641Z             )
2026-11-14T00:04:40.3111071Z [0m
2026-11-14T00:04:40.6955543Z [0m$ [0mcd /home/runner/work/LexMachina/LexMachina && sed -n '160,420p' product/resume_snapshot_diagnosis.py
