2026-11-13T03:16:01.9625651Z def _free_port() -> int:
2026-11-13T03:16:01.9626039Z     with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
2026-11-13T03:16:01.9626446Z         sock.bind(("127.0.0.1", 0))
2026-11-13T03:16:01.9626757Z         return int(sock.getsockname()[1])
2026-11-13T03:16:01.9626975Z 
2026-11-13T03:16:01.9626980Z 
2026-11-13T03:16:01.9627139Z def _get(port: int, path: str, timeout: float = 120.0):
2026-11-13T03:16:01.9627545Z     url = f"http://127.0.0.1:{port}{path}"
2026-11-13T03:16:01.9627859Z     try:
2026-11-13T03:16:01.9628186Z         with urllib.request.urlopen(url, timeout=timeout) as resp:
2026-11-13T03:16:01.9628640Z             return resp.status, resp.headers, resp.read()
2026-11-13T03:16:01.9629128Z     except urllib.error.HTTPError as exc:  # pragma: no cover - failure path
2026-11-13T03:16:01.9629603Z         return exc.code, exc.headers, exc.read()
2026-11-13T03:16:01.9629839Z 
2026-11-13T03:16:01.9629844Z 
2026-11-13T03:16:01.9629941Z class _Server:
2026-11-13T03:16:01.9630415Z     """The shipped server, launched exactly as the reports launch it."""
2026-11-13T03:16:01.9630732Z 
2026-11-13T03:16:01.9630845Z     def __init__(self) -> None:
2026-11-13T03:16:01.9631147Z         self.port = _free_port()
2026-11-13T03:16:01.9631489Z         self.proc: subprocess.Popen | None = None
2026-11-13T03:16:01.9631825Z         self.log = ""
2026-11-13T03:16:01.9631975Z 
2026-11-13T03:16:01.9632104Z     def __enter__(self) -> "_Server":
2026-11-13T03:16:01.9632437Z         self.proc = subprocess.Popen(
2026-11-13T03:16:01.9632848Z             [sys.executable, str(SERVER), str(self.port), "--query-mode"],
2026-11-13T03:16:01.9633262Z             cwd=str(ROOT),
2026-11-13T03:16:01.9633554Z             stdout=subprocess.PIPE,
2026-11-13T03:16:01.9633870Z             stderr=subprocess.STDOUT,
2026-11-13T03:16:01.9634354Z             text=True,
2026-11-13T03:16:01.9634602Z         )
2026-11-13T03:16:01.9634850Z         deadline = time.time() + 60
2026-11-13T03:16:01.9635158Z         while time.time() < deadline:
2026-11-13T03:16:01.9635481Z             if self.proc.poll() is not None:
2026-11-13T03:16:01.9635807Z                 raise AssertionError(
2026-11-13T03:16:01.9636203Z                     "the shipped server exited before answering /api/health:\n"
2026-11-13T03:16:01.9636685Z                     + (self.proc.stdout.read() if self.proc.stdout else "")
2026-11-13T03:16:01.9637056Z                 )
2026-11-13T03:16:01.9637278Z             try:
2026-11-13T03:16:01.9637633Z                 status, _headers, body = _get(self.port, "/api/health", timeout=5)
2026-11-13T03:16:01.9638055Z                 if status == 200:
2026-11-13T03:16:01.9638346Z                     return self
2026-11-13T03:16:01.9638627Z             except Exception:
2026-11-13T03:16:01.9638903Z                 time.sleep(0.2)
2026-11-13T03:16:01.9639436Z         raise AssertionError("the shipped server did not answer /api/health in 60s")
2026-11-13T03:16:01.9639786Z 
2026-11-13T03:16:01.9639913Z     def __exit__(self, *_exc) -> None:
2026-11-13T03:16:01.9640229Z         if self.proc is not None:
2026-11-13T03:16:01.9640529Z             self.proc.terminate()
2026-11-13T03:16:01.9640809Z             try:
2026-11-13T03:16:01.9641066Z                 self.proc.wait(timeout=10)
2026-11-13T03:16:01.9641516Z             except subprocess.TimeoutExpired:  # pragma: no cover - failure path
2026-11-13T03:16:01.9641980Z                 self.proc.kill()
2026-11-13T03:16:01.9642351Z         if self.proc is not None and self.proc.stdout is not None:
2026-11-13T03:16:01.9642776Z             self.log = self.proc.stdout.read() or ""
2026-11-13T03:16:01.9643011Z 
2026-11-13T03:16:01.9643015Z 
2026-11-13T03:16:01.9643152Z def _json(path: str, port: int) -> dict:
2026-11-13T03:16:01.9643494Z     status, _headers, body = _get(port, path)
2026-11-13T03:16:01.9643912Z     assert status == 200, f"{path} -> HTTP {status}: {body[:400]!r}"
2026-11-13T03:16:01.9644496Z     return json.loads(body.decode("utf-8"))
