2026-11-13T03:13:35.0266410Z REQUIREMENTS = REPO_ROOT / "product" / "requirements-query.txt"
2026-11-13T03:13:35.0266828Z BOOTSTRAP = REPO_ROOT / "product" / "bootstrap_query_env.sh"
2026-11-13T03:13:35.0267064Z 
2026-11-13T03:13:35.0267240Z #: Modules the query fast path imports, with the module that needs them.
2026-11-13T03:13:35.0267623Z REQUIRED: dict[str, str] = {
2026-11-13T03:13:35.0267930Z     "numpy": "product/query/qmap.py, product/query/relevance.py",
2026-11-13T03:13:35.0268370Z     "sklearn": "product/query/qmap.py (TfidfVectorizer/TruncatedSVD/KMeans)",
2026-11-13T03:13:35.0268721Z }
2026-11-13T03:13:35.0268816Z 
2026-11-13T03:13:35.0268990Z #: import name -> distribution name, for the few pairs that differ.
2026-11-13T03:13:35.0269445Z DISTRIBUTION_NAMES = {"sklearn": "scikit-learn"}
2026-11-13T03:13:35.0269647Z 
2026-11-13T03:13:35.0269858Z #: Versions this lane measured on a real run of the vertical slice. Pins, not
2026-11-13T03:13:35.0270297Z #: floors: the recorded numeric environment travels with every sha.
2026-11-13T03:13:35.0270634Z PINNED: dict[str, str] = {
2026-11-13T03:13:35.0270862Z     "numpy": "2.5.4",
2026-11-13T03:13:35.0271172Z     "scipy": "1.18.1",          # scikit-learn's own dependency, recorded not required
2026-11-13T03:13:35.0271538Z     "sklearn": "1.9.1",
2026-11-13T03:13:35.0271810Z     "pytest": "9.1.1",          # the lane suite, not the fast path
2026-11-13T03:13:35.0272098Z }
2026-11-13T03:13:35.0272191Z 
2026-11-13T03:13:35.0272312Z REMEDY = "bash product/bootstrap_query_env.sh"
2026-11-13T03:13:35.0272502Z 
2026-11-13T03:13:35.0272514Z 
2026-11-13T03:13:35.0272632Z def installed_version(module: str) -> str | None:
2026-11-13T03:13:35.0272913Z     try:
2026-11-13T03:13:35.0273120Z         mod = importlib.import_module(module)
2026-11-13T03:13:35.0273393Z     except Exception:
2026-11-13T03:13:35.0273600Z         return None
2026-11-13T03:13:35.0273849Z     return str(getattr(mod, "__version__", "unknown"))
2026-11-13T03:13:35.0274216Z 
2026-11-13T03:13:35.0274222Z 
2026-11-13T03:13:35.0274350Z def probe() -> dict:
2026-11-13T03:13:35.0274664Z     """Import every required module and report the environment honestly."""
2026-11-13T03:13:35.0275036Z     present: dict[str, str | None] = {}
2026-11-13T03:13:35.0275299Z     missing: list[str] = []
2026-11-13T03:13:35.0275541Z     for module in sorted(REQUIRED):
2026-11-13T03:13:35.0275811Z         version = installed_version(module)
2026-11-13T03:13:35.0276086Z         present[module] = version
2026-11-13T03:13:35.0276340Z         if version is None:
2026-11-13T03:13:35.0276576Z             missing.append(module)
2026-11-13T03:13:35.0276827Z     return {
2026-11-13T03:13:35.0277041Z         "python": sys.version.split()[0],
2026-11-13T03:13:35.0277318Z         "required": dict(REQUIRED),
2026-11-13T03:13:35.0277572Z         "pinned": dict(PINNED),
2026-11-13T03:13:35.0277821Z         "installed": present,
2026-11-13T03:13:35.0278198Z         "installed_matches_pin": {
2026-11-13T03:13:35.0278541Z             m: (present.get(m) == v) for m, v in PINNED.items() if m in present
2026-11-13T03:13:35.0278878Z         },
2026-11-13T03:13:35.0279077Z         "missing": missing,
2026-11-13T03:13:35.0279315Z         "ok": not missing,
2026-11-13T03:13:35.0279571Z         "remedy": REMEDY,
2026-11-13T03:13:35.0279866Z         "requirements_file": "product/requirements-query.txt",
2026-11-13T03:13:35.0280181Z         "workflow_gap": (
2026-11-13T03:13:35.0280467Z             "no step of .github/workflows/core-lane.yml installs "
2026-11-13T03:13:35.0280916Z             "product/requirements-query.txt, so a fresh runner has none of these; "
2026-11-13T03:13:35.0281416Z             "recorded as a control-plane item, never edited from this lane"
2026-11-13T03:13:35.0281748Z         ),
2026-11-13T03:13:35.0281927Z     }
2026-11-13T03:13:35.0282036Z 
2026-11-13T03:13:35.0282040Z 
2026-11-13T03:13:35.0282150Z def requirement_name(module: str) -> str:
2026-11-13T03:13:35.0282537Z     """Import name -> distribution name (``sklearn`` ships as ``scikit-learn``)."""
2026-11-13T03:13:35.0282938Z     return DISTRIBUTION_NAMES.get(module, module)
