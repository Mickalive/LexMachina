2026-11-13T03:16:30.5582425Z #!/usr/bin/env python3
2026-11-13T03:16:30.5582966Z """Audit-ready diagnosis of an operational-resume snapshot.
2026-11-13T03:16:30.5583410Z 
2026-11-13T03:16:30.5583948Z An operational resume starts from a *persisted producer snapshot* after a
2026-11-13T03:16:30.5584912Z failed workflow.  Two independent questions must be answered before the
2026-11-13T03:16:30.5585505Z snapshot can be handed to an auditor:
2026-11-13T03:16:30.5585912Z 
2026-11-13T03:16:30.5586240Z 1. **Why did the run stop before a gate?** - answered from the committed
2026-11-13T03:16:30.5587056Z    public run/jobs snapshot by :mod:`product.audit_step_diagnosis` (no token,
2026-11-13T03:16:30.5587843Z    no job logs, no invented mechanism).
2026-11-13T03:16:30.5588573Z 2. **Does the persisted snapshot carry a durable delta at all?** - answered
2026-11-13T03:16:30.5589472Z    from git refs alone.  A snapshot equal to its predecessor's commit is
2026-11-13T03:16:30.5590320Z    ``ZERO_DURABLE_DELTA``: the workflow's ``if: always()`` persist step
2026-11-13T03:16:30.5591217Z    published the unchanged tree after the failed producer step, so the ref
2026-11-13T03:16:30.5591957Z    exists but proves no work.
2026-11-13T03:16:30.5592273Z 
2026-11-13T03:16:30.5595030Z The module also records, read-only, whether this run has either half of
2026-11-13T03:16:30.5596106Z factory-wide requirement 4 (an independent audit gate and an accept commit),
2026-11-13T03:16:30.5597131Z and whether the producer wrote anything into the auditor namespace.  It never
2026-11-13T03:16:30.5598171Z writes ``results/audit/**``, never mints a gate, and never labels a run
2026-11-13T03:16:30.5598961Z accepted or rejected.
2026-11-13T03:16:30.5599344Z 
2026-11-13T03:16:30.5599870Z Usage
2026-11-13T03:16:30.5600347Z -----
2026-11-13T03:16:30.5600899Z     python3 product/resume_snapshot_diagnosis.py \\
2026-11-13T03:16:30.5601661Z         --run-id 40193974025 --predecessor-run-id 40188639817 \\
2026-11-13T03:16:30.5602579Z         --raw results/product/orchestration/CYCLE_40193974025_team_step_raw.json \\
2026-11-13T03:16:30.5603614Z         --out results/product/orchestration/CYCLE_40193974025_resume_diagnosis.json
2026-11-13T03:16:30.5604468Z 
2026-11-13T03:16:30.5604975Z When no public run/jobs snapshot was captured for the resumed run (for example
2026-11-13T03:16:30.5605988Z an operational resume dispatched straight from a failed run whose logs are not
2026-11-13T03:16:30.5606826Z reachable from the producer environment), omit ``--raw``: the instrument then
2026-11-13T03:16:30.5607416Z records ``RAW_SNAPSHOT_UNAVAILABLE`` / ``mechanism_unobserved`` instead of
2026-11-13T03:16:30.5607975Z inventing a cause, while still proving the durable-delta fact from git refs.
2026-11-13T03:16:30.5608544Z ``--predecessor-ref`` (default ``origin/lab/product``) compares the snapshot
2026-11-13T03:16:30.5609104Z against the accepted head the failed run was dispatched from, which is the
2026-11-13T03:16:30.5609668Z right delta baseline for a resume run: comparing against the previous *team*
2026-11-13T03:16:30.5610229Z ref would count the accepted audit commit as if the failed run had produced it.
2026-11-13T03:16:30.5610594Z 
2026-11-13T03:16:30.5610862Z Refs must already be available locally (the workflow fetches ``main``,
2026-11-13T03:16:30.5611379Z ``lab/<lane>`` and the team ref).  The instrument never fetches, so an
2026-11-13T03:16:30.5611888Z offline reproduction is honest about a missing ref instead of silently
2026-11-13T03:16:30.5612332Z reaching the network.
2026-11-13T03:16:30.5612826Z """
2026-11-13T03:16:30.5613111Z from __future__ import annotations
2026-11-13T03:16:30.5613362Z 
2026-11-13T03:16:30.5613543Z import argparse
2026-11-13T03:16:30.5613837Z import json
2026-11-13T03:16:30.5614499Z import re
2026-11-13T03:16:30.5614982Z import subprocess
2026-11-13T03:16:30.5615334Z import sys
2026-11-13T03:16:30.5615694Z from datetime import datetime, timezone
2026-11-13T03:16:30.5616172Z from pathlib import Path
2026-11-13T03:16:30.5616409Z from typing import Any
2026-11-13T03:16:30.5616541Z 
2026-11-13T03:16:30.5616669Z REPO_ROOT = Path(__file__).resolve().parents[1]
2026-11-13T03:16:30.5616962Z if str(REPO_ROOT) not in sys.path:
2026-11-13T03:16:30.5617222Z     sys.path.insert(0, str(REPO_ROOT))
2026-11-13T03:16:30.5617394Z 
2026-11-13T03:16:30.5617552Z from product import audit_step_diagnosis as asd  # noqa: E402
2026-11-13T03:16:30.5617889Z from product import query_env  # noqa: E402
2026-11-13T03:16:30.5618229Z from product import resume_chain_diagnosis as rcd  # noqa: E402
2026-11-13T03:16:30.5618484Z 
2026-11-13T03:16:30.5618610Z SCHEMA = "product-resume-snapshot-diagnosis/1"
2026-11-13T03:16:30.5618914Z ACCEPTED_REF = "origin/lab/product"
2026-11-13T03:16:30.5619075Z 
2026-11-13T03:16:30.5619086Z 
2026-11-13T03:16:30.5619234Z def _git(*args: str) -> subprocess.CompletedProcess:
2026-11-13T03:16:30.5619594Z     return subprocess.run(["git", *args], cwd=str(REPO_ROOT),
2026-11-13T03:16:30.5619939Z                           capture_output=True, text=True)
2026-11-13T03:16:30.5620142Z 
2026-11-13T03:16:30.5620146Z 
2026-11-13T03:16:30.5620241Z def _rev(ref: str) -> str | None:
2026-11-13T03:16:30.5620527Z     p = _git("rev-parse", "--verify", "--quiet", ref)
2026-11-13T03:16:30.5620820Z     if p.returncode != 0:
2026-11-13T03:16:30.5621040Z         return None
2026-11-13T03:16:30.5621262Z     return p.stdout.strip() or None
2026-11-13T03:16:30.5621420Z 
2026-11-13T03:16:30.5621425Z 
2026-11-13T03:16:30.5621606Z def _delta(snapshot_ref: str, predecessor_ref: str) -> dict[str, Any]:
2026-11-13T03:16:30.5621973Z === tail ===
2026-11-13T03:16:30.5622266Z         delta = _delta(f"origin/cycle/core/product/{run_id}/team", ACCEPTED_REF)
2026-11-13T03:16:30.5622803Z     accept = _accept_commit(run_id)
2026-11-13T03:16:30.5623075Z     audit = _audit_half(run_id)
2026-11-13T03:16:30.5623366Z     accepted = bool(accept.get("accept_commit")) and bool(
2026-11-13T03:16:30.5623689Z         audit.get("gate_verdict") == "PASS"
2026-11-13T03:16:30.5623981Z         and audit.get("safe_to_integrate") is True
2026-11-13T03:16:30.5624623Z     )
2026-11-13T03:16:30.5624936Z     record: dict[str, Any] = {
2026-11-13T03:16:30.5625168Z         "schema": SCHEMA,
2026-11-13T03:16:30.5625496Z         "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
2026-11-13T03:16:30.5625864Z         "run_id": run_id,
2026-11-13T03:16:30.5626105Z         "predecessor_run_id": predecessor_run_id,
2026-11-13T03:16:30.5626472Z         "raw_snapshot": _repo_relative(Path(raw_path)) if raw_path else None,
2026-11-13T03:16:30.5626842Z         "orchestration": orchestration,
2026-11-13T03:16:30.5627101Z         "durable_delta": delta,
2026-11-13T03:16:30.5627336Z         "adjudication": {
2026-11-13T03:16:30.5627557Z             "audit": audit,
2026-11-13T03:16:30.5627784Z             "accept": accept,
2026-11-13T03:16:30.5628019Z             "accepted": accepted,
2026-11-13T03:16:30.5628317Z             "status": "ACCEPTED" if accepted else "UNADJUDICATED",
2026-11-13T03:16:30.5628642Z             "product_defect": False,
2026-11-13T03:16:30.5628892Z             "verdict_written": False,
2026-11-13T03:16:30.5629142Z             "why_not_accepted": (
2026-11-13T03:16:30.5629386Z                 None if accepted else
2026-11-13T03:16:30.5629710Z                 "requirement 4 needs BOTH an independent PASS gate on the "
2026-11-13T03:16:30.5630125Z                 "audit ref AND an accept commit on lab/product; at least one "
2026-11-13T03:16:30.5630474Z                 "half is absent for this run"
2026-11-13T03:16:30.5630848Z             ),
2026-11-13T03:16:30.5631035Z         },
2026-11-13T03:16:30.5631246Z         "audit_namespace": _audit_namespace(),
2026-11-13T03:16:30.5631636Z         "validation_findings": _validation_findings(run_id, predecessor_run_id),
2026-11-13T03:16:30.5632008Z         "claim_ceiling": (
2026-11-13T03:16:30.5632327Z             "This artifact classifies an orchestration outcome and a git-ref "
2026-11-13T03:16:30.5632763Z             "delta. It writes no gate, labels no run accepted or rejected, "
2026-11-13T03:16:30.5633194Z             "asserts no cause the committed run/jobs snapshot cannot show, and "
2026-11-13T03:16:30.5633586Z             "makes no product, legal or serve claim."
2026-11-13T03:16:30.5633853Z         ),
2026-11-13T03:16:30.5634174Z     }
2026-11-13T03:16:30.5634392Z     if raw_path is None:
2026-11-13T03:16:30.5634713Z         # Only the raw-free mode needs to name the delta baseline; preserving
2026-11-13T03:16:30.5635168Z         # the historical raw-mode record byte shape keeps accepted cycle tests
2026-11-13T03:16:30.5635526Z         # reproducible.
2026-11-13T03:16:30.5635821Z         record["predecessor_ref"] = predecessor_ref or ACCEPTED_REF
2026-11-13T03:16:30.5636142Z     return record
2026-11-13T03:16:30.5636258Z 
2026-11-13T03:16:30.5636271Z 
2026-11-13T03:16:30.5636386Z def main(argv: list[str] | None = None) -> int:
2026-11-13T03:16:30.5636717Z     ap = argparse.ArgumentParser(description=__doc__)
2026-11-13T03:16:30.5637041Z     ap.add_argument("--run-id", required=True)
2026-11-13T03:16:30.5637364Z     ap.add_argument("--predecessor-run-id", default="",
2026-11-13T03:16:30.5637796Z                     help="previous cycle's team ref (optional when --predecessor-ref is given)")
2026-11-13T03:16:30.5638421Z     ap.add_argument("--predecessor-ref", default="",
2026-11-13T03:16:30.5639066Z                     help="explicit git ref for the durable-delta baseline (default origin/lab/product)")
2026-11-13T03:16:30.5639703Z     ap.add_argument("--raw", default=None,
2026-11-13T03:16:30.5640274Z                     help="committed run/jobs snapshot for --run-id; omit when unavailable")
2026-11-13T03:16:30.5640854Z     ap.add_argument("--out", required=True)
2026-11-13T03:16:30.5641460Z     args = ap.parse_args(argv)
2026-11-13T03:16:30.5641919Z     if not args.predecessor_run_id and not args.predecessor_ref:
