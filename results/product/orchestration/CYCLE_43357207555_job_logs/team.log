2026-11-13T03:13:35.0224388Z [0m$ [0mcd /home/runner/work/LexMachina/LexMachina && sed -n '1,120p' product/bootstrap_query_env.sh; echo "=== query_env ==="; sed -n '1,120p' product/query_env.py
2026-11-13T03:13:35.0225558Z #!/usr/bin/env bash
2026-11-13T03:13:35.0226044Z # Install the query fast path's third-party runtime, pinned.
2026-11-13T03:13:35.0226534Z #
2026-11-13T03:13:35.0227028Z #   bash product/bootstrap_query_env.sh          # install if missing / mismatched
2026-11-13T03:13:35.0227949Z #   bash product/bootstrap_query_env.sh --check  # report only, never installs
2026-11-13T03:13:35.0228553Z #
2026-11-13T03:13:35.0229022Z # Why this exists: no step of .github/workflows/core-lane.yml installs
2026-11-13T03:13:35.0229903Z # product/requirements-query.txt, so a fresh runner reaches the vertical slice
2026-11-13T03:13:35.0230582Z # with no numpy and no scikit-learn, and product/cycle_verify.py then reports
2026-11-13T03:13:35.0231078Z # ModuleNotFoundError for five checks - a validation failure that has nothing to
2026-11-13T03:13:35.0231566Z # do with the product.  .github/** is control-plane scope and is never edited
2026-11-13T03:13:35.0232027Z # from this lane, so the lane bootstraps itself, reproducibly, in one command.
2026-11-13T03:13:35.0232383Z #
2026-11-13T03:13:35.0232678Z # Free-only: everything here comes from PyPI.  No paid inference, no account.
2026-11-13T03:13:35.0233046Z set -euo pipefail
2026-11-13T03:13:35.0233378Z 
2026-11-13T03:13:35.0233536Z REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
2026-11-13T03:13:35.0233867Z PY="${PYTHON:-python3}"
2026-11-13T03:13:35.0234290Z CHECK_ONLY=0
2026-11-13T03:13:35.0234571Z [[ "${1:-}" == "--check" ]] && CHECK_ONLY=1
2026-11-13T03:13:35.0234762Z 
2026-11-13T03:13:35.0234960Z # The versions this lane measured on a real fresh-network run of the slice, as
2026-11-13T03:13:35.0235378Z # "pip-name==version import-name".  Kept in sync with
2026-11-13T03:13:35.0235872Z # product/query_env.py::PINNED, which is the machine-readable copy the ledger
2026-11-13T03:13:35.0236345Z # checks against (the pip name of scikit-learn is not its import name).
2026-11-13T03:13:35.0236688Z PINNED=(
2026-11-13T03:13:35.0236879Z   "numpy==2.5.4 numpy"
2026-11-13T03:13:35.0237103Z   "scipy==1.18.1 scipy"
2026-11-13T03:13:35.0237335Z   "scikit-learn==1.9.1 sklearn"
2026-11-13T03:13:35.0237583Z   "pytest==9.1.1 pytest"
2026-11-13T03:13:35.0237798Z )
2026-11-13T03:13:35.0237904Z 
2026-11-13T03:13:35.0237988Z status=0
2026-11-13T03:13:35.0238191Z for entry in "${PINNED[@]}"; do
2026-11-13T03:13:35.0238432Z   spec="${entry%% *}"
2026-11-13T03:13:35.0238652Z   module="${entry##* }"
2026-11-13T03:13:35.0239055Z   version="$("$PY" -c "import $module;print(getattr($module,'__version__','unknown'))" 2>/dev/null || true)"
2026-11-13T03:13:35.0239502Z   if [[ -n "$version" ]]; then
2026-11-13T03:13:35.0239755Z     echo "[ok]      $spec (import $module)"
2026-11-13T03:13:35.0240010Z   else
2026-11-13T03:13:35.0240190Z     status=1
2026-11-13T03:13:35.0240396Z     echo "[missing] $spec (import $module)"
2026-11-13T03:13:35.0240643Z   fi
2026-11-13T03:13:35.0240813Z done
2026-11-13T03:13:35.0240914Z 
2026-11-13T03:13:35.0241034Z if [[ "$CHECK_ONLY" == "1" || "$status" == "0" ]]; then
2026-11-13T03:13:35.0241321Z   echo
2026-11-13T03:13:35.0241505Z   if [[ "$status" == "0" ]]; then
2026-11-13T03:13:35.0241764Z     echo "query fast-path runtime: OK"
2026-11-13T03:13:35.0242008Z   else
2026-11-13T03:13:35.0242310Z     echo "query fast-path runtime: INCOMPLETE - run without --check to install"
2026-11-13T03:13:35.0242660Z   fi
2026-11-13T03:13:35.0242831Z   exit "$status"
2026-11-13T03:13:35.0243020Z fi
2026-11-13T03:13:35.0243122Z 
2026-11-13T03:13:35.0243351Z echo
2026-11-13T03:13:35.0243674Z echo "installing pinned query runtime into the current interpreter's user site..."
2026-11-13T03:13:35.0244332Z specs=(); for e in "${PINNED[@]}"; do specs+=("${e%% *}"); done
2026-11-13T03:13:35.0244708Z "$PY" -m pip install --user --quiet "${specs[@]}"
2026-11-13T03:13:35.0244980Z echo
2026-11-13T03:13:35.0245164Z echo "re-checking..."
2026-11-13T03:13:35.0245476Z # Re-check with BASH, not with $PY: this file is a bash script (set -euo
2026-11-13T03:13:35.0245927Z # pipefail at line 15), so handing it to the Python interpreter makes the
2026-11-13T03:13:35.0246383Z # remedy path die with SyntaxError right after a successful install - the
2026-11-13T03:13:35.0246819Z # exact defect the 39128456801 audit (F3) re-measured empirically.
2026-11-13T03:13:35.0247270Z exec bash "${REPO_ROOT}/product/bootstrap_query_env.sh" --check=== query_env ===
2026-11-13T03:13:35.0247735Z """The query fast path's third-party runtime, declared in one place.
2026-11-13T03:13:35.0248000Z 
2026-11-13T03:13:35.0248097Z Why this module exists
2026-11-13T03:13:35.0248319Z ----------------------
2026-11-13T03:13:35.0248647Z ``product/query/qmap.py`` and ``product/query/relevance.py`` import ``numpy``,
2026-11-13T03:13:35.0249118Z and ``qmap.py`` uses ``sklearn`` for TF-IDF/SVD/KMeans.  Those imports are the
2026-11-13T03:13:35.0249535Z vertical slice: without them ``product/offline_slice.py``,
2026-11-13T03:13:35.0249961Z ``product/cycle_verify.py`` (checks ``slice``/``counter``/``relation``/
2026-11-13T03:13:35.0250418Z ``relation_direction``/``tracked``) and the shipped server cannot run at all.
2026-11-13T03:13:35.0250701Z 
2026-11-13T03:13:35.0250881Z None of that used to be written down anywhere, and **no step of
2026-11-13T03:13:35.0251271Z ``.github/workflows/core-lane.yml`` installs them** (only
2026-11-13T03:13:35.0251784Z ``query-map-ci.yml`` and ``product-reality-check.yml`` run
2026-11-13T03:13:35.0252234Z ``pip install -r product/requirements-query.txt``).  So on a fresh runner the
2026-11-13T03:13:35.0252747Z lane's own instrument dies with ``ModuleNotFoundError: No module named 'numpy'``
2026-11-13T03:13:35.0253268Z and the resulting artifact is indistinguishable from a product defect - the
2026-11-13T03:13:35.0253651Z measured instance is recorded in
2026-11-13T03:13:35.0253980Z ``results/product/orchestration/CYCLE_39128456801_dep_class.json``.
2026-11-13T03:13:35.0254459Z 
2026-11-13T03:13:35.0254594Z This module makes the runtime explicit and checkable:
2026-11-13T03:13:35.0254811Z 
2026-11-13T03:13:35.0255004Z * ``REQUIRED`` - the modules the fast path imports, derived from the shipped
2026-11-13T03:13:35.0255408Z   code (``product/query/**`` + ``product/query_app.py`` +
2026-11-13T03:13:35.0255798Z   ``product/offline_slice.py``), not from what happens to be installed;
2026-11-13T03:13:35.0256239Z * ``PINNED`` - the exact versions this lane measured, recorded beside the
2026-11-13T03:13:35.0256673Z   hashes of every reproducibility claim per the standing numeric rule;
2026-11-13T03:13:35.0257132Z * ``probe()`` - a stdlib-only import check that returns what is present, what is
2026-11-13T03:13:35.0257589Z   missing and the single command that fixes it.  ``probe()`` never installs.
2026-11-13T03:13:35.0258035Z * ``ensure()`` - the explicit, opt-in self-heal: probe, and if a *required*
2026-11-13T03:13:35.0258488Z   module is missing run the one-command bootstrap **once per process**, then
2026-11-13T03:13:35.0258942Z   re-probe.  ``product/tests/conftest.py`` calls it so the lane's own suite
2026-11-13T03:13:35.0259392Z   can no longer die on a fresh runner before any product claim is testable -
2026-11-13T03:13:35.0259803Z   the observed instance is ``results/product/orchestration/
2026-11-13T03:13:35.0260226Z   CYCLE_40263666190_lane_cycle_log_evidence.json`` (run 40262401687's agent hit
2026-11-13T03:13:35.0260702Z   the dependency failure and exited 0 with an unchanged tree after ~526 s, so
2026-11-13T03:13:35.0261247Z   the wrapper's delta guard rejected it: ``LEX_ZERO_DELTA_REPAIR``, exit 67,
2026-11-13T03:13:35.0261673Z   ``quantum_expired=false``).  ``ensure()`` is skippable with
2026-11-13T03:13:35.0262071Z   ``LEX_QUERY_ENV_NO_AUTOBOOTSTRAP=1`` for callers that must observe an
2026-11-13T03:13:35.0262430Z   uninstalled environment.
2026-11-13T03:13:35.0262574Z 
2026-11-13T03:13:35.0262776Z Importing this file never installs anything and never imports the heavy stack
2026-11-13T03:13:35.0263255Z at module import time: importing this file must stay free (the fast-path import
2026-11-13T03:13:35.0263711Z budget depends on it).  Installation only happens inside an explicit
2026-11-13T03:13:35.0264180Z ``ensure()`` call.
2026-11-13T03:13:35.0264473Z """
2026-11-13T03:13:35.0264674Z from __future__ import annotations
2026-11-13T03:13:35.0264852Z 
2026-11-13T03:13:35.0264936Z import importlib
