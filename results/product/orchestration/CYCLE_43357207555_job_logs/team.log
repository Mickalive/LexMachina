2026-11-13T03:13:36.7654749Z """Test isolation for the product test suite.
2026-11-13T03:13:36.7655086Z 
2026-11-13T03:13:36.7655230Z Why this file exists
2026-11-13T03:13:36.7655546Z --------------------
2026-11-13T03:13:36.7655925Z Cycle 38726191935 committed five pytest byproducts into
2026-11-13T03:13:36.7656762Z ``results/product/human_gate_sessions_simulated/``. The mechanism was a test
2026-11-13T03:13:36.7657261Z that ran ``human_gate_finalize.py`` without ``--out`` while the CLI's simulated
2026-11-13T03:13:36.7657762Z output directory resolved *inside the repository*; ``core-lane.yml`` then ran
2026-11-13T03:13:36.7658180Z ``git add -A`` and the scratch became a lane result.
2026-11-13T03:13:36.7658395Z 
2026-11-13T03:13:36.7658568Z The output directories are now overridable through the environment
2026-11-13T03:13:36.7659075Z (``LEX_HUMAN_GATE_OUT_DIR`` / ``LEX_HUMAN_GATE_SIMULATED_OUT_DIR``). This module
2026-11-13T03:13:36.7659922Z points them at a temp directory **at import time** — pytest imports conftest
2026-11-13T03:13:36.7660594Z before it imports any test module, so ``human_gate_finalize`` reads the
2026-11-13T03:13:36.7661264Z override while it is being imported, before any test can reach the CLI without
2026-11-13T03:13:36.7661946Z ``--out``. A unit run therefore cannot write into the repository's immutable
2026-11-13T03:13:36.7662649Z ``results/`` tree even if a future test forgets ``--out`` or the override.
2026-11-13T03:13:36.7663100Z 
2026-11-13T03:13:36.7663383Z Tests that want the real repository directories import them explicitly
2026-11-13T03:13:36.7663950Z (``CANONICAL_DIR_DEFAULT`` / ``SIMULATED_DIR_DEFAULT``), and the evidence scanner
2026-11-13T03:13:36.7664605Z always reads the repository paths.
2026-11-13T03:13:36.7664772Z 
2026-11-13T03:13:36.7664870Z Query runtime self-heal
2026-11-13T03:13:36.7665093Z -----------------------
2026-11-13T03:13:36.7665420Z The second job in this file is the pinned *query* runtime.  ``core-lane.yml``
2026-11-13T03:13:36.7665892Z never runs ``product/bootstrap_query_env.sh``, so on a fresh runner the suite
2026-11-13T03:13:36.7666351Z reaches ``product/query/**`` (numpy/sklearn) with nothing installed and dies
2026-11-13T03:13:36.7666837Z with ``ModuleNotFoundError`` before a single product claim is tested - measured
2026-11-13T03:13:36.7667319Z on run 40262401687, whose agent hit that import failure and exited 0 with an
2026-11-13T03:13:36.7667760Z unchanged tree after ~526 s, so the wrapper's delta guard rejected it
2026-11-13T03:13:36.7668417Z (``LEX_ZERO_DELTA_REPAIR``, exit 67; ``quantum_expired=false``; no work-quantum
2026-11-13T03:13:36.7668794Z expiry occurred; evidence:
2026-11-13T03:13:36.7669169Z ``results/product/orchestration/CYCLE_40263666190_lane_cycle_log_evidence.json``).
2026-11-13T03:13:36.7669722Z ``audit_readiness.py`` already bootstraps for the *dossier* invocation, but the
2026-11-13T03:13:36.7670415Z lane wrapper invokes pytest directly, so the harness - not each test - owns the
2026-11-13T03:13:36.7670897Z fix: pytest imports this conftest before any test module, and
2026-11-13T03:13:36.7671545Z ``query_env.ensure()`` runs the documented one-command bootstrap at most once
2026-11-13T03:13:36.7672254Z per process and never raises.  Set ``LEX_QUERY_ENV_NO_AUTOBOOTSTRAP=1`` to
2026-11-13T03:13:36.7672956Z observe an uninstalled environment (the fresh-runner ``-S`` probes do).
2026-11-13T03:13:36.7673496Z """
2026-11-13T03:13:36.7673807Z from __future__ import annotations
2026-11-13T03:13:36.7674188Z 
2026-11-13T03:13:36.7674322Z import atexit
2026-11-13T03:13:36.7674609Z import os
2026-11-13T03:13:36.7674802Z import shutil
2026-11-13T03:13:36.7675075Z import sys
2026-11-13T03:13:36.7675340Z import tempfile
2026-11-13T03:13:36.7675628Z import warnings
2026-11-13T03:13:36.7675953Z from pathlib import Path
2026-11-13T03:13:36.7676189Z 
2026-11-13T03:13:36.7676439Z _TEST_OUT_ROOT = tempfile.mkdtemp(prefix="lex_human_gate_test_out_")
2026-11-13T03:13:36.7677076Z os.environ.setdefault("LEX_HUMAN_GATE_OUT_DIR", str(os.path.join(_TEST_OUT_ROOT, "canonical")))
2026-11-13T03:13:36.7678046Z os.environ.setdefault("LEX_HUMAN_GATE_SIMULATED_OUT_DIR", str(os.path.join(_TEST_OUT_ROOT, "simulated")))
2026-11-13T03:13:36.7678639Z 
2026-11-13T03:13:36.7678971Z # The product modules (query_env, server, ...) live one directory up; the test
2026-11-13T03:13:36.7679919Z # modules insert that path themselves at *their* import time, which is after
2026-11-13T03:13:36.7680520Z # this file runs, so the bootstrap needs it earlier.
2026-11-13T03:13:36.7681090Z _PRODUCT_DIR = str(Path(__file__).resolve().parents[1])
2026-11-13T03:13:36.7681591Z if _PRODUCT_DIR not in sys.path:
2026-11-13T03:13:36.7681968Z     sys.path.insert(0, _PRODUCT_DIR)
2026-11-13T03:13:36.7682248Z 
2026-11-13T03:13:36.7682357Z try:
2026-11-13T03:13:36.7682589Z     import query_env  # noqa: E402
2026-11-13T03:13:36.7682912Z except ImportError:  # pragma: no cover - product tree relocated
2026-11-13T03:13:36.7683279Z     query_env = None  # type: ignore[assignment]
2026-11-13T03:13:36.7683477Z 
2026-11-13T03:13:36.7683566Z if query_env is not None:
2026-11-13T03:13:36.7683799Z     _runtime = query_env.ensure()
2026-11-13T03:13:36.7684244Z     if not _runtime["ok"]:
2026-11-13T03:13:36.7684478Z         warnings.warn(
2026-11-13T03:13:36.7684756Z             "query fast-path runtime incomplete after ensure(): "
2026-11-13T03:13:36.7685381Z             f"missing={_runtime['missing']} remedy={_runtime['remedy']} "
2026-11-13T03:13:36.7685893Z             f"ensure={_runtime['ensured']}",
2026-11-13T03:13:36.7686306Z             RuntimeWarning,
2026-11-13T03:13:36.7686646Z             stacklevel=1,
2026-11-13T03:13:36.7686967Z         )
2026-11-13T03:13:36.7687131Z 
2026-11-13T03:13:36.7687137Z 
2026-11-13T03:13:36.7687267Z @atexit.register
2026-11-13T03:13:36.7687719Z def _cleanup() -> None:  # pragma: no cover - process teardown
