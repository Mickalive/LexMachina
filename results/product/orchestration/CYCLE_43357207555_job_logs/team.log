2026-11-13T03:13:25.3948818Z def test_resumed_snapshot_is_zero_delta_unobserved_and_unadjudicated():
2026-11-13T03:13:25.3949173Z     diag = _load(DIAG)
2026-11-13T03:13:25.3949418Z     assert diag["run_id"] == RESUMED_RUN_ID
2026-11-13T03:13:25.3949752Z     assert diag["predecessor_run_id"] == PREDECESSOR_RUN_ID
2026-11-13T03:13:25.3950157Z     # RAW_SNAPSHOT_UNAVAILABLE: no run/jobs snapshot was reachable, so no
2026-11-13T03:13:25.3950562Z     # provider/auth/quantum cause may be invented.
2026-11-13T03:13:25.3950856Z     orch = diag["orchestration"]
2026-11-13T03:13:25.3951169Z     assert orch["classification"] == "RAW_SNAPSHOT_UNAVAILABLE"
2026-11-13T03:13:25.3951516Z     assert orch["mechanism_unobserved"] is True
2026-11-13T03:13:25.3951800Z     assert "mechanism" not in orch
2026-11-13T03:13:25.3952125Z     # The ref exists but is byte-identical to the prior producer commit.
2026-11-13T03:13:25.3952475Z     delta = diag["durable_delta"]
2026-11-13T03:13:25.3952770Z     assert delta["classification"] == "ZERO_DURABLE_DELTA"
2026-11-13T03:13:25.3953081Z     assert delta["changed_files"] == 0
2026-11-13T03:13:25.3953372Z     assert delta["snapshot_head"] == SNAPSHOT_HEAD
2026-11-13T03:13:25.3953700Z     assert delta["predecessor_head"] == SNAPSHOT_HEAD
2026-11-13T03:13:25.3954148Z     # No independent gate and no accept commit for this run.
2026-11-13T03:13:25.3954514Z     assert diag["adjudication"]["status"] == "UNADJUDICATED"
2026-11-13T03:13:25.3954853Z     assert diag["adjudication"]["accepted"] is False
2026-11-13T03:13:25.3955058Z 
