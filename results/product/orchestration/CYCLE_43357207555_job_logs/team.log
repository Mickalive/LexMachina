2026-11-13T03:18:09.0890315Z # Active profile; empty means "the module constants above" (the original
2026-11-13T03:18:09.0891004Z # pinned run).  Set by run()/select_profile() only.
2026-11-13T03:18:09.0891508Z PROFILE: dict[str, Any] = {}
2026-11-13T03:18:09.0891765Z 
2026-11-13T03:18:09.0891773Z 
2026-11-13T03:18:09.0891985Z def select_profile(run_id: str) -> dict[str, Any]:
2026-11-13T03:18:09.0892647Z     """Resolve the dossier profile for ``run_id`` (aliases are followed).
2026-11-13T03:18:09.0893156Z 
2026-11-13T03:18:09.0893493Z     A dossier for the wrong run is worse than no dossier: it would re-derive
2026-11-13T03:18:09.0894618Z     another run's claims and label them with this run's id.  Unknown run ids
2026-11-13T03:18:09.0895400Z     therefore fail closed instead of silently inheriting the default profile.
2026-11-13T03:18:09.0895982Z     """
2026-11-13T03:18:09.0896263Z     key = str(run_id)
2026-11-13T03:18:09.0896620Z     prof = PROFILES.get(key)
2026-11-13T03:18:09.0897093Z     while isinstance(prof, dict) and "alias_of" in prof:
2026-11-13T03:18:09.0897643Z         prof = PROFILES.get(str(prof["alias_of"]))
2026-11-13T03:18:09.0898118Z     if prof is None:
2026-11-13T03:18:09.0898472Z         raise SystemExit(
2026-11-13T03:18:09.0899011Z             f"no audit-readiness profile for run {key}; refusing to fall back "
2026-11-13T03:18:09.0899811Z             f"to {DEFAULT_PROFILE_KEY} and publish another run's claims")
2026-11-13T03:18:09.0900378Z     return dict(prof)
2026-11-13T03:18:09.0900597Z 
2026-11-13T03:18:09.0900604Z 
2026-11-13T03:18:09.0900796Z def p(field: str, default: Any = None) -> Any:
2026-11-13T03:18:09.0901417Z     """Profile field with a fallback to the pinned module constants."""
2026-11-13T03:18:09.0902199Z     if field in PROFILE:
2026-11-13T03:18:09.0902577Z         return PROFILE[field]
2026-11-13T03:18:09.0902963Z     return default
2026-11-13T03:18:09.0903162Z 
