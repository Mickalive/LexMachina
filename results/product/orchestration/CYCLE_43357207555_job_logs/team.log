2026-11-13T03:13:25.3965758Z def test_offline_slice_still_delivers_sourced_clickable_map():
2026-11-13T03:13:25.3966157Z     from offline_slice import _geometry, build_bundle  # noqa: E402
2026-11-13T03:13:25.3966407Z 
2026-11-13T03:13:25.3966556Z     bundle = build_bundle("rent-default", 100, enrich=True)
2026-11-13T03:13:25.3966871Z     rows = bundle["decisions"]
2026-11-13T03:13:25.3967110Z     assert len(rows) == 100
2026-11-13T03:13:25.3967436Z     assert all(r.get("x") is not None and r.get("y") is not None for r in rows)
2026-11-13T03:13:25.3967841Z     assert all(r.get("cluster_id") is not None for r in rows)
2026-11-13T03:13:25.3968183Z     assert all(r.get("canonical_url") for r in rows)
2026-11-13T03:13:25.3968519Z     assert len({r.get("cluster_id") for r in rows}) >= 2
2026-11-13T03:13:25.3968827Z     answer = bundle.get("answer") or {}
2026-11-13T03:13:25.3969105Z     assert answer.get("status") == "ready"
2026-11-13T03:13:25.3969380Z     assert answer.get("cited_decision_ids")
2026-11-13T03:13:25.3969761Z     assert bundle["provenance"]["offline_slice"]["geometry_preserved"] is True
2026-11-13T03:13:25.3970205Z     assert bundle["provenance"]["offline_slice"]["network"] == "none"
2026-11-13T03:13:25.3970636Z     # A rendered point is query-conditioned: coordinates must be finite.
2026-11-13T03:13:25.3970985Z     geo = _geometry(bundle)
2026-11-13T03:13:25.3971220Z     assert len(geo) == 100
2026-11-13T03:13:25.3971365Z 
