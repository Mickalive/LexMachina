2026-11-13T03:18:09.0904827Z                   p("current_report", CURRENT_REPORT)):
2026-11-13T03:18:09.0905314Z         if value is not None:
2026-11-13T03:18:09.0905714Z             out.append(Path(value))
2026-11-13T03:18:09.0906119Z     return out
