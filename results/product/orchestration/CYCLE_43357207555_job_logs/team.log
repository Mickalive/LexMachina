2026-11-13T03:15:33.4245786Z 
2026-11-13T03:15:33.4245884Z def run_status(run_id: str) -> dict:
2026-11-13T03:15:33.4246234Z     """Compact, pollable progress for one run (never the full bundle)."""
2026-11-13T03:15:33.4246598Z     record = _get(run_id)
2026-11-13T03:15:33.4246822Z     if record is None:
2026-11-13T03:15:33.4247115Z         return {"error": "unknown or expired run_id", "run_id": run_id}
2026-11-13T03:15:33.4247455Z     bundle = record.get("bundle") or {}
2026-11-13T03:15:33.4247728Z     prov = bundle.get("provenance", {})
2026-11-13T03:15:33.4247973Z     jobs = {}
2026-11-13T03:15:33.4248211Z     for name, job in (record.get("jobs") or {}).items():
2026-11-13T03:15:33.4248503Z         elapsed = None
2026-11-13T03:15:33.4248722Z         if job.get("started_at"):
2026-11-13T03:15:33.4249057Z             elapsed = round((job.get("ended_at") or _now()) - job["started_at"], 1)
2026-11-13T03:15:33.4249419Z         jobs[name] = {
2026-11-13T03:15:33.4249647Z             "status": job.get("status"),
2026-11-13T03:15:33.4249910Z             "elapsed_s": elapsed,
2026-11-13T03:15:33.4250153Z             "error": job.get("error"),
2026-11-13T03:15:33.4250420Z             "detail": job.get("detail") or {},
2026-11-13T03:15:33.4250678Z         }
2026-11-13T03:15:33.4250858Z     return {
2026-11-13T03:15:33.4251051Z         "run_id": run_id,
2026-11-13T03:15:33.4251278Z         "query": record.get("query"),
2026-11-13T03:15:33.4251530Z         "mode": record.get("mode"),
2026-11-13T03:15:33.4251833Z         "age_s": round(_now() - record.get("created_at", _now()), 1),
2026-11-13T03:15:33.4252170Z         "phase": prov.get("phase"),
2026-11-13T03:15:33.4252443Z         "progressive": prov.get("progressive", {}),
2026-11-13T03:15:33.4252717Z         "answer": {
2026-11-13T03:15:33.4252965Z             "status": (bundle.get("answer") or {}).get("status"),
2026-11-13T03:15:33.4253310Z             "method": (bundle.get("answer") or {}).get("method"),
2026-11-13T03:15:33.4253646Z             "model": (bundle.get("answer") or {}).get("model"),
2026-11-13T03:15:33.4254223Z             "cited": len((bundle.get("answer") or {}).get("cited_decision_ids") or []),
2026-11-13T03:15:33.4254686Z         },
2026-11-13T03:15:33.4254878Z         "counts": {
2026-11-13T03:15:33.4255196Z             "decisions": len(bundle.get("decisions") or []),
2026-11-13T03:15:33.4255525Z             "clusters": len(bundle.get("clusters") or []),
2026-11-13T03:15:33.4255889Z             # RF1. `counter` counted every row whose counter_status was not
2026-11-13T03:15:33.4256300Z             # "none", which included every decision the answer cited; the demo
2026-11-13T03:15:33.4256725Z             # bundle reported 5 where 1 row is a real counter authority. The
2026-11-13T03:15:33.4257155Z             # honest name is kept as an explicit, clearly-labelled alias so no
2026-11-13T03:15:33.4257560Z             # consumer silently keeps reading the inflated number as
2026-11-13T03:15:33.4257957Z             # "counter authorities" - it is a breaking change on purpose.
2026-11-13T03:15:33.4258413Z             "counter_authorities": counter_authority_count(bundle.get("decisions") or []),
2026-11-13T03:15:33.4258869Z             "counter_status_bearing_rows": counter_status_bearing_count(
2026-11-13T03:15:33.4259216Z                 bundle.get("decisions") or []),
2026-11-13T03:15:33.4259475Z         },
2026-11-13T03:15:33.4259678Z         "timing": prov.get("timing", {}),
2026-11-13T03:15:33.4259940Z         "jobs": jobs,
2026-11-13T03:15:33.4260142Z     }
