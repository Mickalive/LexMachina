2026-11-13T03:15:33.4243705Z         "counter_authorities": counter_authority_count(final.get("decisions") or []),
2026-11-13T03:15:33.4244390Z         "counter_status_bearing_rows": counter_status_bearing_count(
2026-11-13T03:15:33.4244735Z             final.get("decisions") or []),
2026-11-13T03:15:33.4245132Z         "enrich_total_s": final.get("provenance", {}).get("timing", {}).get("enrich_total_s"),
2026-11-13T03:15:33.4245669Z     })
