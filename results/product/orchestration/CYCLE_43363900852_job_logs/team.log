2026-11-13T04:15:16.8779418Z from pathlib import Path
2026-11-13T04:15:16.8779817Z from typing import Any
2026-11-13T04:15:16.8780050Z 
2026-11-13T04:15:16.8780233Z ROOT = Path(__file__).resolve().parents[1]
2026-11-13T04:15:16.8780716Z SCHEMA = "product-audit-readiness/1"
2026-11-13T04:15:16.8781196Z DIRECTION_VERSION = 68
2026-11-13T04:15:16.8781575Z if str(ROOT) not in sys.path:
2026-11-13T04:15:16.8782003Z     sys.path.insert(0, str(ROOT))
2026-11-13T04:15:16.8782482Z from product import query_env  # noqa: E402
2026-11-13T04:15:16.8783168Z from product.state_contract import accepted_pointer_evidence  # noqa: E402
2026-11-13T04:15:16.8783699Z 
2026-11-13T04:15:16.8783947Z ORCH = ROOT / "results" / "product" / "orchestration"
2026-11-13T04:15:16.8784655Z CONTENT_FAMILY = (ROOT / "results" / "product" / "counter_content_family"
