2026-11-13T04:17:38.4261663Z                     "accept_subject": subject.strip()}
2026-11-13T04:17:38.4262022Z     return {"accepted_ref_present": True, "accept_commit": None}
2026-11-13T04:17:38.4262281Z 
2026-11-13T04:17:38.4262284Z 
2026-11-13T04:17:38.4262404Z def _audit_half(run_id: str) -> dict[str, Any]:
2026-11-13T04:17:38.4262763Z     audit_ref = f"origin/cycle/core/product/{run_id}/audit"
2026-11-13T04:17:38.4263094Z     audit_head = _rev(audit_ref)
2026-11-13T04:17:38.4263405Z     gate_rel = f"results/audit/product/CYCLE_{run_id}_GATE.json"
2026-11-13T04:17:38.4263740Z     if audit_head is None:
2026-11-13T04:17:38.4263963Z         return {
2026-11-13T04:17:38.4264174Z             "audit_ref": audit_ref,
2026-11-13T04:17:38.4264433Z             "audit_ref_present": False,
2026-11-13T04:17:38.4264747Z             "gate_file_present": (REPO_ROOT / gate_rel).exists(),
2026-11-13T04:17:38.4265074Z             "gate_verdict": None,
2026-11-13T04:17:38.4265307Z         }
2026-11-13T04:17:38.4265531Z     raw = _git("show", f"{audit_ref}:{gate_rel}")
2026-11-13T04:17:38.4265812Z     gate = None
2026-11-13T04:17:38.4266016Z     if raw.returncode == 0:
2026-11-13T04:17:38.4266244Z         try:
2026-11-13T04:17:38.4266580Z             gate = json.loads(raw.stdout)
2026-11-13T04:17:38.4267069Z         except json.JSONDecodeError:
2026-11-13T04:17:38.4267478Z             gate = {"unparseable": True}
2026-11-13T04:17:38.4267741Z     return {
2026-11-13T04:17:38.4267936Z         "audit_ref": audit_ref,
2026-11-13T04:17:38.4268202Z         "audit_ref_present": True,
2026-11-13T04:17:38.4268457Z         "audit_head": audit_head,
2026-11-13T04:17:38.4268726Z         "gate_file_present": gate is not None,
2026-11-13T04:17:38.4269025Z         "gate_verdict": (gate or {}).get("gate"),
2026-11-13T04:17:38.4269363Z         "safe_to_integrate": (gate or {}).get("safe_to_integrate"),
2026-11-13T04:17:38.4269741Z         "required_fixes": (gate or {}).get("required_fixes"),
2026-11-13T04:17:38.4270041Z     }
2026-11-13T04:17:38.4270146Z 
2026-11-13T04:17:38.4270150Z 
2026-11-13T04:17:38.4270258Z def _audit_namespace() -> dict[str, Any]:
2026-11-13T04:17:38.4270518Z     try:
2026-11-13T04:17:38.4270722Z         inv = rcd.audit_namespace_inventory()
2026-11-13T04:17:38.4271099Z     except Exception as exc:  # noqa: BLE001 - recorded, never invented
2026-11-13T04:17:38.4271502Z         return {"error": f"{type(exc).__name__}: {exc}"}
2026-11-13T04:17:38.4271786Z     return {
