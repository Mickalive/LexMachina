2026-11-13T04:17:58.6733518Z def classify(snapshot: dict) -> dict:
2026-11-13T04:17:58.6734120Z     """Pure classification of a committed run/jobs snapshot."""
2026-11-13T04:17:58.6734721Z     run = snapshot.get("run") or {}
2026-11-13T04:17:58.6735072Z     jobs = {j.get("name"): j for j in snapshot.get("jobs") or []}
2026-11-13T04:17:58.6735431Z     team = jobs.get(TEAM_JOB) or {}
2026-11-13T04:17:58.6735695Z     audit = jobs.get(AUDIT_JOB) or {}
2026-11-13T04:17:58.6735972Z     audit_step = _step(audit, AUDIT_STEP)
2026-11-13T04:17:58.6736314Z     gate_step = _step(audit, "Enforce audit scope and read gate")
2026-11-13T04:17:58.6736709Z     persist_step = _step(audit, "Persist audit snapshot")
2026-11-13T04:17:58.6737331Z     validate_step = _step(team, "Validate active MVP producer state")
2026-11-13T04:17:58.6737731Z     scope_step = _step(team, "Enforce lane write scope")
2026-11-13T04:17:58.6738076Z     snapshot_step = _step(team, "Persist team snapshot")
2026-11-13T04:17:58.6738406Z     integrate = jobs.get("integrate") or {}
2026-11-13T04:17:58.6738599Z 
2026-11-13T04:17:58.6738722Z     team_ok = team.get("conclusion") == "success"
2026-11-13T04:17:58.6739061Z     audit_failed = audit.get("conclusion") == "failure"
2026-11-13T04:17:58.6739491Z     audit_step_failed = bool(audit_step and audit_step.get("conclusion") == "failure")
2026-11-13T04:17:58.6740021Z     gate_skipped = bool(gate_step and gate_step.get("conclusion") == "skipped")
2026-11-13T04:17:58.6740519Z     # The workflow guards "Persist team snapshot" with `if: always()`, so the
2026-11-13T04:17:58.6741012Z     # step conclusion is the FACT about the snapshot, independent of whether
2026-11-13T04:17:58.6741509Z     # the team job succeeded.  Reporting it as `team_ok and persist_ok` hides
2026-11-13T04:17:58.6742153Z     # the always-publish behaviour that lets a failed producer's (empty) tree
2026-11-13T04:17:58.6742545Z     # reach the team ref anyway.
2026-11-13T04:17:58.6742805Z     team_snapshot_persisted = bool(
2026-11-13T04:17:58.6743149Z         snapshot_step and snapshot_step.get("conclusion") == "success"
2026-11-13T04:17:58.6743538Z     )
2026-11-13T04:17:58.6743871Z     failed_team_step = next(
2026-11-13T04:17:58.6744247Z         (s for s in team.get("steps") or [] if s.get("conclusion") == "failure"),
2026-11-13T04:17:58.6744612Z         None,
2026-11-13T04:17:58.6744796Z     )
2026-11-13T04:17:58.6745279Z     audit_skipped = audit.get("conclusion") == "skipped"
2026-11-13T04:17:58.6745674Z     annotations = _failure_annotations(
2026-11-13T04:17:58.6746022Z         snapshot, team, audit, audit_step_failed, failed_team_step
2026-11-13T04:17:58.6746351Z     )
2026-11-13T04:17:58.6746591Z     quantum_seconds = annotations.get("quantum_seconds")
2026-11-13T04:17:58.6747243Z     quantum_expired = bool(annotations.get("quantum_expired"))
2026-11-13T04:17:58.6747992Z     # HTTP 200 on the run-jobs logs endpoint means the producing cycle (or a
2026-11-13T04:17:58.6748534Z     # later resume holding the producer token) actually downloaded the job
2026-11-13T04:17:58.6749015Z     # logs; "not downloadable" is then a false sentence, see the branch below.
2026-11-13T04:17:58.6749478Z     logs_available = bool(snapshot.get("logs_endpoint_status") == 200)
2026-11-13T04:17:58.6749760Z 
2026-11-13T04:17:58.6749904Z     if not team_ok and failed_team_step and audit_skipped:
2026-11-13T04:17:58.6750271Z         if failed_team_step.get("name") == "Run lane cycle":
2026-11-13T04:17:58.6750654Z             classification = "TEAM_JOB_LANE_CYCLE_STEP_FAILED_NO_GATE"
2026-11-13T04:17:58.6750979Z         else:
2026-11-13T04:17:58.6751368Z             classification = "TEAM_JOB_FAILED_OTHER_STEP"
2026-11-13T04:17:58.6751777Z     elif team_ok and audit_failed and audit_step_failed and gate_skipped:
2026-11-13T04:17:58.6752238Z         classification = "AUDIT_JOB_INDEPENDENT_AUDIT_STEP_FAILED_NO_GATE"
2026-11-13T04:17:58.6752613Z     elif team_ok and audit_failed:
2026-11-13T04:17:58.6752911Z         classification = "AUDIT_JOB_FAILED_OTHER_STEP"
2026-11-13T04:17:58.6753266Z     elif team_ok and audit.get("conclusion") == "success":
2026-11-13T04:17:58.6753602Z         classification = "AUDIT_JOB_COMPLETED"
2026-11-13T04:17:58.6753875Z     else:
2026-11-13T04:17:58.6754136Z         classification = "TEAM_JOB_DID_NOT_COMPLETE_SUCCESSFULLY"
2026-11-13T04:17:58.6754385Z 
2026-11-13T04:17:58.6754497Z     audit_step_seconds = _seconds_between(
2026-11-13T04:17:58.6754784Z         (audit_step or {}).get("started_at"),
2026-11-13T04:17:58.6755079Z         (audit_step or {}).get("completed_at"),
2026-11-13T04:17:58.6755347Z     )
2026-11-13T04:17:58.6755564Z     failed_team_step_seconds = _seconds_between(
2026-11-13T04:17:58.6755930Z         (failed_team_step or {}).get("started_at"),
2026-11-13T04:17:58.6756249Z         (failed_team_step or {}).get("completed_at"),
2026-11-13T04:17:58.6756531Z     )
2026-11-13T04:17:58.6756717Z     if quantum_expired:
2026-11-13T04:17:58.6757271Z         who = ("the independent-audit agent" if failed_team_step is None
2026-11-13T04:17:58.6757665Z                else "the lane-cycle (producer) agent")
2026-11-13T04:17:58.6757993Z         mechanism_status = "OBSERVED_QUANTUM_EXPIRED"
2026-11-13T04:17:58.6758290Z         mechanism_claim = (
2026-11-13T04:17:58.6758607Z             "The agent was stopped by the workflow's own work quantum: the "
2026-11-13T04:17:58.6759001Z             f"public check-run annotation reads "
2026-11-13T04:17:58.6759339Z             f"{annotations.get('quantum_message')!r}"
2026-11-13T04:17:58.6759682Z             + (f" with exit code {annotations.get('exit_code')}"
2026-11-13T04:17:58.6760069Z                if annotations.get("exit_code") is not None else "")
2026-11-13T04:17:58.6760473Z             + f" after {audit_step_seconds or failed_team_step_seconds} s. "
2026-11-13T04:17:58.6760812Z             + (
2026-11-13T04:17:58.6761078Z                 "No gate was written because the quantum ended before the "
2026-11-13T04:17:58.6761436Z                 "agent could write one."
2026-11-13T04:17:58.6761704Z                 if failed_team_step is None
2026-11-13T04:17:58.6762046Z                 else "The producer was stopped before the workflow's state "
2026-11-13T04:17:58.6762461Z                      "validation and write-scope steps could run, so those "
2026-11-13T04:17:58.6762865Z                      "steps report 'skipped'; the always-run persist step "
2026-11-13T04:17:58.6763359Z                      "then published the tree it had."
2026-11-13T04:17:58.6763648Z             )
2026-11-13T04:17:58.6763869Z             + " No provider or auth cause is claimed."
2026-11-13T04:17:58.6764145Z         )
2026-11-13T04:17:58.6764333Z     elif not team_ok:
2026-11-13T04:17:58.6764658Z         # The mechanism block's vocabulary used to be binary: observed quantum
2026-11-13T04:17:58.6765103Z         # expiry, or UNOBSERVED with a claim that "job logs are not
2026-11-13T04:17:58.6765674Z         # downloadable without admin rights".  Producer cycles 40263308953 and
2026-11-13T04:17:58.6766413Z         # 40263483436 falsified the second half: with the producer token the
2026-11-13T04:17:58.6767286Z         # logs endpoint answers HTTP 200 and the cause is readable (model
2026-11-13T04:17:58.6767933Z         # gateway rejected the request parameter ``permissions``).  When the
2026-11-13T04:17:58.6768569Z         # snapshot records that the logs WERE fetched, claiming "not
2026-11-13T04:17:58.6769070Z         # downloadable" would publish a false sentence, and the status says so
2026-11-13T04:17:58.6769747Z         # honestly: the orchestration facts are observed, no quantum expiry
2026-11-13T04:17:58.6770484Z         # occurred, and the log-level cause belongs to the committed
2026-11-13T04:17:58.6770946Z         # lane-cycle log-evidence artifact (product/lane_cycle_log_evidence.py)
2026-11-13T04:17:58.6771347Z         # rather than to this instrument.
2026-11-13T04:17:58.6771800Z         mechanism_status = ("OBSERVED_LOGS_AVAILABLE_NO_QUANTUM"
2026-11-13T04:17:58.6772328Z                             if logs_available else "UNOBSERVED")
2026-11-13T04:17:58.6772644Z         if logs_available:
2026-11-13T04:17:58.6772881Z             mechanism_claim = (
2026-11-13T04:17:58.6773180Z                 "The lane-cycle agent process exited non-zero after "
2026-11-13T04:17:58.6773588Z                 f"{(failed_team_step or {}).get('started_at')} and before "
2026-11-13T04:17:58.6773996Z                 f"{(failed_team_step or {}).get('completed_at')}. The "
2026-11-13T04:17:58.6774395Z                 "workflow's 'Persist team snapshot' step is guarded by "
2026-11-13T04:17:58.6774749Z                 "`if: always()` and concluded "
2026-11-13T04:17:58.6775108Z                 f"{(snapshot_step or {}).get('conclusion')!r}, so the team "
