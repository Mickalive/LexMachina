2026-11-13T04:17:38.4276114Z def _fresh_runner_probe() -> dict[str, Any]:
2026-11-13T04:17:38.4276487Z     """Probe the query runtime with ``-S`` to reproduce a fresh runner.
2026-11-13T04:17:38.4276758Z 
2026-11-13T04:17:38.4277208Z     The core-lane team job installs nothing, so a fresh runner has neither
2026-11-13T04:17:38.4277702Z     numpy nor scikit-learn.  ``python -S`` skips the user site where the
2026-11-13T04:17:38.4278202Z     bootstrap installs them, which makes that validation gap reproducible
2026-11-13T04:17:38.4278598Z     without touching the current environment.
2026-11-13T04:17:38.4278871Z     """
2026-11-13T04:17:38.4279044Z     code = (
2026-11-13T04:17:38.4279237Z         "import json,sys;"
2026-11-13T04:17:38.4279480Z         "sys.path.insert(0, '.');"
2026-11-13T04:17:38.4279744Z         "from product import query_env;"
2026-11-13T04:17:38.4280030Z         "print(json.dumps(query_env.probe()))"
2026-11-13T04:17:38.4280304Z     )
2026-11-13T04:17:38.4280473Z     try:
2026-11-13T04:17:38.4280665Z         proc = subprocess.run(
2026-11-13T04:17:38.4280964Z             [sys.executable, "-S", "-c", code], cwd=str(REPO_ROOT),
2026-11-13T04:17:38.4281365Z             capture_output=True, text=True, timeout=60, check=False,
2026-11-13T04:17:38.4281691Z         )
2026-11-13T04:17:38.4281994Z     except (OSError, subprocess.SubprocessError) as exc:  # pragma: no cover
2026-11-13T04:17:38.4282442Z         return {"ok": None, "error": f"{type(exc).__name__}: {exc}"}
2026-11-13T04:17:38.4282766Z     probe: dict[str, Any] = {}
2026-11-13T04:17:38.4283008Z     if proc.stdout.strip():
2026-11-13T04:17:38.4283239Z         try:
2026-11-13T04:17:38.4283449Z             probe = json.loads(proc.stdout)
2026-11-13T04:17:38.4283865Z         except json.JSONDecodeError:
2026-11-13T04:17:38.4284123Z             probe = {}
2026-11-13T04:17:38.4284328Z     return {
2026-11-13T04:17:38.4284522Z         "ok": probe.get("ok"),
2026-11-13T04:17:38.4284768Z         "missing": probe.get("missing"),
2026-11-13T04:17:38.4285049Z         "exit_code": proc.returncode,
2026-11-13T04:17:38.4285380Z         "stderr_tail": (proc.stderr or "").strip().splitlines()[-3:],
2026-11-13T04:17:38.4285719Z         "meaning": (
2026-11-13T04:17:38.4286018Z             "python -S skips the user site used by bootstrap_query_env.sh; "
2026-11-13T04:17:38.4286473Z             "missing modules here are the fresh-runner validation gap, not a "
2026-11-13T04:17:38.4286839Z             "product defect"
2026-11-13T04:17:38.4287318Z         ),
2026-11-13T04:17:38.4287503Z     }
2026-11-13T04:17:38.4287603Z 
2026-11-13T04:17:38.4287607Z 
2026-11-13T04:17:38.4287836Z def _validation_findings(run_id: str, predecessor_run_id: str) -> dict[str, Any]:
2026-11-13T04:17:38.4288353Z     """Reproduce the validation gaps that can stop a snapshot before its gate.
2026-11-13T04:17:38.4288650Z 
2026-11-13T04:17:38.4288838Z     This is deliberately narrow and offline.  It does not infer a provider
2026-11-13T04:17:38.4289443Z     mechanism; it records three checkable things a resume must repair:
2026-11-13T04:17:38.4289725Z 
2026-11-13T04:17:38.4289943Z     * a ``product/tests/test_cycle_*.py`` path the snapshot's own report claims
2026-11-13T04:17:38.4290341Z       but the snapshot did not commit;
2026-11-13T04:17:38.4290724Z     * an audit-readiness dossier produced with its mandatory re-runs skipped;
2026-11-13T04:17:38.4291202Z     * the pinned query runtime's presence on the machine that consumes the
2026-11-13T04:17:38.4291665Z       snapshot (the core-lane team job installs nothing, so a fresh runner
2026-11-13T04:17:38.4292136Z       fails with ModuleNotFoundError before any product claim can be tested).
2026-11-13T04:17:38.4292500Z     """
2026-11-13T04:17:38.4292683Z     candidates = [
2026-11-13T04:17:38.4292956Z         REPO_ROOT / "reports" / "product" / f"CYCLE_{run_id}.md",
2026-11-13T04:17:38.4293384Z         REPO_ROOT / "reports" / "product" / f"CYCLE_{predecessor_run_id}.md",
2026-11-13T04:17:38.4293732Z     ]
2026-11-13T04:17:38.4293933Z     claimed_tests: list[dict[str, Any]] = []
2026-11-13T04:17:38.4294209Z     seen: set[str] = set()
2026-11-13T04:17:38.4294444Z     for report in candidates:
2026-11-13T04:17:38.4294684Z         if not report.is_file():
2026-11-13T04:17:38.4294918Z             continue
2026-11-13T04:17:38.4295157Z         for rel in sorted(set(CYCLE_TEST_RE.findall(
2026-11-13T04:17:38.4295525Z                 report.read_text(encoding="utf-8", errors="replace")))):
2026-11-13T04:17:38.4295866Z             if rel in seen:
2026-11-13T04:17:38.4296094Z                 continue
2026-11-13T04:17:38.4296307Z             seen.add(rel)
2026-11-13T04:17:38.4296533Z             claimed_tests.append({
2026-11-13T04:17:38.4296789Z                 "path": rel,
2026-11-13T04:17:38.4297282Z                 "claimed_by_report": _repo_relative(report),
2026-11-13T04:17:38.4297612Z                 "present": (REPO_ROOT / rel).is_file(),
2026-11-13T04:17:38.4297884Z             })
2026-11-13T04:17:38.4298130Z [0m
2026-11-13T04:17:45.9326848Z [0m$ [0mcd /home/runner/work/LexMachina/LexMachina && sed -n '260,420p' product/resume_snapshot_diagnosis.py
2026-11-13T04:17:45.9328070Z dossiers = [
2026-11-13T04:17:45.9328508Z         REPO_ROOT / "results" / "product" / "audit_readiness"
2026-11-13T04:17:45.9329085Z         / f"CYCLE_{rid}_audit_readiness.json"
2026-11-13T04:17:45.9329423Z         for rid in (run_id, predecessor_run_id) if rid
2026-11-13T04:17:45.9329728Z     ]
2026-11-13T04:17:45.9330048Z     dossier_summary = []
2026-11-13T04:17:45.9336048Z     for dossier in dossiers:
2026-11-13T04:17:45.9336475Z         if not dossier.is_file():
2026-11-13T04:17:45.9336753Z             continue
2026-11-13T04:17:45.9337234Z         try:
2026-11-13T04:17:45.9337862Z             data = json.loads(dossier.read_text(encoding="utf-8"))
2026-11-13T04:17:45.9338247Z         except json.JSONDecodeError:
2026-11-13T04:17:45.9338519Z             continue
2026-11-13T04:17:45.9338744Z         dossier_summary.append({
2026-11-13T04:17:45.9339027Z             "path": _repo_relative(dossier),
2026-11-13T04:17:45.9339351Z             "overall_status": data.get("overall_status"),
2026-11-13T04:17:45.9339709Z             "skipped_checks": data.get("skipped_checks") or [],
2026-11-13T04:17:45.9340075Z             "failed_checks": data.get("failed_checks") or [],
2026-11-13T04:17:45.9340381Z         })
2026-11-13T04:17:45.9340490Z 
2026-11-13T04:17:45.9340591Z     fresh = _fresh_runner_probe()
2026-11-13T04:17:45.9340761Z 
2026-11-13T04:17:45.9340857Z     historical = sorted(
2026-11-13T04:17:45.9341094Z         _repo_relative(path)
2026-11-13T04:17:45.9341447Z         for path in (REPO_ROOT / "results" / "product" / "reality_check").glob(
2026-11-13T04:17:45.9341841Z             "*missing-deps*.json")
2026-11-13T04:17:45.9342085Z     )
2026-11-13T04:17:45.9342317Z     probe = query_env.probe()
2026-11-13T04:17:45.9342559Z     return {
2026-11-13T04:17:45.9342775Z         "claimed_cycle_tests": claimed_tests,
2026-11-13T04:17:45.9343236Z         "missing_claimed_cycle_tests": [
2026-11-13T04:17:45.9343581Z             row["path"] for row in claimed_tests if not row["present"]
2026-11-13T04:17:45.9343915Z         ],
2026-11-13T04:17:45.9344141Z         "audit_readiness_dossiers": dossier_summary,
2026-11-13T04:17:45.9344473Z         "dossiers_with_skipped_mandatory_reruns": [
2026-11-13T04:17:45.9344859Z             row["path"] for row in dossier_summary if row["skipped_checks"]
2026-11-13T04:17:45.9345210Z         ],
2026-11-13T04:17:45.9345405Z         "runtime_preflight": {
2026-11-13T04:17:45.9345648Z             "ok": probe["ok"],
2026-11-13T04:17:45.9345892Z             "missing": probe["missing"],
2026-11-13T04:17:45.9346176Z             "installed": probe["installed"],
2026-11-13T04:17:45.9346468Z             "pinned": probe["pinned"],
2026-11-13T04:17:45.9346745Z             "remedy": probe["remedy"],
2026-11-13T04:17:45.9347282Z             "workflow_gap": probe["workflow_gap"],
2026-11-13T04:17:45.9347608Z             "fresh_runner_no_site_probe": fresh,
2026-11-13T04:17:45.9347904Z         },
2026-11-13T04:17:45.9348179Z         "historical_missing_dependency_artifacts": historical[:5],
2026-11-13T04:17:45.9348522Z         "meaning": (
2026-11-13T04:17:45.9348826Z             "These are reproducible validation gaps, not a provider/auth "
2026-11-13T04:17:45.9349295Z             "mechanism and not a product verdict. Missing deps and a missing "
2026-11-13T04:17:45.9349764Z             "claimed test make a green snapshot fail its own self-check on a "
2026-11-13T04:17:45.9350222Z             "fresh runner; they are repaired by the resuming cycle, never by "
2026-11-13T04:17:45.9350597Z             "weakening a frozen bar."
2026-11-13T04:17:45.9350842Z         ),
2026-11-13T04:17:45.9351029Z     }
2026-11-13T04:17:45.9351222Z 
2026-11-13T04:17:45.9351230Z 
2026-11-13T04:17:45.9351535Z def _orchestration_without_raw(raw_path: Path | None) -> dict[str, Any]:
2026-11-13T04:17:45.9352332Z     """Honest placeholder when no public run/jobs snapshot was captured.
2026-11-13T04:17:45.9352631Z 
2026-11-13T04:17:45.9352945Z     The missing artefact is recorded as such.  A git-ref delta and the absence
2026-11-13T04:17:45.9353699Z     of an audit half still prove a great deal, but they cannot name a provider,
2026-11-13T04:17:45.9354159Z     auth or quantum mechanism, so none is invented.
2026-11-13T04:17:45.9354628Z     """
2026-11-13T04:17:45.9354824Z     return {
2026-11-13T04:17:45.9355029Z         "schema": asd.SCHEMA,
2026-11-13T04:17:45.9355423Z         "classification": "RAW_SNAPSHOT_UNAVAILABLE",
2026-11-13T04:17:45.9355744Z         "mechanism_unobserved": True,
2026-11-13T04:17:45.9356085Z         "raw_snapshot": _repo_relative(raw_path) if raw_path else None,
2026-11-13T04:17:45.9356589Z         "meaning": (
2026-11-13T04:17:45.9357232Z             "No committed run/jobs snapshot exists for this failed run in the "
2026-11-13T04:17:45.9357870Z             "producer checkout (job logs require admin rights). The durable "
2026-11-13T04:17:45.9358339Z             "delta and the absent audit half are still proven from git refs; "
2026-11-13T04:17:45.9358762Z             "the provider/auth/timeout mechanism is NOT claimed."
2026-11-13T04:17:45.9359073Z         ),
2026-11-13T04:17:45.9359255Z     }
2026-11-13T04:17:45.9359353Z 
2026-11-13T04:17:45.9359357Z 
2026-11-13T04:17:45.9359436Z def run(
2026-11-13T04:17:45.9359617Z     run_id: str,
2026-11-13T04:17:45.9359824Z     predecessor_run_id: str = "",
2026-11-13T04:17:45.9360079Z     raw_path: Path | None = None,
2026-11-13T04:17:45.9360314Z     *,
2026-11-13T04:17:45.9360508Z     predecessor_ref: str | None = None,
2026-11-13T04:17:45.9360774Z ) -> dict[str, Any]:
2026-11-13T04:17:45.9360983Z     orchestration = (
2026-11-13T04:17:45.9361310Z         asd.classify(json.loads(Path(raw_path).read_text(encoding="utf-8")))
2026-11-13T04:17:45.9361694Z         if raw_path is not None
2026-11-13T04:17:45.9361955Z         else _orchestration_without_raw(None)
2026-11-13T04:17:45.9362225Z     )
2026-11-13T04:17:45.9362563Z     if predecessor_ref:
2026-11-13T04:17:45.9362910Z         delta = _delta(f"origin/cycle/core/product/{run_id}/team", predecessor_ref)
2026-11-13T04:17:45.9363312Z     elif predecessor_run_id:
2026-11-13T04:17:45.9363544Z         delta = _delta(
2026-11-13T04:17:45.9363791Z             f"origin/cycle/core/product/{run_id}/team",
2026-11-13T04:17:45.9364151Z             f"origin/cycle/core/product/{predecessor_run_id}/team",
2026-11-13T04:17:45.9364471Z         )
2026-11-13T04:17:45.9364653Z     else:
2026-11-13T04:17:45.9364950Z         delta = _delta(f"origin/cycle/core/product/{run_id}/team", ACCEPTED_REF)
2026-11-13T04:17:45.9365331Z     accept = _accept_commit(run_id)
2026-11-13T04:17:45.9365589Z     audit = _audit_half(run_id)
2026-11-13T04:17:45.9366017Z     accepted = bool(accept.get("accept_commit")) and bool(
2026-11-13T04:17:45.9366592Z         audit.get("gate_verdict") == "PASS"
2026-11-13T04:17:45.9367271Z         and audit.get("safe_to_integrate") is True
2026-11-13T04:17:45.9367736Z     )
2026-11-13T04:17:45.9368075Z     record: dict[str, Any] = {
2026-11-13T04:17:45.9368501Z         "schema": SCHEMA,
2026-11-13T04:17:45.9369093Z         "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
2026-11-13T04:17:45.9369898Z         "run_id": run_id,
2026-11-13T04:17:45.9370346Z         "predecessor_run_id": predecessor_run_id,
2026-11-13T04:17:45.9371029Z         "raw_snapshot": _repo_relative(Path(raw_path)) if raw_path else None,
2026-11-13T04:17:45.9371696Z         "orchestration": orchestration,
2026-11-13T04:17:45.9372165Z         "durable_delta": delta,
2026-11-13T04:17:45.9372580Z         "adjudication": {
2026-11-13T04:17:45.9372971Z             "audit": audit,
2026-11-13T04:17:45.9373378Z             "accept": accept,
2026-11-13T04:17:45.9373788Z             "accepted": accepted,
2026-11-13T04:17:45.9374322Z             "status": "ACCEPTED" if accepted else "UNADJUDICATED",
2026-11-13T04:17:45.9374909Z             "product_defect": False,
2026-11-13T04:17:45.9375379Z             "verdict_written": False,
2026-11-13T04:17:45.9375912Z             "why_not_accepted": (
2026-11-13T04:17:45.9376353Z                 None if accepted else
2026-11-13T04:17:45.9377153Z                 "requirement 4 needs BOTH an independent PASS gate on the "
2026-11-13T04:17:45.9377943Z                 "audit ref AND an accept commit on lab/product; at least one "
2026-11-13T04:17:45.9378586Z                 "half is absent for this run"
2026-11-13T04:17:45.9379055Z             ),
2026-11-13T04:17:45.9379384Z         },
2026-11-13T04:17:45.9379747Z         "audit_namespace": _audit_namespace(),
2026-11-13T04:17:45.9380426Z         "validation_findings": _validation_findings(run_id, predecessor_run_id),
2026-11-13T04:17:45.9381420Z         "claim_ceiling": (
2026-11-13T04:17:45.9382015Z             "This artifact classifies an orchestration outcome and a git-ref "
2026-11-13T04:17:45.9382808Z             "delta. It writes no gate, labels no run accepted or rejected, "
2026-11-13T04:17:45.9383609Z             "asserts no cause the committed run/jobs snapshot cannot show, and "
2026-11-13T04:17:45.9384440Z             "makes no product, legal or serve claim."
2026-11-13T04:17:45.9384932Z         ),
2026-11-13T04:17:45.9385237Z     }
