2026-11-13T04:17:58.6709141Z def _failure_annotations(snapshot: dict, team: dict, audit: dict,
2026-11-13T04:17:58.6709646Z                          audit_step_failed: bool, failed_team_step: dict | None
2026-11-13T04:17:58.6710014Z                          ) -> dict:
2026-11-13T04:17:58.6710422Z     """Extract the *observable* failure annotations, if the snapshot has them.
2026-11-13T04:17:58.6710728Z 
2026-11-13T04:17:58.6710944Z     GitHub check-run annotations are public even when job logs require admin
2026-11-13T04:17:58.6711442Z     rights.  The workflow's own 45-minute agent wrapper announces
2026-11-13T04:17:58.6712152Z     ``LEX_WORK_QUANTUM_EXPIRED seconds=2700`` and exit code 78, so a quantum
2026-11-13T04:17:58.6712945Z     expiry can be stated as observed evidence instead of "mechanism unknown".
2026-11-13T04:17:58.6713499Z     """
2026-11-13T04:17:58.6713949Z     if audit_step_failed:
2026-11-13T04:17:58.6714387Z         job_name, job = AUDIT_JOB, audit
2026-11-13T04:17:58.6714966Z     elif failed_team_step is not None:
2026-11-13T04:17:58.6715497Z         job_name, job = TEAM_JOB, team
2026-11-13T04:17:58.6715989Z     else:
2026-11-13T04:17:58.6716445Z         job_name, job = None, {}
2026-11-13T04:17:58.6717114Z     messages = [
2026-11-13T04:17:58.6717861Z         str(a.get("message") or "")
2026-11-13T04:17:58.6718396Z         for a in _job_annotations(snapshot, job)
2026-11-13T04:17:58.6718954Z         if isinstance(a, dict)
2026-11-13T04:17:58.6719437Z     ]
2026-11-13T04:17:58.6719895Z     quantum_seconds = None
2026-11-13T04:17:58.6720382Z     exit_code = None
2026-11-13T04:17:58.6720858Z     quantum_message = None
2026-11-13T04:17:58.6721364Z     for message in messages:
2026-11-13T04:17:58.6721862Z         m = QUANTUM_RE.search(message)
2026-11-13T04:17:58.6722381Z         if m:
2026-11-13T04:17:58.6722872Z             quantum_seconds = int(m.group(1))
2026-11-13T04:17:58.6723441Z             quantum_message = message.strip()
2026-11-13T04:17:58.6723990Z         e = EXIT_CODE_RE.search(message)
2026-11-13T04:17:58.6724522Z         if e and exit_code is None:
2026-11-13T04:17:58.6725075Z             exit_code = int(e.group(1))
2026-11-13T04:17:58.6725539Z     return {
2026-11-13T04:17:58.6725996Z         "source": (
2026-11-13T04:17:58.6726633Z             "github_actions_check_run_annotations" if messages else "none"
2026-11-13T04:17:58.6727463Z         ),
2026-11-13T04:17:58.6727960Z         "annotations_available": bool(messages),
2026-11-13T04:17:58.6728486Z         "job": job_name,
2026-11-13T04:17:58.6729186Z         "exit_code": exit_code,
2026-11-13T04:17:58.6729755Z         "quantum_expired": quantum_seconds is not None,
2026-11-13T04:17:58.6730316Z         "quantum_seconds": quantum_seconds,
2026-11-13T04:17:58.6730870Z         "quantum_message": quantum_message,
2026-11-13T04:17:58.6731390Z         "messages": messages,
2026-11-13T04:17:58.6731866Z     }
2026-11-13T04:17:58.6732198Z 
