2026-11-13T04:15:25.0943891Z def _now() -> str:
2026-11-13T04:15:25.0944415Z     return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
2026-11-13T04:15:25.0944894Z 
2026-11-13T04:15:25.0944900Z 
2026-11-13T04:15:25.0945068Z def _load(path: Path) -> dict:
2026-11-13T04:15:25.0945569Z     return json.loads(path.read_text(encoding="utf-8"))
2026-11-13T04:15:25.0945959Z 
2026-11-13T04:15:25.0945964Z 
2026-11-13T04:15:25.0946128Z def _sha256(path: Path) -> str:
2026-11-13T04:15:25.0946557Z     h = hashlib.sha256()
2026-11-13T04:15:25.0947174Z     with path.open("rb") as fh:
2026-11-13T04:15:25.0947915Z         for chunk in iter(lambda: fh.read(1 << 20), b""):
2026-11-13T04:15:25.0948479Z             h.update(chunk)
2026-11-13T04:15:25.0948873Z     return h.hexdigest()
2026-11-13T04:15:25.0949125Z 
2026-11-13T04:15:25.0949139Z 
2026-11-13T04:15:25.0949397Z def _run(cmd: list[str], timeout: int) -> dict[str, Any]:
2026-11-13T04:15:25.0949943Z     started = time.monotonic()
2026-11-13T04:15:25.0950354Z     try:
2026-11-13T04:15:25.0950837Z         proc = subprocess.run(cmd, cwd=str(ROOT), capture_output=True,
2026-11-13T04:15:25.0951547Z                               text=True, timeout=timeout, check=False)
2026-11-13T04:15:25.0952078Z         return {
2026-11-13T04:15:25.0952444Z             "command": " ".join(cmd),
2026-11-13T04:15:25.0952913Z             "exit_code": proc.returncode,
2026-11-13T04:15:25.0953472Z             "seconds": round(time.monotonic() - started, 3),
2026-11-13T04:15:25.0954073Z             "stdout_tail": proc.stdout[-4000:],
2026-11-13T04:15:25.0954610Z             "stderr_tail": proc.stderr[-4000:],
2026-11-13T04:15:25.0955097Z             "timed_out": False,
2026-11-13T04:15:25.0955494Z         }
2026-11-13T04:15:25.0955873Z     except subprocess.TimeoutExpired as exc:
