2026-11-13T04:16:02.1283601Z #!/usr/bin/env python3
2026-11-13T04:16:02.1284159Z """Classify why a core-lane run stopped before an independent audit gate.
2026-11-13T04:16:02.1284484Z 
2026-11-13T04:16:02.1284571Z Why this exists
2026-11-13T04:16:02.1284779Z ---------------
2026-11-13T04:16:02.1285104Z The product cycle is routinely resumed with the instruction "diagnose the
2026-11-13T04:16:02.1286178Z orchestration/validation failure".  From the producer tree alone the important
2026-11-13T04:16:02.1287358Z facts are: did the team job persist its snapshot, did the provider/agent step
2026-11-13T04:16:02.1288240Z fail, and did an independent gate ever get written?  This module answers those
2026-11-13T04:16:02.1288903Z questions from a committed GitHub Actions run/jobs snapshot -- no token, no job
2026-11-13T04:16:02.1289354Z logs, no guessing at a cause it cannot observe.
2026-11-13T04:16:02.1289572Z 
2026-11-13T04:16:02.1289669Z It deliberately does NOT:
2026-11-13T04:16:02.1290016Z * claim a provider/auth/quantum mechanism when the log is unavailable;
2026-11-13T04:16:02.1290491Z * treat a failed audit *or team* job as a product defect or as a verdict;
2026-11-13T04:16:02.1290979Z * write ``results/audit/**`` (only the independent auditor may write there).
2026-11-13T04:16:02.1291278Z 
2026-11-13T04:16:02.1291486Z The ``team`` block reports the persist step's OWN conclusion.  This matters
2026-11-13T04:16:02.1291992Z because the workflow guards that step with ``if: always()``: a failed producer
2026-11-13T04:16:02.1292504Z still publishes its (possibly unchanged) tree to the team ref, so "team job
2026-11-13T04:16:02.1293005Z failed" must never be reported as "no snapshot exists".  Whether that snapshot
2026-11-13T04:16:02.1293719Z carries a durable delta is a separate, git-ref fact and is deliberately not
2026-11-13T04:16:02.1294099Z inferred here.
2026-11-13T04:16:02.1294230Z 
2026-11-13T04:16:02.1294305Z Usage
2026-11-13T04:16:02.1294483Z -----
2026-11-13T04:16:02.1294818Z     python3 product/audit_step_diagnosis.py --raw <snapshot.json> --out <dir>
2026-11-13T04:16:02.1295205Z """
2026-11-13T04:16:02.1295406Z from __future__ import annotations
2026-11-13T04:16:02.1295655Z 
2026-11-13T04:16:02.1295811Z import argparse
2026-11-13T04:16:02.1296170Z import json
2026-11-13T04:16:02.1296376Z import re
2026-11-13T04:16:02.1296588Z from datetime import datetime, timezone
2026-11-13T04:16:02.1296869Z from pathlib import Path
2026-11-13T04:16:02.1297298Z 
2026-11-13T04:16:02.1297431Z SCHEMA = "product-audit-step-diagnosis/1"
2026-11-13T04:16:02.1297961Z TEAM_JOB = "team"
2026-11-13T04:16:02.1298328Z AUDIT_JOB = "audit"
2026-11-13T04:16:02.1298733Z AUDIT_STEP = "Independent audit"
2026-11-13T04:16:02.1299324Z QUANTUM_RE = re.compile(r"LEX_WORK_QUANTUM_EXPIRED\s+seconds=(\d+)")
2026-11-13T04:16:02.1300160Z EXIT_CODE_RE = re.compile(r"exit code\s+(\d+)", re.IGNORECASE)
2026-11-13T04:16:02.1300559Z 
2026-11-13T04:16:02.1300565Z 
2026-11-13T04:16:02.1300782Z def _step(job: dict, name: str) -> dict | None:
2026-11-13T04:16:02.1301506Z     return next((s for s in job.get("steps") or [] if s.get("name") == name), None)
2026-11-13T04:16:02.1302028Z 
2026-11-13T04:16:02.1302034Z 
2026-11-13T04:16:02.1302365Z def _seconds_between(start: str | None, end: str | None) -> float | None:
2026-11-13T04:16:02.1302875Z     if not start or not end:
2026-11-13T04:16:02.1303305Z         return None
2026-11-13T04:16:02.1303681Z     fmt = "%Y-%m-%dT%H:%M:%SZ"
2026-11-13T04:16:02.1304340Z     return round((datetime.strptime(end, fmt) - datetime.strptime(start, fmt))
