2026-11-13T04:15:25.0929020Z # Active profile; empty means "the module constants above" (the original
2026-11-13T04:15:25.0929441Z # pinned run).  Set by run()/select_profile() only.
2026-11-13T04:15:25.0929756Z PROFILE: dict[str, Any] = {}
2026-11-13T04:15:25.0929915Z 
2026-11-13T04:15:25.0929924Z 
2026-11-13T04:15:25.0930052Z def select_profile(run_id: str) -> dict[str, Any]:
2026-11-13T04:15:25.0930460Z     """Resolve the dossier profile for ``run_id`` (aliases are followed).
2026-11-13T04:15:25.0930741Z 
2026-11-13T04:15:25.0930934Z     A dossier for the wrong run is worse than no dossier: it would re-derive
2026-11-13T04:15:25.0931404Z     another run's claims and label them with this run's id.  Unknown run ids
2026-11-13T04:15:25.0931884Z     therefore fail closed instead of silently inheriting the default profile.
2026-11-13T04:15:25.0932258Z     """
2026-11-13T04:15:25.0932441Z     key = str(run_id)
2026-11-13T04:15:25.0932662Z     prof = PROFILES.get(key)
2026-11-13T04:15:25.0932951Z     while isinstance(prof, dict) and "alias_of" in prof:
2026-11-13T04:15:25.0933298Z         prof = PROFILES.get(str(prof["alias_of"]))
2026-11-13T04:15:25.0933586Z     if prof is None:
2026-11-13T04:15:25.0933804Z         raise SystemExit(
2026-11-13T04:15:25.0934137Z             f"no audit-readiness profile for run {key}; refusing to fall back "
2026-11-13T04:15:25.0934713Z             f"to {DEFAULT_PROFILE_KEY} and publish another run's claims")
2026-11-13T04:15:25.0935050Z     return dict(prof)
2026-11-13T04:15:25.0935179Z 
2026-11-13T04:15:25.0935188Z 
2026-11-13T04:15:25.0935311Z def p(field: str, default: Any = None) -> Any:
2026-11-13T04:15:25.0935693Z     """Profile field with a fallback to the pinned module constants."""
2026-11-13T04:15:25.0936049Z     if field in PROFILE:
2026-11-13T04:15:25.0936282Z         return PROFILE[field]
2026-11-13T04:15:25.0936513Z     return default
2026-11-13T04:15:25.0936636Z 
2026-11-13T04:15:25.0936640Z 
2026-11-13T04:15:25.0936744Z def _report_paths() -> list[Path]:
2026-11-13T04:15:25.0937212Z     out = []
2026-11-13T04:15:25.0937478Z     for value in (p("inherited_report", INHERITED_REPORT),
2026-11-13T04:15:25.0937828Z                   p("current_report", CURRENT_REPORT)):
2026-11-13T04:15:25.0938119Z         if value is not None:
2026-11-13T04:15:25.0938454Z             out.append(Path(value))
2026-11-13T04:15:25.0938862Z     return out
