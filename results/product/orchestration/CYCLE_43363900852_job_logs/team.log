2026-11-13T04:17:38.4273114Z         ],
2026-11-13T04:17:38.4273342Z         "producer_minted_accepted_baseline_count": len(
2026-11-13T04:17:38.4273678Z             inv["producer_minted_accepted_baseline"]
2026-11-13T04:17:38.4273955Z         ),
2026-11-13T04:17:38.4274125Z     }
