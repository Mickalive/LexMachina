2026-11-13T00:39:28.7624999Z def _fresh_runner_probe() -> dict[str, Any]:
2026-11-13T00:39:28.7625356Z     """Probe the query runtime with ``-S`` to reproduce a fresh runner.
2026-11-13T00:39:28.7625627Z 
2026-11-13T00:39:28.7625805Z     The core-lane team job installs nothing, so a fresh runner has neither
2026-11-13T00:39:28.7626548Z     numpy nor scikit-learn.  ``python -S`` skips the user site where the
2026-11-13T00:39:28.7627021Z     bootstrap installs them, which makes that validation gap reproducible
2026-11-13T00:39:28.7627414Z     without touching the current environment.
2026-11-13T00:39:28.7627677Z     """
2026-11-13T00:39:28.7627844Z     code = (
2026-11-13T00:39:28.7628033Z         "import json,sys;"
2026-11-13T00:39:28.7628270Z         "sys.path.insert(0, '.');"
2026-11-13T00:39:28.7628529Z         "from product import query_env;"
2026-11-13T00:39:28.7628807Z         "print(json.dumps(query_env.probe()))"
2026-11-13T00:39:28.7629067Z     )
2026-11-13T00:39:28.7629236Z     try:
2026-11-13T00:39:28.7629422Z         proc = subprocess.run(
2026-11-13T00:39:28.7629869Z             [sys.executable, "-S", "-c", code], cwd=str(REPO_ROOT),
2026-11-13T00:39:28.7630274Z             capture_output=True, text=True, timeout=60, check=False,
2026-11-13T00:39:28.7630590Z         )
2026-11-13T00:39:28.7630888Z     except (OSError, subprocess.SubprocessError) as exc:  # pragma: no cover
2026-11-13T00:39:28.7631331Z         return {"ok": None, "error": f"{type(exc).__name__}: {exc}"}
2026-11-13T00:39:28.7631666Z     probe: dict[str, Any] = {}
2026-11-13T00:39:28.7631907Z     if proc.stdout.strip():
2026-11-13T00:39:28.7632141Z         try:
2026-11-13T00:39:28.7632360Z             probe = json.loads(proc.stdout)
2026-11-13T00:39:28.7632647Z         except json.JSONDecodeError:
2026-11-13T00:39:28.7632909Z             probe = {}
2026-11-13T00:39:28.7633115Z     return {
2026-11-13T00:39:28.7633307Z         "ok": probe.get("ok"),
2026-11-13T00:39:28.7633553Z         "missing": probe.get("missing"),
2026-11-13T00:39:28.7633822Z         "exit_code": proc.returncode,
2026-11-13T00:39:28.7634158Z         "stderr_tail": (proc.stderr or "").strip().splitlines()[-3:],
2026-11-13T00:39:28.7634500Z         "meaning": (
