2026-11-13T00:51:35.6453841Z def sha256_bytes(data: bytes) -> str:
2026-11-13T00:51:35.6454371Z     return hashlib.sha256(data).hexdigest()
2026-11-13T00:51:35.6454728Z 
2026-11-13T00:51:35.6454734Z 
2026-11-13T00:51:35.6454972Z def parse_lane_cycle_log(text: str) -> dict[str, Any]:
2026-11-13T00:51:35.6455669Z     """Derive the observable failure facts of one ``Run lane cycle`` log.
2026-11-13T00:51:35.6456342Z 
2026-11-13T00:51:35.6456686Z     Pure and total: an input that shows none of the known markers returns
2026-11-13T00:51:35.6457509Z     ``classification = UNCLASSIFIED_LANE_CYCLE_FAILURE`` with the markers it
2026-11-13T00:51:35.6458290Z     did see, rather than being folded into a neighbouring class.
2026-11-13T00:51:35.6458864Z     """
2026-11-13T00:51:35.6459050Z     pool = None
2026-11-13T00:51:35.6459279Z     for match in POOL_RE.finditer(text):
2026-11-13T00:51:35.6459647Z         pool = match.groupdict()  # last attempt wins if a retry happened
2026-11-13T00:51:35.6460002Z     upstream = None
2026-11-13T00:51:35.6460240Z     for match in UPSTREAM_RE.finditer(text):
2026-11-13T00:51:35.6460514Z         upstream = {
2026-11-13T00:51:35.6460769Z             "signature": match.group("signature").strip(),
2026-11-13T00:51:35.6461109Z             "detail": match.group("detail").strip()[:300],
2026-11-13T00:51:35.6461391Z         }
2026-11-13T00:51:35.6461656Z     exit_codes = [int(m.group(1)) for m in EXIT_RE.finditer(text)]
2026-11-13T00:51:35.6462069Z     attempts = [
2026-11-13T00:51:35.6462298Z         {"attempt": int(a), "max_attempts": int(b)}
2026-11-13T00:51:35.6462596Z         for a, b in ATTEMPT_RE.findall(text)
2026-11-13T00:51:35.6462847Z     ]
2026-11-13T00:51:35.6463074Z     missing = sorted(set(MISSING_MODULE_RE.findall(text)))
2026-11-13T00:51:35.6463301Z 
2026-11-13T00:51:35.6463483Z     # Workflow annotations are this run's own verdicts; anything the agent
2026-11-13T00:51:35.6463939Z     # merely quotes is recorded separately and never classifies the run.
2026-11-13T00:51:35.6464419Z     annotation_texts = [m.group("text") for m in ANNOTATION_LINE_RE.finditer(text)]
2026-11-13T00:51:35.6464836Z     annotation_blob = "\n".join(annotation_texts)
2026-11-13T00:51:35.6465225Z 
2026-11-13T00:51:35.6465329Z     def _annotation(marker: str) -> bool:
2026-11-13T00:51:35.6465602Z         return marker in annotation_blob
2026-11-13T00:51:35.6465776Z 
2026-11-13T00:51:35.6465877Z     def _quoted_only(marker: str) -> bool:
2026-11-13T00:51:35.6466489Z         return marker in text and marker not in annotation_blob
2026-11-13T00:51:35.6466735Z 
2026-11-13T00:51:35.6466811Z     markers = {
2026-11-13T00:51:35.6467068Z         "zero_delta_guard": _annotation("LEX_ZERO_DELTA_REPAIR"),
2026-11-13T00:51:35.6467456Z         "non_transient_failure": "failed without transient" in text,
2026-11-13T00:51:35.6467822Z         "agent_card_ok": "LEX_AGENT_CARD_OK" in text,
2026-11-13T00:51:35.6468218Z         "persist_nothing_to_commit": "nothing to commit, working tree clean" in
2026-11-13T00:51:35.6468589Z                                      text,
2026-11-13T00:51:35.6468919Z         "quantum_expired": _annotation("LEX_WORK_QUANTUM_EXPIRED"),
2026-11-13T00:51:35.6469361Z         "map_data_missing_positions": "Map data missing positions" in text,
2026-11-13T00:51:35.6469757Z         "markers_quoted_from_history_only": sorted(
2026-11-13T00:51:35.6470125Z             m for m in ("LEX_ZERO_DELTA_REPAIR", "LEX_WORK_QUANTUM_EXPIRED")
2026-11-13T00:51:35.6470468Z             if _quoted_only(m)
2026-11-13T00:51:35.6470688Z         ),
2026-11-13T00:51:35.6470895Z         "annotation_error_lines": sorted(set(
2026-11-13T00:51:35.6471183Z             m.group("text").strip()[:200]
2026-11-13T00:51:35.6471476Z             for m in ANNOTATION_LINE_RE.finditer(text)
2026-11-13T00:51:35.6471775Z             if m.group("level") == "error"
2026-11-13T00:51:35.6472019Z         )),
2026-11-13T00:51:35.6472192Z     }
2026-11-13T00:51:35.6472287Z 
2026-11-13T00:51:35.6472385Z     if markers["quantum_expired"]:
2026-11-13T00:51:35.6472647Z         classification = CLASS_QUANTUM
2026-11-13T00:51:35.6473133Z         why = "the wrapper's work quantum expired before the cycle finished"
2026-11-13T00:51:35.6473597Z     elif upstream and upstream["signature"] == "unsupported_parameter":
2026-11-13T00:51:35.6473978Z         classification = CLASS_MODEL_PARAMETER
2026-11-13T00:51:35.6474247Z         why = (
2026-11-13T00:51:35.6474536Z             "the selected upstream rejected a request argument OpenCode sent; "
2026-11-13T00:51:35.6475000Z             "the wrapper treats it as non-transient, so the agent never starts"
2026-11-13T00:51:35.6475349Z         )
2026-11-13T00:51:35.6475538Z     elif markers["zero_delta_guard"]:
2026-11-13T00:51:35.6475803Z         classification = CLASS_ZERO_DELTA
2026-11-13T00:51:35.6476410Z         why = (
2026-11-13T00:51:35.6476898Z             "the agent process exited 0 with an unchanged tree, so the "
2026-11-13T00:51:35.6477633Z             "LEX_REQUIRE_DELTA guard rejected the cycle before persistence"
2026-11-13T00:51:35.6478225Z         )
2026-11-13T00:51:35.6478522Z     else:
2026-11-13T00:51:35.6478845Z         classification = CLASS_UNCLASSIFIED
2026-11-13T00:51:35.6479451Z         why = "none of the known lane-cycle failure markers were observed"
2026-11-13T00:51:35.6479909Z 
2026-11-13T00:51:35.6480035Z     return {
2026-11-13T00:51:35.6480348Z         "model_pool": pool,
2026-11-13T00:51:35.6480745Z         "upstream_error": upstream,
2026-11-13T00:51:35.6481170Z         "exit_codes": exit_codes,
2026-11-13T00:51:35.6481576Z         "attempts": attempts,
2026-11-13T00:51:35.6481976Z         "missing_modules": missing,
2026-11-13T00:51:35.6482395Z         "markers": markers,
2026-11-13T00:51:35.6482795Z         "classification": classification,
2026-11-13T00:51:35.6483225Z         "why": why,
2026-11-13T00:51:35.6483531Z     }
2026-11-13T00:51:35.6483689Z 
2026-11-13T00:51:35.6483695Z 
2026-11-13T00:51:35.6483882Z def build(logs_dir: Path, run_ids: list[str],
2026-11-13T00:51:35.6484418Z           *, fetched_via: str, logs_endpoint_status: int,
2026-11-13T00:51:35.6484975Z           resuming_run_id: str) -> dict[str, Any]:
2026-11-13T00:51:35.6485656Z     runs: dict[str, Any] = {}
2026-11-13T00:51:35.6486182Z     for run_id in run_ids:
2026-11-13T00:51:35.6486629Z         path = logs_dir / f"{run_id}_team_lane_cycle.log"
2026-11-13T00:51:35.6487141Z         if not path.is_file():
2026-11-13T00:51:35.6487598Z             runs[run_id] = {"file": None, "present": False}
2026-11-13T00:51:35.6488098Z             continue
2026-11-13T00:51:35.6488441Z         raw = path.read_bytes()
2026-11-13T00:51:35.6489009Z         parsed = parse_lane_cycle_log(raw.decode("utf-8", errors="replace"))
2026-11-13T00:51:35.6489628Z         runs[run_id] = {
2026-11-13T00:51:35.6489988Z             "file": str(path),
2026-11-13T00:51:35.6490370Z             "present": True,
2026-11-13T00:51:35.6490743Z             "bytes": len(raw),
2026-11-13T00:51:35.6491133Z             "sha256": sha256_bytes(raw),
2026-11-13T00:51:35.6491548Z             **parsed,
2026-11-13T00:51:35.6491901Z         }
2026-11-13T00:51:35.6492200Z     classes = sorted({r["classification"] for r in runs.values()
2026-11-13T00:51:35.6492544Z                       if r.get("present")})
