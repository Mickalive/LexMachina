2026-11-13T00:30:54.0972894Z )
2026-11-13T00:30:54.0972992Z 
2026-11-13T00:30:54.0973189Z #: Bumped only when a key is REMOVED or its meaning changes.  ``diagnosis`` was
2026-11-13T00:30:54.0973658Z #: added additively in cycle 39087917357, so older committed artifacts stay
2026-11-13T00:30:54.0974086Z #: valid under the same schema and are never rewritten to match.
2026-11-13T00:30:54.0974575Z SCHEMA = "product-orchestration-evidence/1"
2026-11-13T00:30:54.0974944Z DEFAULT_OUT_DIR = REPO_ROOT / "results" / "product" / "orchestration"
2026-11-13T00:30:54.0975212Z 
2026-11-13T00:30:54.0975407Z #: Fallback copy of ``run-ox-with-retry.sh``'s default work quantum.  The real
2026-11-13T00:30:54.0975893Z #: value is read out of the control-plane script at runtime when it is reachable
2026-11-13T00:30:54.0976620Z #: (:func:`read_wrapper_quantum`); this constant only keeps the analysis honest
2026-11-13T00:30:54.0977063Z #: when that script is absent from the checkout being examined.
2026-11-13T00:30:54.0977400Z DEFAULT_WRAPPER_QUANTUM_SECONDS = 2700
2026-11-13T00:30:54.0977577Z 
2026-11-13T00:30:54.0977764Z #: Classes this module can name.  Anything else is reported as UNCLASSIFIED
2026-11-13T00:30:54.0978203Z #: rather than folded into a neighbouring class by resemblance.
