2026-11-13T00:49:38.1197304Z def classify(snapshot: dict) -> dict:
2026-11-13T00:49:38.1197653Z     """Pure classification of a committed run/jobs snapshot."""
2026-11-13T00:49:38.1197999Z     run = snapshot.get("run") or {}
2026-11-13T00:49:38.1198325Z     jobs = {j.get("name"): j for j in snapshot.get("jobs") or []}
2026-11-13T00:49:38.1198666Z     team = jobs.get(TEAM_JOB) or {}
2026-11-13T00:49:38.1198957Z     audit = jobs.get(AUDIT_JOB) or {}
2026-11-13T00:49:38.1199229Z     audit_step = _step(audit, AUDIT_STEP)
2026-11-13T00:49:38.1199814Z     gate_step = _step(audit, "Enforce audit scope and read gate")
2026-11-13T00:49:38.1200204Z     persist_step = _step(audit, "Persist audit snapshot")
2026-11-13T00:49:38.1200600Z     validate_step = _step(team, "Validate active MVP producer state")
2026-11-13T00:49:38.1200990Z     scope_step = _step(team, "Enforce lane write scope")
2026-11-13T00:49:38.1201378Z     snapshot_step = _step(team, "Persist team snapshot")
2026-11-13T00:49:38.1201703Z     integrate = jobs.get("integrate") or {}
2026-11-13T00:49:38.1201894Z 
2026-11-13T00:49:38.1202011Z     team_ok = team.get("conclusion") == "success"
2026-11-13T00:49:38.1202339Z     audit_failed = audit.get("conclusion") == "failure"
2026-11-13T00:49:38.1202756Z     audit_step_failed = bool(audit_step and audit_step.get("conclusion") == "failure")
2026-11-13T00:49:38.1203269Z     gate_skipped = bool(gate_step and gate_step.get("conclusion") == "skipped")
2026-11-13T00:49:38.1203752Z     # The workflow guards "Persist team snapshot" with `if: always()`, so the
2026-11-13T00:49:38.1204230Z     # step conclusion is the FACT about the snapshot, independent of whether
2026-11-13T00:49:38.1204697Z     # the team job succeeded.  Reporting it as `team_ok and persist_ok` hides
2026-11-13T00:49:38.1205181Z     # the always-publish behaviour that lets a failed producer's (empty) tree
2026-11-13T00:49:38.1205565Z     # reach the team ref anyway.
2026-11-13T00:49:38.1205818Z     team_snapshot_persisted = bool(
2026-11-13T00:49:38.1206493Z         snapshot_step and snapshot_step.get("conclusion") == "success"
2026-11-13T00:49:38.1206834Z     )
2026-11-13T00:49:38.1207022Z     failed_team_step = next(
