2026-11-13T00:30:52.7632409Z #!/usr/bin/env python3
2026-11-13T00:30:52.7633008Z """Observe a core-lane run on the GitHub REST API and update ``state/product.json``.
2026-11-13T00:30:52.7633513Z 
2026-11-13T00:30:52.7633744Z Why this module exists (direction v50, run 38600271324)
2026-11-13T00:30:52.7634320Z -------------------------------------------------------
2026-11-13T00:30:52.7634914Z The v50 lane outcome has three evidence obligations:
2026-11-13T00:30:52.7635301Z 
2026-11-13T00:30:52.7635666Z * (a) the four frozen reality legs must run LIVE inside the promoting run's own
2026-11-13T00:30:52.7636792Z   team job (``product/ci_reality_legs.py`` writes ``summary_ci_<run_id>.json``);
2026-11-13T00:30:52.7637657Z * (b) ``state/product.json`` must snapshot ``{run_id, head_sha, conclusion,
2026-11-13T00:30:52.7638473Z   created_at}`` for that run and set ``machine_gate_ready: true`` **only** once
2026-11-13T00:30:52.7639481Z   its conclusion is observably ``success``;
2026-11-13T00:30:52.7640144Z * (c) ``human_gate_ready`` stays ``false`` until an owner/jurist session exists.
2026-11-13T00:30:52.7640645Z 
2026-11-13T00:30:52.7640961Z (b) is a machine-readable fact about an external system, so it should be
2026-11-13T00:30:52.7641532Z *observed*, never typed by hand.  Hand-edited conclusions are exactly how the
2026-11-13T00:30:52.7642018Z withdrawn ``V45_QUERY_MAP_MACHINE_GATE_GREEN`` claim happened.  This module:
2026-11-13T00:30:52.7642308Z 
2026-11-13T00:30:52.7642486Z 1. fetches the run from the unauthenticated public REST endpoint
2026-11-13T00:30:52.7642876Z    (``GET /repos/{owner}/{repo}/actions/runs/{run_id}``);
2026-11-13T00:30:52.7643259Z 2. records the observation verbatim, including HTTP 404 runs into
2026-11-13T00:30:52.7643714Z    ``unresolvable_run_ids`` (housekeeper pruning makes 404s permanent, so they
2026-11-13T00:30:52.7644132Z    must never be re-cited as current evidence);
2026-11-13T00:30:52.7644525Z 3. flips ``machine_gate_ready`` to ``true`` only when **all** of these hold:
2026-11-13T00:30:52.7651577Z    the run exists, ``conclusion == "success"``, its ``summary_ci_<run_id>.json``
2026-11-13T00:30:52.7652519Z    exists in the tree with ``legs_complete`` and ``all_legs_passed`` true, and
2026-11-13T00:30:52.7653352Z    the run's ``head_sha`` matches the lab branch the summary was produced from;
2026-11-13T00:30:52.7654338Z 4. never touches ``human_gate_ready`` — that flag is the owner's to earn.
2026-11-13T00:30:52.7654829Z 
2026-11-13T00:30:52.7655166Z Per-job conclusions (``team`` / ``audit`` / ``integrate`` / ``resilience``) are
2026-11-13T00:30:52.7655856Z recorded alongside the run so the promotion chain is checkable: the v50 stall
2026-11-13T00:30:52.7656648Z was caused by a green team job whose ``integrate`` never ran, and a run-level
2026-11-13T00:30:52.7657134Z ``conclusion: success`` alone would not have shown that distinction.
2026-11-13T00:30:52.7657401Z 
2026-11-13T00:30:52.7657493Z Usage
2026-11-13T00:30:52.7657667Z -----
2026-11-13T00:30:52.7657936Z     python product/ci_run_evidence.py --run-id 38600271324 --apply
2026-11-13T00:30:52.7658667Z     python product/ci_run_evidence.py --run-id 38600271324          # dry run, prints diff
2026-11-13T00:30:52.7659071Z """
2026-11-13T00:30:52.7659264Z from __future__ import annotations
2026-11-13T00:30:52.7659435Z 
2026-11-13T00:30:52.7659516Z import argparse
2026-11-13T00:30:52.7659714Z import json
2026-11-13T00:30:52.7659901Z import os
2026-11-13T00:30:52.7660087Z import urllib.error
2026-11-13T00:30:52.7660295Z import urllib.request
2026-11-13T00:30:52.7660525Z from pathlib import Path
2026-11-13T00:30:52.7660763Z from typing import Any, Callable
2026-11-13T00:30:52.7660921Z 
2026-11-13T00:30:52.7661046Z REPO_ROOT = Path(__file__).resolve().parents[1]
2026-11-13T00:30:52.7661380Z DEFAULT_STATE = REPO_ROOT / "state" / "product.json"
2026-11-13T00:30:52.7661785Z DEFAULT_SUMMARY_DIR = REPO_ROOT / "results" / "product" / "reality_check"
2026-11-13T00:30:52.7662281Z DEFAULT_REPO = os.environ.get("LEX_GITHUB_REPO", "Mickalive/LexMachina")
2026-11-13T00:30:52.7662576Z 
2026-11-13T00:30:52.7662679Z Fetch = Callable[[str], tuple[int, dict]]
2026-11-13T00:30:52.7662867Z 
2026-11-13T00:30:52.7662871Z 
2026-11-13T00:30:52.7662978Z class RunNotFound(RuntimeError):
2026-11-13T00:30:52.7663337Z     """HTTP 404: the run id no longer resolves and must not be cited as evidence."""
2026-11-13T00:30:52.7663631Z 
2026-11-13T00:30:52.7663635Z 
2026-11-13T00:30:52.7663818Z def http_fetch(url: str, timeout: float = 20.0) -> tuple[int, dict]:
2026-11-13T00:30:52.7664185Z     request = urllib.request.Request(
2026-11-13T00:30:52.7664587Z         url, headers={"Accept": "application/vnd.github+json", "User-Agent": "lexmachina"}
2026-11-13T00:30:52.7664980Z     )
2026-11-13T00:30:52.7665151Z     try:
2026-11-13T00:30:52.7665472Z         with urllib.request.urlopen(request, timeout=timeout) as response:  # noqa: S310
2026-11-13T00:30:52.7666330Z             return response.status, json.loads(response.read().decode("utf-8"))
2026-11-13T00:30:52.7666773Z     except urllib.error.HTTPError as exc:
2026-11-13T00:30:52.7667046Z         body = b"{}"
2026-11-13T00:30:52.7667248Z         try:
2026-11-13T00:30:52.7667441Z             body = exc.read()
2026-11-13T00:30:52.7667696Z         except Exception:  # pragma: no cover
2026-11-13T00:30:52.7667965Z             pass
2026-11-13T00:30:52.7668154Z         try:
2026-11-13T00:30:52.7668397Z             return exc.code, json.loads(body.decode("utf-8"))
2026-11-13T00:30:52.7668718Z         except Exception:
2026-11-13T00:30:52.7668960Z             return exc.code, {}
2026-11-13T00:30:52.7669114Z 
2026-11-13T00:30:52.7669117Z 
2026-11-13T00:30:52.7669371Z def observe_run(run_id: int | str, repo: str = DEFAULT_REPO, fetch: Fetch = http_fetch) -> dict:
2026-11-13T00:30:52.7669871Z     """Return the verbatim REST snapshot of one Actions run."""
2026-11-13T00:30:52.7670304Z     url = f"https://api.github.com/repos/{repo}/actions/runs/{run_id}"
2026-11-13T00:30:52.7670668Z     status, payload = fetch(url)
2026-11-13T00:30:52.7670909Z     if status == 404:
2026-11-13T00:30:52.7671211Z         raise RunNotFound(f"run {run_id} is not resolvable (HTTP 404)")
2026-11-13T00:30:52.7671563Z     if status != 200:
2026-11-13T00:30:52.7671896Z         raise RuntimeError(f"GitHub API returned HTTP {status} for run {run_id}")
2026-11-13T00:30:52.7672277Z     return {
2026-11-13T00:30:52.7672496Z         "run_id": int(payload.get("id") or run_id),
2026-11-13T00:30:52.7672800Z         "head_sha": payload.get("head_sha"),
2026-11-13T00:30:52.7673096Z         "head_branch": payload.get("head_branch"),
2026-11-13T00:30:52.7673389Z         "event": payload.get("event"),
2026-11-13T00:30:52.7673657Z         "status": payload.get("status"),
2026-11-13T00:30:52.7673937Z         "conclusion": payload.get("conclusion"),
2026-11-13T00:30:52.7674240Z         "created_at": payload.get("created_at"),
2026-11-13T00:30:52.7674537Z         "updated_at": payload.get("updated_at"),
2026-11-13T00:30:52.7674822Z         "name": payload.get("name"),
2026-11-13T00:30:52.7675363Z         "workflow": (payload.get("path") or (payload.get("workflow_url") or "").rsplit("/", 1)[-1]),
2026-11-13T00:30:52.7675787Z         "source": url,
2026-11-13T00:30:52.7675990Z     }
2026-11-13T00:30:52.7676273Z 
2026-11-13T00:30:52.7676277Z 
2026-11-13T00:30:52.7676546Z def observe_jobs(run_id: int | str, repo: str = DEFAULT_REPO, fetch: Fetch = http_fetch) -> dict:
2026-11-13T00:30:52.7677037Z     """Return ``{job name: conclusion}`` for one run's jobs.
2026-11-13T00:30:52.7677271Z 
2026-11-13T00:30:52.7677458Z     The v50 blocker was never the product work: the lane stalled because the
2026-11-13T00:30:52.7677933Z     audit job died on a misplaced gate file and ``integrate`` was skipped, so
2026-11-13T00:30:52.7678430Z     ``lab/product`` stopped advancing.  A green team job alone therefore does not
2026-11-13T00:30:52.7678930Z     tell a reader whether the promotion chain actually completed.  Recording the
2026-11-13T00:30:52.7679436Z     per-job conclusions makes that fact machine-checkable instead of narrative.
2026-11-13T00:30:52.7679933Z     A failure to read jobs (HTTP != 200) is never fatal: partial evidence must
2026-11-13T00:30:52.7680340Z     not block recording the run observation itself.
2026-11-13T00:30:52.7680868Z     """
2026-11-13T00:30:52.7681204Z     url = f"https://api.github.com/repos/{repo}/actions/runs/{run_id}/jobs?per_page=100"
2026-11-13T00:30:52.7681604Z     try:
2026-11-13T00:30:52.7681798Z         status, payload = fetch(url)
2026-11-13T00:30:52.7682158Z     except Exception:  # pragma: no cover - network resilience, never fatal
2026-11-13T00:30:52.7682518Z         return {}
2026-11-13T00:30:52.7682757Z     if status != 200 or not isinstance(payload, dict):
2026-11-13T00:30:52.7683042Z         return {}
2026-11-13T00:30:52.7683244Z     jobs: dict[str, Any] = {}
2026-11-13T00:30:52.7683496Z     for job in payload.get("jobs") or []:
2026-11-13T00:30:52.7683952Z         if isinstance(job, dict) and job.get("name"):
2026-11-13T00:30:52.7684295Z             jobs[str(job["name"])] = job.get("conclusion")
2026-11-13T00:30:52.7684590Z     return jobs
2026-11-13T00:30:52.7684710Z 
2026-11-13T00:30:52.7684713Z 
2026-11-13T00:30:52.7684952Z def find_summary(run_id: int | str, summary_dir: Path = DEFAULT_SUMMARY_DIR) -> Path | None:
2026-11-13T00:30:52.7685423Z     path = Path(summary_dir) / f"summary_ci_{run_id}.json"
2026-11-13T00:30:52.7685746Z     return path if path.is_file() else None
2026-11-13T00:30:52.7685929Z 
2026-11-13T00:30:52.7685932Z 
2026-11-13T00:30:52.7686223Z def load_summary(path: Path | None) -> dict:
2026-11-13T00:30:52.7686578Z     if path is None:
2026-11-13T00:30:52.7686783Z         return {}
2026-11-13T00:30:52.7686965Z     try:
2026-11-13T00:30:52.7687218Z         return json.loads(Path(path).read_text(encoding="utf-8"))
2026-11-13T00:30:52.7687569Z     except (OSError, json.JSONDecodeError):
2026-11-13T00:30:52.7687835Z         return {}
