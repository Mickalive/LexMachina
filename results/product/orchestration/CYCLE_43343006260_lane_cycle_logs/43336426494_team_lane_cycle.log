2026-11-13T00:48:56.3406487Z def _seconds_between(start: str | None, end: str | None) -> float | None:
2026-11-13T00:48:56.3406878Z     if not start or not end:
2026-11-13T00:48:56.3407115Z         return None
2026-11-13T00:48:56.3407329Z     fmt = "%Y-%m-%dT%H:%M:%SZ"
2026-11-13T00:48:56.3407709Z     return round((datetime.strptime(end, fmt) - datetime.strptime(start, fmt))
2026-11-13T00:48:56.3408126Z                  .total_seconds(), 1)
