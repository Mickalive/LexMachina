2026-11-13T00:30:15.7314126Z #!/usr/bin/env python3
2026-11-13T00:30:15.7314417Z """Audit-ready diagnosis of an operational-resume snapshot.
2026-11-13T00:30:15.7314668Z 
2026-11-13T00:30:15.7314870Z An operational resume starts from a *persisted producer snapshot* after a
2026-11-13T00:30:15.7315350Z failed workflow.  Two independent questions must be answered before the
2026-11-13T00:30:15.7315976Z snapshot can be handed to an auditor:
2026-11-13T00:30:15.7316463Z 
2026-11-13T00:30:15.7316655Z 1. **Why did the run stop before a gate?** - answered from the committed
2026-11-13T00:30:15.7317142Z    public run/jobs snapshot by :mod:`product.audit_step_diagnosis` (no token,
2026-11-13T00:30:15.7317540Z    no job logs, no invented mechanism).
2026-11-13T00:30:15.7317914Z 2. **Does the persisted snapshot carry a durable delta at all?** - answered
2026-11-13T00:30:15.7318378Z    from git refs alone.  A snapshot equal to its predecessor's commit is
2026-11-13T00:30:15.7318817Z    ``ZERO_DURABLE_DELTA``: the workflow's ``if: always()`` persist step
2026-11-13T00:30:15.7319273Z    published the unchanged tree after the failed producer step, so the ref
2026-11-13T00:30:15.7319654Z    exists but proves no work.
2026-11-13T00:30:15.7319812Z 
2026-11-13T00:30:15.7319991Z The module also records, read-only, whether this run has either half of
2026-11-13T00:30:15.7320487Z factory-wide requirement 4 (an independent audit gate and an accept commit),
2026-11-13T00:30:15.7320987Z and whether the producer wrote anything into the auditor namespace.  It never
2026-11-13T00:30:15.7321470Z writes ``results/audit/**``, never mints a gate, and never labels a run
2026-11-13T00:30:15.7321823Z accepted or rejected.
2026-11-13T00:30:15.7321963Z 
2026-11-13T00:30:15.7322038Z Usage
2026-11-13T00:30:15.7322212Z -----
2026-11-13T00:30:15.7322436Z     python3 product/resume_snapshot_diagnosis.py \\
2026-11-13T00:30:15.7322825Z         --run-id 40193974025 --predecessor-run-id 40188639817 \\
2026-11-13T00:30:15.7323287Z         --raw results/product/orchestration/CYCLE_40193974025_team_step_raw.json \\
2026-11-13T00:30:15.7323805Z         --out results/product/orchestration/CYCLE_40193974025_resume_diagnosis.json
2026-11-13T00:30:15.7324109Z 
2026-11-13T00:30:15.7324319Z When no public run/jobs snapshot was captured for the resumed run (for example
2026-11-13T00:30:15.7324834Z an operational resume dispatched straight from a failed run whose logs are not
2026-11-13T00:30:15.7325345Z reachable from the producer environment), omit ``--raw``: the instrument then
2026-11-13T00:30:15.7326006Z records ``RAW_SNAPSHOT_UNAVAILABLE`` / ``mechanism_unobserved`` instead of
2026-11-13T00:30:15.7326839Z inventing a cause, while still proving the durable-delta fact from git refs.
2026-11-13T00:30:15.7327338Z ``--predecessor-ref`` (default ``origin/lab/product``) compares the snapshot
2026-11-13T00:30:15.7327824Z against the accepted head the failed run was dispatched from, which is the
2026-11-13T00:30:15.7328314Z right delta baseline for a resume run: comparing against the previous *team*
2026-11-13T00:30:15.7328832Z ref would count the accepted audit commit as if the failed run had produced it.
2026-11-13T00:30:15.7329169Z 
2026-11-13T00:30:15.7329359Z Refs must already be available locally (the workflow fetches ``main``,
2026-11-13T00:30:15.7329819Z ``lab/<lane>`` and the team ref).  The instrument never fetches, so an
2026-11-13T00:30:15.7330293Z offline reproduction is honest about a missing ref instead of silently
2026-11-13T00:30:15.7330676Z reaching the network.
2026-11-13T00:30:15.7330891Z """
2026-11-13T00:30:15.7331084Z from __future__ import annotations
2026-11-13T00:30:15.7331255Z 
2026-11-13T00:30:15.7331340Z import argparse
2026-11-13T00:30:15.7331532Z import json
2026-11-13T00:30:15.7331715Z import re
2026-11-13T00:30:15.7331900Z import subprocess
2026-11-13T00:30:15.7332099Z import sys
2026-11-13T00:30:15.7332305Z from datetime import datetime, timezone
2026-11-13T00:30:15.7332591Z from pathlib import Path
2026-11-13T00:30:15.7332820Z from typing import Any
2026-11-13T00:30:15.7332958Z 
2026-11-13T00:30:15.7333076Z REPO_ROOT = Path(__file__).resolve().parents[1]
2026-11-13T00:30:15.7333390Z if str(REPO_ROOT) not in sys.path:
2026-11-13T00:30:15.7333660Z     sys.path.insert(0, str(REPO_ROOT))
2026-11-13T00:30:15.7333842Z 
2026-11-13T00:30:15.7334009Z from product import audit_step_diagnosis as asd  # noqa: E402
2026-11-13T00:30:15.7334530Z from product import query_env  # noqa: E402
2026-11-13T00:30:15.7334902Z from product import resume_chain_diagnosis as rcd  # noqa: E402
2026-11-13T00:30:15.7335178Z 
2026-11-13T00:30:15.7335304Z SCHEMA = "product-resume-snapshot-diagnosis/1"
2026-11-13T00:30:15.7335619Z ACCEPTED_REF = "origin/lab/product"
2026-11-13T00:30:15.7335800Z 
2026-11-13T00:30:15.7335803Z 
2026-11-13T00:30:15.7335942Z def _git(*args: str) -> subprocess.CompletedProcess:
2026-11-13T00:30:15.7336587Z     return subprocess.run(["git", *args], cwd=str(REPO_ROOT),
2026-11-13T00:30:15.7336953Z                           capture_output=True, text=True)
2026-11-13T00:30:15.7337161Z 
2026-11-13T00:30:15.7337165Z 
2026-11-13T00:30:15.7337264Z def _rev(ref: str) -> str | None:
2026-11-13T00:30:15.7337555Z     p = _git("rev-parse", "--verify", "--quiet", ref)
2026-11-13T00:30:15.7337867Z     if p.returncode != 0:
2026-11-13T00:30:15.7338097Z         return None
2026-11-13T00:30:15.7338318Z     return p.stdout.strip() or None
2026-11-13T00:30:15.7338502Z 
2026-11-13T00:30:15.7338506Z 
2026-11-13T00:30:15.7338698Z def _delta(snapshot_ref: str, predecessor_ref: str) -> dict[str, Any]:
