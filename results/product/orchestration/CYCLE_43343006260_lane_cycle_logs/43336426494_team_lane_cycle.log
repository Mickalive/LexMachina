2026-11-13T00:50:32.3931788Z #!/usr/bin/env python3
2026-11-13T00:50:32.3932372Z """Parse committed core-lane job logs into machine-checkable failure evidence.
2026-11-13T00:50:32.3932909Z 
2026-11-13T00:50:32.3933179Z Why this module exists (operational resume of run 40263483436)
2026-11-13T00:50:32.3933854Z ---------------------------------------------------------------
2026-11-13T00:50:32.3934427Z Every earlier resume in this chain had to publish
2026-11-13T00:50:32.3934872Z ``mechanism.status = "UNOBSERVED"`` because the GitHub job-log endpoint answers
2026-11-13T00:50:32.3935418Z **403** to unauthenticated callers (``logs_endpoint_status: 403`` in the
2026-11-13T00:50:32.3935969Z committed run/jobs snapshots, asserted by ``test_cycle_40193974025``).  Inside
2026-11-13T00:50:32.3936792Z an Actions run the runner's own persisted git-credentials token **can** read
2026-11-13T00:50:32.3937311Z those logs (HTTP 200), so during run 40263666190 the three failed predecessor
2026-11-13T00:50:32.3937772Z runs' ``Run lane cycle`` logs were fetched and committed under
2026-11-13T00:50:32.3938223Z ``results/product/orchestration/CYCLE_40263666190_lane_cycle_logs/``.
2026-11-13T00:50:32.3938539Z 
2026-11-13T00:50:32.3938760Z That turns the chain's cause from prose into evidence.  Two *distinct* death
2026-11-13T00:50:32.3939304Z classes are visible in those bytes, and conflating them would mis-aim the
2026-11-13T00:50:32.3939707Z repair:
2026-11-13T00:50:32.3939822Z 
2026-11-13T00:50:32.3940048Z * ``MODEL_UPSTREAM_REJECTED_REQUEST_PARAMETER`` - the model pool selected a
2026-11-13T00:50:32.3940825Z   free model whose upstream rejects a request argument OpenCode sends
2026-11-13T00:50:32.3941377Z   (``[unsupported_parameter] ... permissions``).  The wrapper classifies it as
2026-11-13T00:50:32.3941950Z   non-transient and exits without retrying, so the agent never starts.  Control
2026-11-13T00:50:32.3942521Z   plane: model-health probe does not reproduce the real agent request shape.
2026-11-13T00:50:32.3943078Z * ``AGENT_FINISHED_ZERO_DURABLE_DELTA`` - the agent ran, hit the fresh-runner
2026-11-13T00:50:32.3943627Z   validation cascade (missing numpy/sklearn, absent legacy map data), and
2026-11-13T00:50:32.3944127Z   exited 0 with a clean tree, so the wrapper's delta guard fired
2026-11-13T00:50:32.3944619Z   (``LEX_ZERO_DELTA_REPAIR``, exit 67).  Product: the lane's own instruments
2026-11-13T00:50:32.3945043Z   self-heal on a fresh runner.
2026-11-13T00:50:32.3945221Z 
2026-11-13T00:50:32.3945312Z Design notes
2026-11-13T00:50:32.3945512Z ------------
2026-11-13T00:50:32.3945843Z * ``parse_lane_cycle_log`` is a **pure function** of log text: no network, no
2026-11-13T00:50:32.3946767Z   git, no state.  The committed logs are the input, so the evidence JSON and
2026-11-13T00:50:32.3947275Z   the cycle test re-derive the same numbers from the same bytes.
2026-11-13T00:50:32.3947773Z * Nothing here writes a gate, labels a run, or edits ``.github/**`` (control
2026-11-13T00:50:32.3948310Z   plane, never edited from this lane).  It names control-plane items for the
2026-11-13T00:50:32.3948729Z   director instead.
2026-11-13T00:50:32.3949081Z * Logs are fetched once by hand inside a run that has the token; this module
2026-11-13T00:50:32.3949622Z   only **reads** the committed copies.  The fetch is recorded in the artifact
2026-11-13T00:50:32.3950104Z   (``fetched_via`` / ``logs_endpoint_status``) so a reader can tell observed
2026-11-13T00:50:32.3950507Z   evidence from an unobserved mechanism.
2026-11-13T00:50:32.3950695Z 
2026-11-13T00:50:32.3950766Z Usage
2026-11-13T00:50:32.3950943Z -----
2026-11-13T00:50:32.3951159Z     python3 product/lane_cycle_log_evidence.py \
2026-11-13T00:50:32.3951764Z         --logs-dir results/product/orchestration/CYCLE_40263666190_lane_cycle_logs \
2026-11-13T00:50:32.3952194Z         --run-ids 40262401687 40263308953 40263483436 \
2026-11-13T00:50:32.3952617Z         --out results/product/orchestration/CYCLE_40263666190_lane_cycle_log_evidence.json
2026-11-13T00:50:32.3953019Z """
2026-11-13T00:50:32.3953205Z from __future__ import annotations
2026-11-13T00:50:32.3953377Z 
2026-11-13T00:50:32.3953455Z import argparse
2026-11-13T00:50:32.3953646Z import hashlib
2026-11-13T00:50:32.3953828Z import json
2026-11-13T00:50:32.3954011Z import re
2026-11-13T00:50:32.3954210Z from datetime import datetime, timezone
2026-11-13T00:50:32.3954486Z from pathlib import Path
2026-11-13T00:50:32.3954707Z from typing import Any
2026-11-13T00:50:32.3954836Z 
2026-11-13T00:50:32.3954960Z SCHEMA = "product-lane-cycle-log-evidence/1"
2026-11-13T00:50:32.3955321Z DEFAULT_LOGS_DIR = Path("results/product/orchestration") / (
2026-11-13T00:50:32.3955665Z     "CYCLE_40263666190_lane_cycle_logs"
2026-11-13T00:50:32.3955918Z )
2026-11-13T00:50:32.3956014Z 
2026-11-13T00:50:32.3956335Z #: One pool line per attempt, e.g.
2026-11-13T00:50:32.3956692Z #: ``LEX_MODEL_POOL size=4 slot=core:product:v68:40263483436 requested=...
2026-11-13T00:50:32.3957081Z #:  selected=opencode/beam-free index=3``.
2026-11-13T00:50:32.3957346Z POOL_RE = re.compile(
2026-11-13T00:50:32.3957625Z     r"LEX_MODEL_POOL size=(?P<size>\d+) slot=(?P<slot>\S+) "
2026-11-13T00:50:32.3958065Z     r"requested=(?P<requested>\S+) selected=(?P<selected>\S+) index=(?P<index>\d+)"
2026-11-13T00:50:32.3958446Z )
2026-11-13T00:50:32.3958708Z EXIT_RE = re.compile(r"Process completed with exit code\s+(-?\d+)")
2026-11-13T00:50:32.3959062Z UPSTREAM_RE = re.compile(
2026-11-13T00:50:32.3959378Z     r"Upstream request failed: \[(?P<signature>[^\]]+)\]\s*(?P<detail>.*)"
2026-11-13T00:50:32.3959720Z )
2026-11-13T00:50:32.3960169Z MISSING_MODULE_RE = re.compile(r"No module named '([^']+)'")
2026-11-13T00:50:32.3960562Z ATTEMPT_RE = re.compile(r"LEX_OX_ATTEMPT=(\d+)/(\d+)")
2026-11-13T00:50:32.3962844Z ##[error]TEXT`` inside
2026-11-13T00:50:32.3963935Z #: the downloaded log.  Only those lines are the *run's own* verdicts: an agent
2026-11-13T00:50:32.3964475Z #: legitimately quotes older annotations (``"annotation":
2026-11-13T00:50:32.3964988Z #: "LEX_WORK_QUANTUM_EXPIRED seconds=2700 ..."``) while writing its diagnosis,
2026-11-13T00:50:32.3965549Z #: and honouring that quote would mislabel this run's cause.  The annotation
2026-11-13T00:50:32.3966029Z #: prefix is therefore what separates observation from quotation.
2026-11-13T00:50:32.3966675Z ANNOTATION_LINE_RE = re.compile(
2026-11-13T00:50:32.3966976Z     r"##\[(?P<level>error|warning|notice)\](?P<text>.*)"
2026-11-13T00:50:32.3967264Z )
2026-11-13T00:50:32.3967590Z # ``selected=`` is also echoed by resolve_model_args in some wrapper versions;
2026-11-13T00:50:32.3968112Z # the pool line above is the authoritative one.
2026-11-13T00:50:32.3968359Z 
2026-11-13T00:50:32.3968494Z CLASS_ZERO_DELTA = "AGENT_FINISHED_ZERO_DURABLE_DELTA"
2026-11-13T00:50:32.3968903Z CLASS_MODEL_PARAMETER = "MODEL_UPSTREAM_REJECTED_REQUEST_PARAMETER"
2026-11-13T00:50:32.3969291Z CLASS_QUANTUM = "WORK_QUANTUM_EXPIRED"
2026-11-13T00:50:32.3969606Z CLASS_UNCLASSIFIED = "UNCLASSIFIED_LANE_CYCLE_FAILURE"
2026-11-13T00:50:32.3969827Z 
2026-11-13T00:50:32.3969920Z CONTROL_PLANE_ITEMS = (
2026-11-13T00:50:32.3970132Z     {
2026-11-13T00:50:32.3970336Z         "item": "model_pool_probe_shape_gap",
2026-11-13T00:50:32.3970732Z         "owner": "control-plane (state/model_health.json + model-health workflow)",
2026-11-13T00:50:32.3971116Z         "detail": (
2026-11-13T00:50:32.3971419Z             "opencode/beam-free answers the health tool_probe with PASS but "
2026-11-13T00:50:32.3971813Z             "rejects the real agent request with "
2026-11-13T00:50:32.3972207Z             "[unsupported_parameter] Unrecognized request argument supplied: "
2026-11-13T00:50:32.3972672Z             "permissions, so a healthy-looking pool slot can still kill the "
2026-11-13T00:50:32.3973308Z             "lane before the agent starts. The probe must reproduce the agent "
2026-11-13T00:50:32.3973801Z             "request shape; model_health.json is workflow-owned and is "
2026-11-13T00:50:32.3974189Z             "recorded, never edited, from this lane."
2026-11-13T00:50:32.3974466Z         ),
2026-11-13T00:50:32.3974642Z     },
2026-11-13T00:50:32.3974813Z     {
2026-11-13T00:50:32.3975042Z         "item": "workflow_does_not_bootstrap_query_runtime",
2026-11-13T00:50:32.3975431Z         "owner": "control-plane (.github/workflows/core-lane.yml)",
2026-11-13T00:50:32.3975762Z         "detail": (
2026-11-13T00:50:32.3976244Z             "No workflow step installs product/requirements-query.txt before "
2026-11-13T00:50:32.3976770Z             "the agent starts, so a fresh runner begins with no numpy and no "
2026-11-13T00:50:32.3977168Z             "scikit-learn. The lane now self-heals from "
2026-11-13T00:50:32.3977563Z             "product/tests/conftest.py via product.query_env.ensure(); the "
2026-11-13T00:50:32.3978019Z             "missing workflow step remains recorded, never edited, from here."
2026-11-13T00:50:32.3978366Z         ),
2026-11-13T00:50:32.3978540Z     },
2026-11-13T00:50:32.3978717Z )
2026-11-13T00:50:32.3978888Z ====
2026-11-13T00:50:32.3979089Z         "observed_failure_classes": classes,
2026-11-13T00:50:32.3979434Z         "control_plane_items": [dict(i) for i in CONTROL_PLANE_ITEMS],
2026-11-13T00:50:32.3979767Z         "meaning": (
2026-11-13T00:50:32.3980080Z             "Observed evidence from committed job logs of three failed product "
2026-11-13T00:50:32.3980540Z             "runs. The two failure classes are control-plane/model-pool and "
2026-11-13T00:50:32.3980994Z             "fresh-runner-validation facts, not product verdicts: no gate is "
2026-11-13T00:50:32.3981577Z             "written, no run is labelled accepted or rejected, and no frozen "
2026-11-13T00:50:32.3981964Z             "bar, rubric or threshold is touched."
2026-11-13T00:50:32.3982239Z         ),
2026-11-13T00:50:32.3982425Z         "claim_ceiling": (
2026-11-13T00:50:32.3982744Z             "This artifact names why the producer step exited, from bytes the "
2026-11-13T00:50:32.3983184Z             "workflow itself printed. It asserts nothing about product "
2026-11-13T00:50:32.3983619Z             "quality, retrieval, answer, counter-authority or map utility."
2026-11-13T00:50:32.3983961Z         ),
2026-11-13T00:50:32.3984134Z     }
2026-11-13T00:50:32.3984236Z 
2026-11-13T00:50:32.3984240Z 
2026-11-13T00:50:32.3984357Z def main(argv: list[str] | None = None) -> int:
2026-11-13T00:50:32.3984741Z     ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
2026-11-13T00:50:32.3985164Z     ap.add_argument("--logs-dir", default=str(DEFAULT_LOGS_DIR))
2026-11-13T00:50:32.3985537Z     ap.add_argument("--run-ids", nargs="+", required=True)
2026-11-13T00:50:32.3985900Z     ap.add_argument("--resuming-run-id", required=True)
2026-11-13T00:50:32.3986461Z     ap.add_argument("--fetched-via", default=(
2026-11-13T00:50:32.3986831Z         "GitHub Actions job-log endpoint (HTTP 200) using the runner's "
2026-11-13T00:50:32.3987285Z         "persisted git-credentials token; downloaded during the resuming run"
