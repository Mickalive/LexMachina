2026-11-13T00:54:41.6673610Z def _orchestration_without_raw(raw_path: Path | None) -> dict[str, Any]:
2026-11-13T00:54:41.6674078Z     """Honest placeholder when no public run/jobs snapshot was captured.
2026-11-13T00:54:41.6674354Z 
2026-11-13T00:54:41.6674543Z     The missing artefact is recorded as such.  A git-ref delta and the absence
2026-11-13T00:54:41.6675020Z     of an audit half still prove a great deal, but they cannot name a provider,
2026-11-13T00:54:41.6675440Z     auth or quantum mechanism, so none is invented.
2026-11-13T00:54:41.6675725Z     """
2026-11-13T00:54:41.6675896Z     return {
2026-11-13T00:54:41.6676369Z         "schema": asd.SCHEMA,
2026-11-13T00:54:41.6676673Z         "classification": "RAW_SNAPSHOT_UNAVAILABLE",
2026-11-13T00:54:41.6676987Z         "mechanism_unobserved": True,
2026-11-13T00:54:41.6677327Z         "raw_snapshot": _repo_relative(raw_path) if raw_path else None,
2026-11-13T00:54:41.6677662Z         "meaning": (
2026-11-13T00:54:41.6677966Z             "No committed run/jobs snapshot exists for this failed run in the "
2026-11-13T00:54:41.6678427Z             "producer checkout (job logs require admin rights). The durable "
2026-11-13T00:54:41.6678875Z             "delta and the absent audit half are still proven from git refs; "
2026-11-13T00:54:41.6679299Z             "the provider/auth/timeout mechanism is NOT claimed."
2026-11-13T00:54:41.6679608Z         ),
2026-11-13T00:54:41.6679784Z     }
2026-11-13T00:54:41.6679886Z 
2026-11-13T00:54:41.6679889Z 
2026-11-13T00:54:41.6679969Z def run(
2026-11-13T00:54:41.6680283Z     run_id: str,
2026-11-13T00:54:41.6680497Z     predecessor_run_id: str = "",
2026-11-13T00:54:41.6680749Z     raw_path: Path | None = None,
2026-11-13T00:54:41.6680975Z     *,
2026-11-13T00:54:41.6681171Z     predecessor_ref: str | None = None,
2026-11-13T00:54:41.6681437Z ) -> dict[str, Any]:
2026-11-13T00:54:41.6681649Z     orchestration = (
2026-11-13T00:54:41.6681964Z         asd.classify(json.loads(Path(raw_path).read_text(encoding="utf-8")))
2026-11-13T00:54:41.6682340Z         if raw_path is not None
2026-11-13T00:54:41.6682611Z         else _orchestration_without_raw(None)
2026-11-13T00:54:41.6682874Z     )
2026-11-13T00:54:41.6683059Z     if predecessor_ref:
2026-11-13T00:54:41.6683398Z         delta = _delta(f"origin/cycle/core/product/{run_id}/team", predecessor_ref)
2026-11-13T00:54:41.6683799Z     elif predecessor_run_id:
2026-11-13T00:54:41.6684033Z         delta = _delta(
2026-11-13T00:54:41.6684280Z             f"origin/cycle/core/product/{run_id}/team",
2026-11-13T00:54:41.6684649Z             f"origin/cycle/core/product/{predecessor_run_id}/team",
2026-11-13T00:54:41.6684960Z         )
2026-11-13T00:54:41.6685134Z     else:
2026-11-13T00:54:41.6685418Z         delta = _delta(f"origin/cycle/core/product/{run_id}/team", ACCEPTED_REF)
2026-11-13T00:54:41.6685796Z     accept = _accept_commit(run_id)
2026-11-13T00:54:41.6686216Z     audit = _audit_half(run_id)
2026-11-13T00:54:41.6686510Z     accepted = bool(accept.get("accept_commit")) and bool(
2026-11-13T00:54:41.6686833Z         audit.get("gate_verdict") == "PASS"
