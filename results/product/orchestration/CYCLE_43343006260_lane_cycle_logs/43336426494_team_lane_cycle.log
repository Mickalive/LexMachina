2026-11-13T00:48:56.3405216Z def _step(job: dict, name: str) -> dict | None:
2026-11-13T00:48:56.3405648Z     return next((s for s in job.get("steps") or [] if s.get("name") == name), None)
2026-11-13T00:48:56.3405950Z 
