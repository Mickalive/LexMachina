2026-11-13T01:06:09.0820938Z def check_cycle_test(cycle_test: str) -> dict[str, Any]:
2026-11-13T01:06:09.0821639Z     """Run the cycle test the snapshot's own report claims it added.
2026-11-13T01:06:09.0822093Z 
2026-11-13T01:06:09.0822375Z     A report that names a test file that was never committed is an
2026-11-13T01:06:09.0823185Z     audit-readiness defect: the next auditor spends its quantum discovering
2026-11-13T01:06:09.0824012Z     the path is absent.  This check proves the path exists and the test is
2026-11-13T01:06:09.0824622Z     green on the snapshot's own bytes.
2026-11-13T01:06:09.0824891Z     """
2026-11-13T01:06:09.0825087Z     path = ROOT / cycle_test
2026-11-13T01:06:09.0825332Z     if not path.is_file():
2026-11-13T01:06:09.0825557Z         return _check(
2026-11-13T01:06:09.0825768Z             "cycle_test",
2026-11-13T01:06:09.0826296Z             f"Cycle test {cycle_test} exists and is green",
2026-11-13T01:06:09.0826815Z             False,
2026-11-13T01:06:09.0827253Z             {"path": cycle_test, "present": False},
2026-11-13T01:06:09.0827606Z             [cycle_test],
2026-11-13T01:06:09.0827820Z         )
2026-11-13T01:06:09.0828110Z     cmd = [sys.executable, "-m", "pytest", cycle_test, "-q", "--maxfail=1"]
2026-11-13T01:06:09.0828486Z     run = _run(cmd, 300)
2026-11-13T01:06:09.0828773Z     text = run["stdout_tail"] + "\n" + run["stderr_tail"]
2026-11-13T01:06:09.0829407Z     passed = int((_PASSED_RE.search(text) or [0, 0])[1] or 0)
2026-11-13T01:06:09.0829781Z     failed = int((_FAILED_RE.search(text) or [0, 0])[1] or 0)
2026-11-13T01:06:09.0830139Z     errors = int((_ERROR_RE.search(text) or [0, 0])[1] or 0)
2026-11-13T01:06:09.0830534Z     ok = run["exit_code"] == 0 and passed > 0 and failed == 0 and errors == 0
2026-11-13T01:06:09.0830881Z     return _check(
2026-11-13T01:06:09.0831078Z         "cycle_test",
2026-11-13T01:06:09.0831318Z         f"Cycle test {cycle_test} exists and is green",
2026-11-13T01:06:09.0831604Z         ok,
2026-11-13T01:06:09.0831848Z         {"path": cycle_test, "present": True, "passed": passed,
2026-11-13T01:06:09.0832178Z          "failed": failed, "errors": errors,
2026-11-13T01:06:09.0832451Z          "timed_out": run["timed_out"]},
2026-11-13T01:06:09.0832738Z         [cycle_test], run["command"], run["seconds"],
2026-11-13T01:06:09.0833015Z     )
