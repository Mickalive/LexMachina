2026-11-13T00:54:41.6687400Z     )
2026-11-13T00:54:41.6687591Z     record: dict[str, Any] = {
2026-11-13T00:54:41.6687822Z         "schema": SCHEMA,
2026-11-13T00:54:41.6688158Z         "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
2026-11-13T00:54:41.6688659Z         "run_id": run_id,
2026-11-13T00:54:41.6688907Z         "predecessor_run_id": predecessor_run_id,
2026-11-13T00:54:41.6689289Z         "raw_snapshot": _repo_relative(Path(raw_path)) if raw_path else None,
2026-11-13T00:54:41.6689664Z         "orchestration": orchestration,
2026-11-13T00:54:41.6689925Z         "durable_delta": delta,
2026-11-13T00:54:41.6690154Z         "adjudication": {
2026-11-13T00:54:41.6690371Z             "audit": audit,
2026-11-13T00:54:41.6690599Z             "accept": accept,
2026-11-13T00:54:41.6690829Z             "accepted": accepted,
2026-11-13T00:54:41.6691130Z             "status": "ACCEPTED" if accepted else "UNADJUDICATED",
2026-11-13T00:54:41.6691458Z             "product_defect": False,
2026-11-13T00:54:41.6691715Z             "verdict_written": False,
2026-11-13T00:54:41.6691966Z             "why_not_accepted": (
2026-11-13T00:54:41.6692207Z                 None if accepted else
2026-11-13T00:54:41.6692543Z                 "requirement 4 needs BOTH an independent PASS gate on the "
2026-11-13T00:54:41.6692979Z                 "audit ref AND an accept commit on lab/product; at least one "
2026-11-13T00:54:41.6693353Z                 "half is absent for this run"
2026-11-13T00:54:41.6693608Z             ),
2026-11-13T00:54:41.6693789Z         },
2026-11-13T00:54:41.6693996Z         "audit_namespace": _audit_namespace(),
2026-11-13T00:54:41.6694380Z         "validation_findings": _validation_findings(run_id, predecessor_run_id),
2026-11-13T00:54:41.6694760Z         "claim_ceiling": (
2026-11-13T00:54:41.6695078Z             "This artifact classifies an orchestration outcome and a git-ref "
2026-11-13T00:54:41.6695522Z             "delta. It writes no gate, labels no run accepted or rejected, "
2026-11-13T00:54:41.6695960Z             "asserts no cause the committed run/jobs snapshot cannot show, and "
2026-11-13T00:54:41.6696506Z             "makes no product, legal or serve claim."
2026-11-13T00:54:41.6696781Z         ),
2026-11-13T00:54:41.6696948Z     }
2026-11-13T00:54:41.6697132Z     if raw_path is None:
2026-11-13T00:54:41.6697459Z         # Only the raw-free mode needs to name the delta baseline; preserving
2026-11-13T00:54:41.6698066Z         # the historical raw-mode record byte shape keeps accepted cycle tests
2026-11-13T00:54:41.6698428Z         # reproducible.
2026-11-13T00:54:41.6698721Z         record["predecessor_ref"] = predecessor_ref or ACCEPTED_REF
2026-11-13T00:54:41.6699049Z     return record
