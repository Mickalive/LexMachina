2026-11-13T00:53:47.3100852Z def _validation_findings(run_id: str, predecessor_run_id: str) -> dict[str, Any]:
2026-11-13T00:53:47.3101752Z     """Reproduce the validation gaps that can stop a snapshot before its gate.
2026-11-13T00:53:47.3102264Z 
2026-11-13T00:53:47.3102595Z     This is deliberately narrow and offline.  It does not infer a provider
2026-11-13T00:53:47.3103396Z     mechanism; it records three checkable things a resume must repair:
2026-11-13T00:53:47.3103858Z 
2026-11-13T00:53:47.3104199Z     * a ``product/tests/test_cycle_*.py`` path the snapshot's own report claims
2026-11-13T00:53:47.3104873Z       but the snapshot did not commit;
2026-11-13T00:53:47.3105528Z     * an audit-readiness dossier produced with its mandatory re-runs skipped;
2026-11-13T00:53:47.3106572Z     * the pinned query runtime's presence on the machine that consumes the
2026-11-13T00:53:47.3107369Z       snapshot (the core-lane team job installs nothing, so a fresh runner
2026-11-13T00:53:47.3108291Z       fails with ModuleNotFoundError before any product claim can be tested).
2026-11-13T00:53:47.3108939Z     """
2026-11-13T00:53:47.3109244Z     candidates = [
2026-11-13T00:53:47.3109704Z         REPO_ROOT / "reports" / "product" / f"CYCLE_{run_id}.md",
2026-11-13T00:53:47.3110427Z         REPO_ROOT / "reports" / "product" / f"CYCLE_{predecessor_run_id}.md",
2026-11-13T00:53:47.3111024Z     ]
2026-11-13T00:53:47.3111367Z     claimed_tests: list[dict[str, Any]] = []
2026-11-13T00:53:47.3111839Z     seen: set[str] = set()
2026-11-13T00:53:47.3112246Z     for report in candidates:
2026-11-13T00:53:47.3112840Z         if not report.is_file():
2026-11-13T00:53:47.3113266Z             continue
2026-11-13T00:53:47.3113682Z         for rel in sorted(set(CYCLE_TEST_RE.findall(
2026-11-13T00:53:47.3114311Z                 report.read_text(encoding="utf-8", errors="replace")))):
2026-11-13T00:53:47.3114891Z             if rel in seen:
2026-11-13T00:53:47.3115265Z                 continue
2026-11-13T00:53:47.3115627Z             seen.add(rel)
2026-11-13T00:53:47.3116009Z             claimed_tests.append({
2026-11-13T00:53:47.3116592Z                 "path": rel,
2026-11-13T00:53:47.3117045Z                 "claimed_by_report": _repo_relative(report),
2026-11-13T00:53:47.3117610Z                 "present": (REPO_ROOT / rel).is_file(),
2026-11-13T00:53:47.3118099Z             })
