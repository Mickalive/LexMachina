2026-11-13T00:53:47.3080232Z def _fresh_runner_probe() -> dict[str, Any]:
2026-11-13T00:53:47.3080852Z     """Probe the query runtime with ``-S`` to reproduce a fresh runner.
2026-11-13T00:53:47.3081486Z 
2026-11-13T00:53:47.3081823Z     The core-lane team job installs nothing, so a fresh runner has neither
2026-11-13T00:53:47.3082632Z     numpy nor scikit-learn.  ``python -S`` skips the user site where the
2026-11-13T00:53:47.3083434Z     bootstrap installs them, which makes that validation gap reproducible
2026-11-13T00:53:47.3084116Z     without touching the current environment.
2026-11-13T00:53:47.3084581Z     """
2026-11-13T00:53:47.3084877Z     code = (
2026-11-13T00:53:47.3085217Z         "import json,sys;"
2026-11-13T00:53:47.3085621Z         "sys.path.insert(0, '.');"
2026-11-13T00:53:47.3086951Z         "from product import query_env;"
2026-11-13T00:53:47.3087586Z         "print(json.dumps(query_env.probe()))"
2026-11-13T00:53:47.3088082Z     )
2026-11-13T00:53:47.3088374Z     try:
2026-11-13T00:53:47.3088707Z         proc = subprocess.run(
2026-11-13T00:53:47.3089224Z             [sys.executable, "-S", "-c", code], cwd=str(REPO_ROOT),
2026-11-13T00:53:47.3089954Z             capture_output=True, text=True, timeout=60, check=False,
2026-11-13T00:53:47.3090520Z         )
2026-11-13T00:53:47.3091054Z     except (OSError, subprocess.SubprocessError) as exc:  # pragma: no cover
2026-11-13T00:53:47.3091843Z         return {"ok": None, "error": f"{type(exc).__name__}: {exc}"}
2026-11-13T00:53:47.3092412Z     probe: dict[str, Any] = {}
2026-11-13T00:53:47.3092829Z     if proc.stdout.strip():
2026-11-13T00:53:47.3093199Z         try:
2026-11-13T00:53:47.3093554Z             probe = json.loads(proc.stdout)
2026-11-13T00:53:47.3094034Z         except json.JSONDecodeError:
2026-11-13T00:53:47.3094462Z             probe = {}
2026-11-13T00:53:47.3094801Z     return {
2026-11-13T00:53:47.3095130Z         "ok": probe.get("ok"),
