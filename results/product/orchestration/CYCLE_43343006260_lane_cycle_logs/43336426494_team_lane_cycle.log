2026-11-13T00:53:00.4734945Z     # cycle (before its post-commit quantum expiry was observable); the
2026-11-13T00:53:00.4735395Z     # expiry itself is sourced from the resume diagnosis, which pins all
2026-11-13T00:53:00.4735749Z     # six mechanisms.
2026-11-13T00:53:00.4736019Z     assert "UNADJUDICATED" in hist["40272586794"]["summary"]
2026-11-13T00:53:00.4736602Z     assert "MODEL_GATEWAY" in hist["40276797027"]["status"]
2026-11-13T00:53:00.4736971Z     assert "ZERO_DURABLE_DELTA" in hist["40277000301"]["status"]
2026-11-13T00:53:00.4737343Z     assert "ZERO_DURABLE_DELTA" in hist["40278204862"]["status"]
2026-11-13T00:53:00.4737699Z     assert "QUANTUM" in hist["40278460732"]["status"]
