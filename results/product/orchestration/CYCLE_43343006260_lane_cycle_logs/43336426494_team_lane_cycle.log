2026-11-13T00:48:56.3403438Z AUDIT_STEP = "Independent audit"
2026-11-13T00:48:56.3404033Z QUANTUM_RE = re.compile(r"LEX_WORK_QUANTUM_EXPIRED\s+seconds=(\d+)")
2026-11-13T00:48:56.3404767Z EXIT_CODE_RE = re.compile(r"exit code\s+(\d+)", re.IGNORECASE)
