2026-11-13T00:53:37.7638227Z             "(workflow exits 69). Write the canonical state file, not a copy."
2026-11-13T00:53:37.7638579Z         )
2026-11-13T00:53:37.7638807Z     status = state.get("cycle_status", "INITIALIZED")
2026-11-13T00:53:37.7639115Z     if status == "INITIALIZED":
2026-11-13T00:53:37.7639504Z         return False, f"{state_path}: cycle_status is still INITIALIZED (workflow exits 69)"
2026-11-13T00:53:37.7639915Z     return True, (
2026-11-13T00:53:37.7640317Z         f"{state_path}: direction_version={actual_dirv}, cycle_status={status!r} -> workflow step passes"
2026-11-13T00:53:37.7640792Z     )
