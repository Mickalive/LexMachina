2026-11-13T00:34:30.8942517Z #!/usr/bin/env bash
2026-11-13T00:34:30.8942969Z set -uo pipefail
2026-11-13T00:34:30.8943106Z 
2026-11-13T00:34:30.8943324Z # Bootstrap invariant: persistent lab/cycle branches never execute an obsolete
2026-11-13T00:34:30.8943836Z # launcher. Re-exec the exact current wrapper from main when it differs.
2026-11-13T00:34:30.8944227Z if [[ "${LEX_WRAPPER_REEXEC:-0}" != "1" ]]; then
2026-11-13T00:34:30.8944525Z   LATEST_WRAPPER="$(mktemp)"
2026-11-13T00:34:30.8945099Z   if git fetch -q origin main 2>/dev/null && git show origin/main:.github/scripts/run-ox-with-retry.sh > "$LATEST_WRAPPER" 2>/dev/null; then
2026-11-13T00:34:30.8945713Z     if ! cmp -s "$0" "$LATEST_WRAPPER"; then
2026-11-13T00:34:30.8945996Z       chmod +x "$LATEST_WRAPPER"
2026-11-13T00:34:30.8946644Z       export LEX_WRAPPER_REEXEC=1
2026-11-13T00:34:30.8946910Z       exec bash "$LATEST_WRAPPER" "$@"
2026-11-13T00:34:30.8947157Z     fi
2026-11-13T00:34:30.8947330Z   fi
2026-11-13T00:34:30.8947523Z   rm -f "$LATEST_WRAPPER"
2026-11-13T00:34:30.8947751Z fi
2026-11-13T00:34:30.8947858Z 
2026-11-13T00:34:30.8947998Z REAL="${OPENCODE_BIN:-$HOME/.opencode/bin/opencode}"
2026-11-13T00:34:30.8948321Z MAX_ATTEMPTS="${OX_MAX_ATTEMPTS:-8}"
2026-11-13T00:34:30.8948596Z RETRY_DELAY="${OX_RETRY_DELAY_SECONDS:-90}"
2026-11-13T00:34:30.8948907Z STALL_SECONDS="${OX_NETWORK_STALL_SECONDS:-420}"
