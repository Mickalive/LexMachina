2026-11-13T00:49:59.7788301Z # Active profile; empty means "the module constants above" (the original
2026-11-13T00:49:59.7789020Z # pinned run).  Set by run()/select_profile() only.
2026-11-13T00:49:59.7789656Z PROFILE: dict[str, Any] = {}
2026-11-13T00:49:59.7789927Z 
2026-11-13T00:49:59.7789933Z 
2026-11-13T00:49:59.7790153Z def select_profile(run_id: str) -> dict[str, Any]:
2026-11-13T00:49:59.7790821Z     """Resolve the dossier profile for ``run_id`` (aliases are followed).
2026-11-13T00:49:59.7791312Z 
2026-11-13T00:49:59.7791638Z     A dossier for the wrong run is worse than no dossier: it would re-derive
2026-11-13T00:49:59.7792440Z     another run's claims and label them with this run's id.  Unknown run ids
2026-11-13T00:49:59.7793284Z     therefore fail closed instead of silently inheriting the default profile.
2026-11-13T00:49:59.7793925Z     """
2026-11-13T00:49:59.7794215Z     key = str(run_id)
2026-11-13T00:49:59.7794581Z     prof = PROFILES.get(key)
2026-11-13T00:49:59.7795071Z     while isinstance(prof, dict) and "alias_of" in prof:
2026-11-13T00:49:59.7795621Z         prof = PROFILES.get(str(prof["alias_of"]))
2026-11-13T00:49:59.7796478Z     if prof is None:
2026-11-13T00:49:59.7796837Z         raise SystemExit(
2026-11-13T00:49:59.7797377Z             f"no audit-readiness profile for run {key}; refusing to fall back "
2026-11-13T00:49:59.7798157Z             f"to {DEFAULT_PROFILE_KEY} and publish another run's claims")
2026-11-13T00:49:59.7798731Z     return dict(prof)
2026-11-13T00:49:59.7798945Z 
2026-11-13T00:49:59.7798950Z 
2026-11-13T00:49:59.7799160Z def p(field: str, default: Any = None) -> Any:
2026-11-13T00:49:59.7799794Z     """Profile field with a fallback to the pinned module constants."""
2026-11-13T00:49:59.7800409Z     if field in PROFILE:
2026-11-13T00:49:59.7800794Z         return PROFILE[field]
2026-11-13T00:49:59.7801190Z     return default
2026-11-13T00:49:59.7801649Z 
2026-11-13T00:49:59.7801661Z 
2026-11-13T00:49:59.7801847Z def _report_paths() -> list[Path]:
2026-11-13T00:49:59.7802284Z     out = []
2026-11-13T00:49:59.7802704Z     for value in (p("inherited_report", INHERITED_REPORT),
2026-11-13T00:49:59.7803288Z                   p("current_report", CURRENT_REPORT)):
2026-11-13T00:49:59.7803773Z         if value is not None:
2026-11-13T00:49:59.7804177Z             out.append(Path(value))
2026-11-13T00:49:59.7804543Z     return out
2026-11-13T00:49:59.7804661Z 
