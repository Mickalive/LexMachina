2026-11-13T00:48:38.6235339Z #!/usr/bin/env python3
2026-11-13T00:48:38.6235851Z """Audit-ready diagnosis of an operational-resume snapshot.
2026-11-13T00:48:38.6236507Z 
2026-11-13T00:48:38.6236794Z An operational resume starts from a *persisted producer snapshot* after a
2026-11-13T00:48:38.6237556Z failed workflow.  Two independent questions must be answered before the
2026-11-13T00:48:38.6238105Z snapshot can be handed to an auditor:
2026-11-13T00:48:38.6238434Z 
2026-11-13T00:48:38.6238731Z 1. **Why did the run stop before a gate?** - answered from the committed
2026-11-13T00:48:38.6239429Z    public run/jobs snapshot by :mod:`product.audit_step_diagnosis` (no token,
2026-11-13T00:48:38.6239904Z    no job logs, no invented mechanism).
2026-11-13T00:48:38.6240535Z 2. **Does the persisted snapshot carry a durable delta at all?** - answered
2026-11-13T00:48:38.6241152Z    from git refs alone.  A snapshot equal to its predecessor's commit is
2026-11-13T00:48:38.6241591Z    ``ZERO_DURABLE_DELTA``: the workflow's ``if: always()`` persist step
2026-11-13T00:48:38.6242072Z    published the unchanged tree after the failed producer step, so the ref
2026-11-13T00:48:38.6242476Z    exists but proves no work.
2026-11-13T00:48:38.6242634Z 
2026-11-13T00:48:38.6242832Z The module also records, read-only, whether this run has either half of
2026-11-13T00:48:38.6243320Z factory-wide requirement 4 (an independent audit gate and an accept commit),
2026-11-13T00:48:38.6243840Z and whether the producer wrote anything into the auditor namespace.  It never
2026-11-13T00:48:38.6244316Z writes ``results/audit/**``, never mints a gate, and never labels a run
2026-11-13T00:48:38.6244669Z accepted or rejected.
2026-11-13T00:48:38.6244815Z 
2026-11-13T00:48:38.6244891Z Usage
2026-11-13T00:48:38.6245068Z -----
2026-11-13T00:48:38.6245304Z     python3 product/resume_snapshot_diagnosis.py \\
2026-11-13T00:48:38.6245679Z         --run-id 40193974025 --predecessor-run-id 40188639817 \\
2026-11-13T00:48:38.6246410Z         --raw results/product/orchestration/CYCLE_40193974025_team_step_raw.json \\
2026-11-13T00:48:38.6246977Z         --out results/product/orchestration/CYCLE_40193974025_resume_diagnosis.json
2026-11-13T00:48:38.6247285Z 
2026-11-13T00:48:38.6247497Z When no public run/jobs snapshot was captured for the resumed run (for example
2026-11-13T00:48:38.6248028Z an operational resume dispatched straight from a failed run whose logs are not
2026-11-13T00:48:38.6248836Z reachable from the producer environment), omit ``--raw``: the instrument then
2026-11-13T00:48:38.6249340Z records ``RAW_SNAPSHOT_UNAVAILABLE`` / ``mechanism_unobserved`` instead of
2026-11-13T00:48:38.6249838Z inventing a cause, while still proving the durable-delta fact from git refs.
2026-11-13T00:48:38.6250326Z ``--predecessor-ref`` (default ``origin/lab/product``) compares the snapshot
2026-11-13T00:48:38.6250814Z against the accepted head the failed run was dispatched from, which is the
2026-11-13T00:48:38.6251301Z right delta baseline for a resume run: comparing against the previous *team*
2026-11-13T00:48:38.6251800Z ref would count the accepted audit commit as if the failed run had produced it.
2026-11-13T00:48:38.6252109Z 
2026-11-13T00:48:38.6252288Z Refs must already be available locally (the workflow fetches ``main``,
2026-11-13T00:48:38.6252727Z ``lab/<lane>`` and the team ref).  The instrument never fetches, so an
2026-11-13T00:48:38.6253165Z offline reproduction is honest about a missing ref instead of silently
2026-11-13T00:48:38.6253701Z reaching the network.
2026-11-13T00:48:38.6253911Z """
2026-11-13T00:48:38.6254103Z from __future__ import annotations
2026-11-13T00:48:38.6254267Z 
2026-11-13T00:48:38.6254353Z import argparse
2026-11-13T00:48:38.6254543Z import json
2026-11-13T00:48:38.6254726Z import re
2026-11-13T00:48:38.6254908Z import subprocess
2026-11-13T00:48:38.6255101Z import sys
2026-11-13T00:48:38.6255309Z from datetime import datetime, timezone
2026-11-13T00:48:38.6255590Z from pathlib import Path
2026-11-13T00:48:38.6255822Z from typing import Any
2026-11-13T00:48:38.6255961Z 
2026-11-13T00:48:38.6256274Z REPO_ROOT = Path(__file__).resolve().parents[1]
2026-11-13T00:48:38.6256584Z if str(REPO_ROOT) not in sys.path:
2026-11-13T00:48:38.6256857Z     sys.path.insert(0, str(REPO_ROOT))
2026-11-13T00:48:38.6257030Z 
2026-11-13T00:48:38.6257334Z from product import audit_step_diagnosis as asd  # noqa: E402
2026-11-13T00:48:38.6257693Z from product import query_env  # noqa: E402
2026-11-13T00:48:38.6258053Z from product import resume_chain_diagnosis as rcd  # noqa: E402
2026-11-13T00:48:38.6258328Z 
2026-11-13T00:48:38.6258455Z SCHEMA = "product-resume-snapshot-diagnosis/1"
2026-11-13T00:48:38.6258766Z ACCEPTED_REF = "origin/lab/product"
2026-11-13T00:48:38.6258933Z 
2026-11-13T00:48:38.6258937Z 
2026-11-13T00:48:38.6259077Z def _git(*args: str) -> subprocess.CompletedProcess:
2026-11-13T00:48:38.6259445Z     return subprocess.run(["git", *args], cwd=str(REPO_ROOT),
2026-11-13T00:48:38.6259797Z                           capture_output=True, text=True)
2026-11-13T00:48:38.6260003Z 
2026-11-13T00:48:38.6260006Z 
2026-11-13T00:48:38.6260100Z def _rev(ref: str) -> str | None:
2026-11-13T00:48:38.6260382Z     p = _git("rev-parse", "--verify", "--quiet", ref)
2026-11-13T00:48:38.6260679Z     if p.returncode != 0:
2026-11-13T00:48:38.6260899Z         return None
2026-11-13T00:48:38.6261121Z     return p.stdout.strip() or None
2026-11-13T00:48:38.6261287Z 
2026-11-13T00:48:38.6261295Z 
2026-11-13T00:48:38.6261482Z def _delta(snapshot_ref: str, predecessor_ref: str) -> dict[str, Any]:
2026-11-13T00:48:38.6261850Z     head = _rev(snapshot_ref)
2026-11-13T00:48:38.6262090Z     pred = _rev(predecessor_ref)
2026-11-13T00:48:38.6262332Z     out: dict[str, Any] = {
2026-11-13T00:48:38.6262572Z         "snapshot_ref": snapshot_ref,
2026-11-13T00:48:38.6262828Z         "snapshot_head": head,
2026-11-13T00:48:38.6263080Z         "predecessor_ref": predecessor_ref,
2026-11-13T00:48:38.6263355Z         "predecessor_head": pred,
2026-11-13T00:48:38.6263583Z     }
2026-11-13T00:48:38.6263780Z     if head is None or pred is None:
2026-11-13T00:48:38.6264047Z         out["classification"] = "REF_ABSENT"
2026-11-13T00:48:38.6264314Z         out["meaning"] = (
2026-11-13T00:48:38.6264624Z             "at least one ref is not available in this checkout, so the delta "
2026-11-13T00:48:38.6265080Z             "cannot be proven locally; this is UNREPRODUCED, never ZERO_DELTA "
2026-11-13T00:48:38.6265594Z             "and never a durable delta"
2026-11-13T00:48:38.6265840Z         )
2026-11-13T00:48:38.6266013Z         return out
2026-11-13T00:48:38.6266412Z     if head == pred:
2026-11-13T00:48:38.6266653Z         out["classification"] = "ZERO_DURABLE_DELTA"
2026-11-13T00:48:38.6266953Z         out["changed_files"] = 0
2026-11-13T00:48:38.6267211Z         out["changed_paths_sample"] = []
2026-11-13T00:48:38.6267476Z         out["meaning"] = (
2026-11-13T00:48:38.6267776Z             "the team ref points at the predecessor's exact commit: the "
2026-11-13T00:48:38.6268220Z             "producer added and changed nothing, and the always-run persist "
2026-11-13T00:48:38.6268680Z             "step published that unchanged tree. This is an orchestration "
2026-11-13T00:48:38.6269154Z             "outcome, NOT a product defect and NOT a verdict; refs alone cannot "
2026-11-13T00:48:38.6269597Z             "distinguish rc-67 zero-delta from a producer death."
2026-11-13T00:48:38.6269916Z         )
2026-11-13T00:48:38.6270106Z         return out
2026-11-13T00:48:38.6270402Z     paths = _git("diff", "--name-only", pred, head).stdout.splitlines()
2026-11-13T00:48:38.6270774Z     out["classification"] = "COMMITTED_DELTA"
2026-11-13T00:48:38.6271061Z     out["changed_files"] = len(paths)
2026-11-13T00:48:38.6271337Z     out["changed_paths_sample"] = paths[:20]
2026-11-13T00:48:38.6271609Z     out["meaning"] = (
2026-11-13T00:48:38.6271913Z         "the team ref carries a committed delta over its predecessor; the "
2026-11-13T00:48:38.6272324Z         "snapshot can be resumed and audited on its own bytes"
2026-11-13T00:48:38.6272632Z     )
2026-11-13T00:48:38.6272809Z     return out
2026-11-13T00:48:38.6272925Z 
