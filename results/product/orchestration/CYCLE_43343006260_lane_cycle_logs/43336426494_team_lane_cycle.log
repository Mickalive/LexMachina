2026-11-13T00:48:56.3408463Z def _job_annotations(snapshot: dict, job: dict) -> list[dict]:
2026-11-13T00:48:56.3408909Z     """Return the check-run annotations for ``job`` from a committed snapshot.
2026-11-13T00:48:56.3409205Z 
2026-11-13T00:48:56.3409407Z     Two layouts are accepted because the raw snapshots were captured by hand:
2026-11-13T00:48:56.3410139Z     ``snapshot["annotations"][<job id>]`` (what the workflow-adjacent fetcher
2026-11-13T00:48:56.3410611Z     writes) and a job-local ``job["annotations"]`` list.  Anything else is
2026-11-13T00:48:56.3410994Z     treated as "not captured", never guessed.
2026-11-13T00:48:56.3411267Z     """
2026-11-13T00:48:56.3411468Z     ann = snapshot.get("annotations")
2026-11-13T00:48:56.3411739Z     if isinstance(ann, dict):
2026-11-13T00:48:56.3412015Z         for key in (str(job.get("id")), job.get("id")):
2026-11-13T00:48:56.3412342Z             if key in ann and isinstance(ann[key], list):
2026-11-13T00:48:56.3412634Z                 return ann[key]
2026-11-13T00:48:56.3412875Z     job_ann = job.get("annotations")
2026-11-13T00:48:56.3413134Z     if isinstance(job_ann, list):
2026-11-13T00:48:56.3413373Z         return job_ann
2026-11-13T00:48:56.3413581Z     return []
2026-11-13T00:48:56.3413694Z 
2026-11-13T00:48:56.3413703Z 
2026-11-13T00:48:56.3413874Z def _failure_annotations(snapshot: dict, team: dict, audit: dict,
2026-11-13T00:48:56.3414299Z                          audit_step_failed: bool, failed_team_step: dict | None
2026-11-13T00:48:56.3414644Z                          ) -> dict:
2026-11-13T00:48:56.3415001Z     """Extract the *observable* failure annotations, if the snapshot has them.
2026-11-13T00:48:56.3415301Z 
2026-11-13T00:48:56.3415505Z     GitHub check-run annotations are public even when job logs require admin
2026-11-13T00:48:56.3415964Z     rights.  The workflow's own 45-minute agent wrapper announces
2026-11-13T00:48:56.3416672Z     ``LEX_WORK_QUANTUM_EXPIRED seconds=2700`` and exit code 78, so a quantum
2026-11-13T00:48:56.3417143Z     expiry can be stated as observed evidence instead of "mechanism unknown".
2026-11-13T00:48:56.3417511Z     """
2026-11-13T00:48:56.3417696Z     if audit_step_failed:
2026-11-13T00:48:56.3417934Z         job_name, job = AUDIT_JOB, audit
2026-11-13T00:48:56.3418390Z     elif failed_team_step is not None:
2026-11-13T00:48:56.3418664Z         job_name, job = TEAM_JOB, team
2026-11-13T00:48:56.3418909Z     else:
2026-11-13T00:48:56.3419099Z         job_name, job = None, {}
2026-11-13T00:48:56.3419330Z     messages = [
2026-11-13T00:48:56.3419535Z         str(a.get("message") or "")
2026-11-13T00:48:56.3419803Z         for a in _job_annotations(snapshot, job)
2026-11-13T00:48:56.3420093Z         if isinstance(a, dict)
2026-11-13T00:48:56.3420312Z     ]
2026-11-13T00:48:56.3420492Z     quantum_seconds = None
2026-11-13T00:48:56.3420710Z     exit_code = None
2026-11-13T00:48:56.3420920Z     quantum_message = None
2026-11-13T00:48:56.3421144Z     for message in messages:
2026-11-13T00:48:56.3421388Z         m = QUANTUM_RE.search(message)
2026-11-13T00:48:56.3421628Z         if m:
2026-11-13T00:48:56.3421833Z             quantum_seconds = int(m.group(1))
2026-11-13T00:48:56.3422117Z             quantum_message = message.strip()
2026-11-13T00:48:56.3422399Z         e = EXIT_CODE_RE.search(message)
2026-11-13T00:48:56.3422670Z         if e and exit_code is None:
2026-11-13T00:48:56.3422940Z             exit_code = int(e.group(1))
2026-11-13T00:48:56.3423196Z     return {
2026-11-13T00:48:56.3423381Z         "source": (
2026-11-13T00:48:56.3423669Z             "github_actions_check_run_annotations" if messages else "none"
2026-11-13T00:48:56.3424009Z         ),
2026-11-13T00:48:56.3424215Z         "annotations_available": bool(messages),
2026-11-13T00:48:56.3424492Z         "job": job_name,
2026-11-13T00:48:56.3424721Z         "exit_code": exit_code,
2026-11-13T00:48:56.3424989Z         "quantum_expired": quantum_seconds is not None,
2026-11-13T00:48:56.3425296Z         "quantum_seconds": quantum_seconds,
2026-11-13T00:48:56.3425568Z         "quantum_message": quantum_message,
2026-11-13T00:48:56.3425830Z         "messages": messages,
2026-11-13T00:48:56.3426190Z     }
2026-11-13T00:48:56.3426293Z 
