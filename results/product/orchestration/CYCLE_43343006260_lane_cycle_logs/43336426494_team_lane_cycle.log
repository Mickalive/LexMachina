2026-11-13T00:53:00.4739644Z     assert mech["40276797027"] == "MODEL_UPSTREAM_REJECTED_REQUEST_PARAMETER"
2026-11-13T00:53:00.4740089Z     assert mech["40277000301"] == "AGENT_FINISHED_ZERO_DURABLE_DELTA"
2026-11-13T00:53:00.4740496Z     assert mech["40278204862"] == "AGENT_FINISHED_ZERO_DURABLE_DELTA"
