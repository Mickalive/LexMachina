2026-11-13T00:53:37.7615658Z     Factory-wide requirement 4 is a conjunction: the accepted run must have a
2026-11-13T00:53:37.7616825Z     committed ``PASS``/``safe_to_integrate`` gate *and* an ``accept product
2026-11-13T00:53:37.7617342Z     cycle <run>`` commit.  Pinning a literal run id instead goes stale the
2026-11-13T00:53:37.7617826Z     moment a later cycle is accepted, which is the drift class historical
2026-11-13T00:53:37.7618205Z     cycle tests kept tripping over.
2026-11-13T00:53:37.7618451Z     """
2026-11-13T00:53:37.7618712Z     root = Path(repo_root) if repo_root is not None else REPO_ROOT
2026-11-13T00:53:37.7619105Z     pointer = str(state.get("accepted_run_id") or "")
2026-11-13T00:53:37.7619449Z     commit = str(state.get("accepted_commit") or "")
2026-11-13T00:53:37.7619737Z     out: dict = {
2026-11-13T00:53:37.7619946Z         "accepted_run_id": pointer,
2026-11-13T00:53:37.7620207Z         "accepted_commit": commit,
2026-11-13T00:53:37.7620479Z         "problems": [],
2026-11-13T00:53:37.7620691Z     }
2026-11-13T00:53:37.7620909Z     match = re.fullmatch(r"CYCLE_(\d+)", pointer)
2026-11-13T00:53:37.7621196Z     if not match:
2026-11-13T00:53:37.7621439Z         out["problems"].append("accepted_run_id_shape")
2026-11-13T00:53:37.7621741Z         return out
2026-11-13T00:53:37.7621950Z     run_id = match.group(1)
2026-11-13T00:53:37.7622257Z     gate_rel = f"results/audit/product/CYCLE_{run_id}_GATE.json"
2026-11-13T00:53:37.7622592Z     gate_path = root / gate_rel
2026-11-13T00:53:37.7622821Z     gate = None
2026-11-13T00:53:37.7623021Z     if gate_path.is_file():
2026-11-13T00:53:37.7623237Z         try:
2026-11-13T00:53:37.7623496Z             gate = json.loads(gate_path.read_text(encoding="utf-8"))
2026-11-13T00:53:37.7623856Z         except (OSError, json.JSONDecodeError):
2026-11-13T00:53:37.7624138Z             gate = None
2026-11-13T00:53:37.7624344Z     gate_ok = bool(
2026-11-13T00:53:37.7624561Z         gate and gate.get("gate") == "PASS"
2026-11-13T00:53:37.7624852Z         and gate.get("safe_to_integrate") is True
2026-11-13T00:53:37.7625128Z     )
2026-11-13T00:53:37.7625317Z     log = subprocess.run(
2026-11-13T00:53:37.7625558Z         ["git", "log", "--all", "--oneline",
2026-11-13T00:53:37.7625860Z          f"--grep=^accept product cycle {run_id}$"],
2026-11-13T00:53:37.7626798Z         cwd=str(root), capture_output=True, text=True, check=False,
2026-11-13T00:53:37.7627120Z     ).stdout
2026-11-13T00:53:37.7627319Z     accept_ok = run_id in log
2026-11-13T00:53:37.7627552Z     if not gate_ok:
2026-11-13T00:53:37.7627809Z         out["problems"].append("accepted_gate_not_PASS_safe")
2026-11-13T00:53:37.7628122Z     if not accept_ok:
2026-11-13T00:53:37.7628375Z         out["problems"].append("accept_commit_missing")
2026-11-13T00:53:37.7628664Z     if not commit:
2026-11-13T00:53:37.7628898Z         out["problems"].append("accepted_commit_empty")
2026-11-13T00:53:37.7629187Z     out.update({
2026-11-13T00:53:37.7629386Z         "gate": gate_rel,
2026-11-13T00:53:37.7629625Z         "gate_present": gate_path.is_file(),
2026-11-13T00:53:37.7629897Z         "gate_ok": gate_ok,
2026-11-13T00:53:37.7630142Z         "accept_commit_present": accept_ok,
2026-11-13T00:53:37.7630440Z         "accept_log_sample": log.splitlines()[:3],
2026-11-13T00:53:37.7630720Z     })
2026-11-13T00:53:37.7630896Z     return out
2026-11-13T00:53:37.7631013Z 
