2026-11-13T00:53:37.7634079Z 
2026-11-13T00:53:37.7634355Z     actual_dirv = state.get("direction_version", -1)
2026-11-13T00:53:37.7634773Z     if not isinstance(actual_dirv, int) or isinstance(actual_dirv, bool):
2026-11-13T00:53:37.7635233Z         # jq: (.direction_version // -1) == $dirv is false for any non-number.
2026-11-13T00:53:37.7635588Z         return False, (
