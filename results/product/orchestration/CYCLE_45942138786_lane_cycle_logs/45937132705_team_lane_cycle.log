2026-11-27T04:19:18.0935267Z     status(s.counts.decisions+" décisions restaurées"+(origin?" · "+origin:"")+(pending?" · traitements en cours…":""),"repris");
2026-11-27T04:19:18.0935677Z     if(pending)await advance();
2026-11-27T04:19:18.0935910Z     return true;
