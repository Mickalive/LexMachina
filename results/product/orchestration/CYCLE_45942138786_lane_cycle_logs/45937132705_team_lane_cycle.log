2026-11-27T04:22:50.5989487Z def _await_expand(run_id: str, limit_s: float = 900.0) -> None:
2026-11-27T04:22:50.5989999Z     """Block an enrich job until the background expansion of its run is done.
2026-11-27T04:22:50.5990334Z 
2026-11-27T04:22:50.5990559Z     The browser already runs the stages in order, but the API is public: an
2026-11-27T04:22:50.5991140Z     enrich started while expansion is still retrieving would answer from the
2026-11-27T04:22:50.5991936Z     partial first-page candidate set — exactly the candidates most likely to
2026-11-27T04:22:50.5992557Z     miss contrary authority found further out.  Bounded, so a wedged expansion
2026-11-27T04:22:50.5993068Z     can never hang generation forever.
2026-11-27T04:22:50.5993367Z     """
2026-11-27T04:22:50.5993600Z     deadline = _now() + limit_s
2026-11-27T04:22:50.5993880Z     while _now() < deadline:
2026-11-27T04:22:50.5994154Z         record = _get(run_id)
2026-11-27T04:22:50.5994441Z         if record is None:
2026-11-27T04:22:50.5994724Z             return
2026-11-27T04:22:50.5995039Z         if record["jobs"]["expand"]["status"] != "running":
2026-11-27T04:22:50.5995416Z             return
2026-11-27T04:22:50.5995667Z         time.sleep(0.25)
2026-11-27T04:22:50.5995840Z 
