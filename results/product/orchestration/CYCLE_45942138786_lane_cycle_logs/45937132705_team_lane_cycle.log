2026-11-27T04:19:18.0933309Z   if(saved.n)document.getElementById("n").value=saved.n;
2026-11-27T04:19:18.0933581Z   document.getElementById("run").disabled=true;
2026-11-27T04:19:18.0933803Z   try{
2026-11-27T04:19:18.0934049Z     const s=(await getJSON("/api/query/status?run_id="+encodeURIComponent(RUN_ID)));
2026-11-27T04:19:18.0934354Z     await fetchBundle();
