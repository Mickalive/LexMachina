2026-11-27T04:22:50.5959699Z             "top_n": top_n,
2026-11-27T04:22:50.5959965Z             "mode": mode,
2026-11-27T04:22:50.5960265Z             "bundle": bundle,
2026-11-27T04:22:50.5960548Z             "created_at": _now(),
2026-11-27T04:22:50.5960919Z             "jobs": {"expand": _job("expand"), "enrich": _job("enrich")},
2026-11-27T04:22:50.5961304Z         }
