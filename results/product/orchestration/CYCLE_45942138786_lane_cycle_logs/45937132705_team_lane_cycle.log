2026-11-27T04:18:27.6084965Z from .qmap import MapModel, build_map, fit_map_model
2026-11-27T04:18:27.6085237Z 
2026-11-27T04:18:27.6085486Z #: One upstream page is enough to draw a real map immediately.  The accepted
2026-11-27T04:18:27.6086008Z #: adapter returns at most ``page_size`` hits for it.
2026-11-27T04:18:27.6086369Z FIRST_PAGE_SIZE = 50
