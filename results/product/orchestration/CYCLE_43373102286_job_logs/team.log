2026-11-13T05:38:37.6195378Z #!/usr/bin/env python3
2026-11-13T05:38:37.6195680Z """Capture a public GitHub Actions run/jobs snapshot for an operational resume.
2026-11-13T05:38:37.6195929Z 
2026-11-13T05:38:37.6195997Z Why this exists
2026-11-13T05:38:37.6196166Z ---------------
2026-11-13T05:38:37.6196432Z Every operational resume of this lane has to answer "why did the previous run
2026-11-13T05:38:37.6196828Z stop before a gate?".  The answer has to come from a *committed* snapshot, not
2026-11-13T05:38:37.6197223Z from prose: the run record, every job, every step conclusion and duration, and
2026-11-13T05:38:37.6197604Z the check-run annotations.  Annotations are public even when job logs are not
2026-11-13T05:38:37.6197989Z (the logs endpoint answers HTTP 403 ``Must have admin rights to Repository``
2026-11-13T05:38:37.6198378Z for the runner's own ``actions: write`` token - observed on run 43357207555),
2026-11-13T05:38:37.6198900Z and they are what turns "mechanism unobserved" into an observed
2026-11-13T05:38:37.6199203Z ``LEX_WORK_QUANTUM_EXPIRED`` / ``exit code 78`` fact.
2026-11-13T05:38:37.6199380Z 
2026-11-13T05:38:37.6199543Z Logs are also reachable: the earlier ``HTTP 403 Must have admin rights to
2026-11-13T05:38:37.6199931Z Repository`` observation for this endpoint came from sending the checkout's
2026-11-13T05:38:37.6200317Z ``basic`` extraheader, not from the endpoint's policy.  With the ``token``
2026-11-13T05:38:37.6200708Z scheme and without forwarding credentials to the storage redirect the job log
2026-11-13T05:38:37.6201101Z downloads at HTTP 200, so this tool captures redacted logs as well - and the
2026-11-13T05:38:37.6201453Z ``logs_endpoint_status`` field then records 200, which is what
2026-11-13T05:38:37.6201809Z :func:`product.audit_step_diagnosis.classify` needs before it may say the
2026-11-13T05:38:37.6202306Z log-level cause is readable.
2026-11-13T05:38:37.6202430Z 
2026-11-13T05:38:37.6202504Z What it does
2026-11-13T05:38:37.6202664Z ------------
2026-11-13T05:38:37.6202899Z * reads credentials from the checkout's own git HTTP extraheader (or
2026-11-13T05:38:37.6203250Z   ``GITHUB_TOKEN`` / ``GH_TOKEN``); the token is used for the request and is
2026-11-13T05:38:37.6203541Z   NEVER written to the artifact;
2026-11-13T05:38:37.6203824Z * fetches the run, its jobs (with per-step conclusions and timestamps) and the
2026-11-13T05:38:37.6204133Z   check-run annotations for every job;
2026-11-13T05:38:37.6204435Z * probes the job-logs endpoint and records only the HTTP status code, because
2026-11-13T05:38:37.6204840Z   "logs downloadable: yes/no" changes how :func:`product.audit_step_diagnosis.classify`
2026-11-13T05:38:37.6205166Z   words its mechanism claim;
2026-11-13T05:38:37.6205442Z * fails closed: a non-2xx API answer raises instead of writing a half-empty
2026-11-13T05:38:37.6205751Z   snapshot that later looks like evidence.
2026-11-13T05:38:37.6205908Z 
2026-11-13T05:38:37.6205972Z Usage
2026-11-13T05:38:37.6206123Z -----
2026-11-13T05:38:37.6206352Z     python3 product/fetch_run_jobs_snapshot.py --run-id 43357207555 \\
2026-11-13T05:38:37.6206658Z         --note "audit job died before a gate" \\
2026-11-13T05:38:37.6206979Z         --out results/product/orchestration/CYCLE_43357207555_run_jobs_raw.json
2026-11-13T05:38:37.6207269Z """
2026-11-13T05:38:37.6207430Z from __future__ import annotations
2026-11-13T05:38:37.6207563Z 
2026-11-13T05:38:37.6207641Z import argparse
2026-11-13T05:38:37.6207809Z import base64
2026-11-13T05:38:37.6207968Z import json
2026-11-13T05:38:37.6208120Z import os
2026-11-13T05:38:37.6209522Z import re
2026-11-13T05:38:37.6209689Z import subprocess
2026-11-13T05:38:37.6209853Z import sys
2026-11-13T05:38:37.6210013Z import urllib.error
2026-11-13T05:38:37.6210193Z import urllib.request
2026-11-13T05:38:37.6210383Z from datetime import datetime, timezone
2026-11-13T05:38:37.6210615Z from pathlib import Path
2026-11-13T05:38:37.6210806Z from typing import Any
2026-11-13T05:38:37.6210912Z 
2026-11-13T05:38:37.6211004Z ROOT = Path(__file__).resolve().parents[1]
2026-11-13T05:38:37.6211254Z SCHEMA = "github-actions-run-jobs-snapshot/1"
2026-11-13T05:38:37.6211585Z REPO_RE = re.compile(r"^https://api\.github\.com/repos/([^/]+)/([^/]+)")
2026-11-13T05:38:37.6211947Z FUZZY = 60  # seconds of clock skew tolerated between run and job timestamps
2026-11-13T05:38:37.6212164Z 
2026-11-13T05:38:37.6212167Z 
2026-11-13T05:38:37.6212242Z def repo_slug() -> str:
2026-11-13T05:38:37.6212521Z     """``owner/name`` from the checkout, so the tool is never pinned to one fork."""
2026-11-13T05:38:37.6212870Z     env = os.environ.get("GITHUB_REPOSITORY", "").strip()
2026-11-13T05:38:37.6213124Z     if env.count("/") == 1:
2026-11-13T05:38:37.6213305Z         return env
2026-11-13T05:38:37.6213536Z     url = _git("config", "--get", "remote.origin.url").stdout.strip()
2026-11-13T05:38:37.6213865Z     match = re.search(r"github\.com[:/]([^/]+/[^/.]+?)(?:\.git)?$", url)
2026-11-13T05:38:37.6214129Z     if match:
2026-11-13T05:38:37.6214299Z         return match.group(1)
2026-11-13T05:38:37.6214578Z     raise SystemExit(f"cannot determine the GitHub repository from {url!r}")
2026-11-13T05:38:37.6214800Z 
2026-11-13T05:38:37.6214803Z 
2026-11-13T05:38:37.6214919Z def _git(*args: str) -> subprocess.CompletedProcess:
2026-11-13T05:38:37.6215244Z     return subprocess.run(["git", *args], cwd=str(ROOT), capture_output=True,
2026-11-13T05:38:37.6215543Z                           text=True, check=False)
