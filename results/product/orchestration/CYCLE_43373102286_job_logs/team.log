2026-11-13T05:48:00.9011104Z def test_content_family_probe_reproduces_the_committed_artifact() -> None:
2026-11-13T05:48:00.9011678Z     fresh = cfp.run(run_id=RUN_ID, direction_version=DIRV)
2026-11-13T05:48:00.9012092Z     committed = _load(PROBE_ART)
2026-11-13T05:48:00.9012493Z     for rec, label in ((fresh, "fresh"), (committed, "committed")):
2026-11-13T05:48:00.9012950Z         totals = rec["fixed_path_family"]["totals"]
2026-11-13T05:48:00.9013309Z         hist = totals["defect_histogram"]
2026-11-13T05:48:00.9013575Z         assert hist["D2_letterhead_zone"] == 0, (label, hist)
2026-11-13T05:48:00.9014042Z         assert hist["D3_markup_residue"] == 0, (label, hist)
2026-11-13T05:48:00.9014559Z         assert hist["D4_language_marker_mismatch"] == 0, (label, hist)
2026-11-13T05:48:00.9015041Z         assert hist["D1_empty_evidence"] == 0, (label, hist)
2026-11-13T05:48:00.9015456Z         assert rec["false_reject_count"] == 0, label
2026-11-13T05:48:00.9015775Z         assert rec["ordered_work_2_success_rule"]["met"] is True, label
2026-11-13T05:48:00.9016173Z         assert rec["ordered_work_2_success_rule"]["confirmed_sound_row_still_verified"] is True
2026-11-13T05:48:00.9016529Z         assert totals["n_bundles"] >= 14, (label, totals)
2026-11-13T05:48:00.9016826Z         assert totals["n_decisions"] == totals["n_bundles"] * 100
2026-11-13T05:48:00.9017225Z     # Family-growth-aware agreement (amended by operational resume 40182739499,
2026-11-13T05:48:00.9017615Z     # same rationale as test_cycle_40168184617.py): later accepted-chain cycles
2026-11-13T05:48:00.9017985Z     # legitimately grow the probe's glob, so byte-for-byte totals comparison
2026-11-13T05:48:00.9018646Z     # against this cycle's own instrument breaks once the family grows.  The
2026-11-13T05:48:00.9019210Z     # claim that still must hold, and is checked exactly: the fresh probe
2026-11-13T05:48:00.9019577Z     # reproduces every historical bundle's histogram, the instrument's totals
2026-11-13T05:48:00.9019949Z     # equal the sums over THAT historical subset, and the family only grew.
2026-11-13T05:48:00.9020332Z     art_paths = {b["path"] for b in committed["fixed_path_family"]["bundles"]}
2026-11-13T05:48:00.9020697Z     fresh_by_path = {b["path"]: b for b in fresh["fixed_path_family"]["bundles"]}
2026-11-13T05:48:00.9021010Z     assert art_paths <= set(fresh_by_path), (
2026-11-13T05:48:00.9021248Z         art_paths - set(fresh_by_path))
2026-11-13T05:48:00.9021466Z     for path in art_paths:
2026-11-13T05:48:00.9021718Z         art_row = next(b for b in committed["fixed_path_family"]["bundles"]
2026-11-13T05:48:00.9021999Z                        if b["path"] == path)
2026-11-13T05:48:00.9022330Z         assert fresh_by_path[path]["defect_histogram"] == art_row["defect_histogram"], path
2026-11-13T05:48:00.9022732Z         assert fresh_by_path[path]["n_verified"] == art_row["n_verified"], path
2026-11-13T05:48:00.9023132Z         assert fresh_by_path[path]["n_verified_defective"] == art_row["n_verified_defective"], path
2026-11-13T05:48:00.9023491Z     sub = [fresh_by_path[p] for p in art_paths]
2026-11-13T05:48:00.9023724Z     hist_sum: dict[str, int] = {}
2026-11-13T05:48:00.9023924Z     for b in sub:
2026-11-13T05:48:00.9024118Z         for cls, n in b["defect_histogram"].items():
2026-11-13T05:48:00.9024368Z             hist_sum[cls] = hist_sum.get(cls, 0) + n
2026-11-13T05:48:00.9024688Z     assert hist_sum == committed["fixed_path_family"]["totals"]["defect_histogram"]
2026-11-13T05:48:00.9025050Z     assert sum(b["n_verified"] for b in sub) == \
2026-11-13T05:48:00.9025393Z         committed["fixed_path_family"]["totals"]["n_verified"]
2026-11-13T05:48:00.9025687Z     assert sum(b["n_verified_defective"] for b in sub) == \
2026-11-13T05:48:00.9026105Z         committed["fixed_path_family"]["totals"]["n_verified_defective"]
2026-11-13T05:48:00.9026482Z     assert len(fresh["fixed_path_family"]["bundles"]) >= len(art_paths)
2026-11-13T05:48:00.9026842Z     # the historical all-committed defect histogram is reproduced exactly
2026-11-13T05:48:00.9027398Z     assert (fresh["all_committed"]["totals"]["defect_histogram"]
2026-11-13T05:48:00.9027712Z             == committed["all_committed"]["totals"]["defect_histogram"])
2026-11-13T05:48:00.9028030Z 
2026-11-13T05:48:00.9028033Z 
2026-11-13T05:48:00.9028220Z def test_historical_defects_are_published_beside_the_fixed_path_family() -> None:
2026-11-13T05:48:00.9028614Z     rec = _load(PROBE_ART)
