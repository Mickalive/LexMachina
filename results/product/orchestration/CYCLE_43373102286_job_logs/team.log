2026-11-13T05:38:58.3548032Z #!/usr/bin/env python3
2026-11-13T05:38:58.3554721Z """One-command offline clickable slice: frozen question -> bundle -> verified map.
2026-11-13T05:38:58.3555030Z 
2026-11-13T05:38:58.3555201Z     python product/offline_slice.py                      # rent-default fixture
2026-11-13T05:38:58.3555611Z     python product/offline_slice.py --slug business-judgment-rule --verify
2026-11-13T05:38:58.3556025Z     python product/offline_slice.py --no-enrich          # map-only, skip answer
2026-11-13T05:38:58.3556255Z 
2026-11-13T05:38:58.3556396Z What it proves in a single command (no network, no owner time):
2026-11-13T05:38:58.3556590Z 
2026-11-13T05:38:58.3556748Z * ``query -> query_result_bundle`` from the recorded OpenCaseLaw envelopes
2026-11-13T05:38:58.3557349Z   (``retrieval_mode="fixture"``, ``socket.connect`` booby-trapped so any
2026-11-13T05:38:58.3557651Z   network attempt fails loudly);
2026-11-13T05:38:58.3557936Z * the sourced answer + counter-authority pass of the SAME loop, from the
2026-11-13T05:38:58.3558310Z   generative-audit fixture provider (``fixture_generation=True``), so the
2026-11-13T05:38:58.3558888Z   offline slice covers question -> answer -> counter -> map, not just the map;
2026-11-13T05:38:58.3559288Z * enrichment never moves a rendered point (the geometry of the first map is
2026-11-13T05:38:58.3559606Z   compared row by row against the final bundle);
2026-11-13T05:38:58.3559906Z * the bundle is a *clickable* map input: every row carries ``x`` / ``y`` /
2026-11-13T05:38:58.3560261Z   ``cluster_id`` and a ``canonical_url`` source link, and every decision the
2026-11-13T05:38:58.3560570Z   answer cites is reachable from the answer panel;
2026-11-13T05:38:58.3560897Z * ``product/verify_query_page.js`` (the product's own DOM contract) renders it,
2026-11-13T05:38:58.3561250Z   so "source-linked clickable map" is checked, not asserted.
2026-11-13T05:38:58.3561440Z 
2026-11-13T05:38:58.3561588Z It is a developer/CI entry point for the FAST-MVP vertical slice. It never
2026-11-13T05:38:58.3561960Z touches the network, never claims legal usefulness, and never evaluates a
2026-11-13T05:38:58.3562298Z frozen live gate (fixture runs are wiring evidence only).
2026-11-13T05:38:58.3562547Z """
2026-11-13T05:38:58.3562716Z from __future__ import annotations
2026-11-13T05:38:58.3562848Z 
2026-11-13T05:38:58.3562924Z import argparse
2026-11-13T05:38:58.3563085Z import json
2026-11-13T05:38:58.3563238Z import socket
2026-11-13T05:38:58.3563402Z import subprocess
2026-11-13T05:38:58.3563563Z import sys
2026-11-13T05:38:58.3563716Z import time
2026-11-13T05:38:58.3563889Z from pathlib import Path
2026-11-13T05:38:58.3564012Z 
2026-11-13T05:38:58.3564115Z PRODUCT_ROOT = Path(__file__).resolve().parent
2026-11-13T05:38:58.3564353Z REPO_ROOT = PRODUCT_ROOT.parent
2026-11-13T05:38:58.3564570Z sys.path.insert(0, str(PRODUCT_ROOT))
2026-11-13T05:38:58.3564792Z sys.path.insert(0, str(REPO_ROOT))
2026-11-13T05:38:58.3564920Z 
2026-11-13T05:38:58.3565068Z # RF1: one shared definition of "counter authority" across the product.
2026-11-13T05:38:58.3565394Z from product.query.counter_status import (  # noqa: E402
2026-11-13T05:38:58.3565837Z     counter_authority_count,
2026-11-13T05:38:58.3566043Z     counter_status_bearing_count,
2026-11-13T05:38:58.3566238Z )
2026-11-13T05:38:58.3566459Z from product.query.bundle import content_coverage  # noqa: E402
2026-11-13T05:38:58.3566653Z 
2026-11-13T05:38:58.3566732Z DEFAULT_SLUG = "rent-default"
2026-11-13T05:38:58.3566848Z 
2026-11-13T05:38:58.3566851Z 
2026-11-13T05:38:58.3566997Z def _no_network(*_a, **_k):  # pragma: no cover - exercised on every run
2026-11-13T05:38:58.3567334Z     raise AssertionError("offline slice attempted network access")
2026-11-13T05:38:58.3567534Z 
2026-11-13T05:38:58.3567537Z 
2026-11-13T05:38:58.3567618Z def _geometry(bundle: dict) -> dict:
2026-11-13T05:38:58.3567826Z     return {
2026-11-13T05:38:58.3568053Z         d.get("decision_id"): (d.get("x"), d.get("y"), d.get("cluster_id"))
2026-11-13T05:38:58.3568340Z         for d in bundle.get("decisions") or []
2026-11-13T05:38:58.3568575Z     }
2026-11-13T05:38:58.3568655Z 
2026-11-13T05:38:58.3568658Z 
2026-11-13T05:38:58.3569005Z def build_bundle(slug: str, top_n: int, *, enrich: bool = True) -> dict:
2026-11-13T05:38:58.3569370Z     from query import enrich_query_bundle, run_query_initial
2026-11-13T05:38:58.3569636Z     from reality_check import LEGS
2026-11-13T05:38:58.3569773Z 
2026-11-13T05:38:58.3569845Z     if slug not in LEGS:
2026-11-13T05:38:58.3570122Z         raise SystemExit(f"unknown slug {slug!r}; known: {', '.join(sorted(LEGS))}")
2026-11-13T05:38:58.3570443Z     real_connect = socket.socket.connect
2026-11-13T05:38:58.3570682Z     socket.socket.connect = _no_network
2026-11-13T05:38:58.3570883Z     try:
2026-11-13T05:38:58.3571245Z         initial = run_query_initial(LEGS[slug], top_n=top_n, retrieval_mode="fixture")
2026-11-13T05:38:58.3571567Z         if not enrich:
2026-11-13T05:38:58.3571750Z             return initial
2026-11-13T05:38:58.3572016Z         # Full offline loop: sourced answer + counter-authority pass from the
2026-11-13T05:38:58.3572392Z         # fixture provider. Hydration/generation/adversarial retrieval are all
2026-11-13T05:38:58.3572784Z         # fixture-configured, so the network trap above stays armed throughout.
2026-11-13T05:38:58.3573084Z         final = enrich_query_bundle(
2026-11-13T05:38:58.3573353Z             initial, retrieval_mode="fixture", fixture_generation=True)
2026-11-13T05:38:58.3573662Z         before, after = _geometry(initial), _geometry(final)
2026-11-13T05:38:58.3573907Z         preserved = (
2026-11-13T05:38:58.3574091Z             set(before) <= set(after)
2026-11-13T05:38:58.3574351Z             and all(after.get(did) == geo for did, geo in before.items())
2026-11-13T05:38:58.3574611Z         )
2026-11-13T05:38:58.3574820Z         final.setdefault("provenance", {})["offline_slice"] = {
2026-11-13T05:38:58.3575080Z             "enriched": True,
2026-11-13T05:38:58.3575283Z             "geometry_preserved": preserved,
2026-11-13T05:38:58.3575502Z             "n_first_map": len(before),
2026-11-13T05:38:58.3575719Z             "n_final": len(after),
2026-11-13T05:38:58.3575924Z             "network": "none",
2026-11-13T05:38:58.3576105Z         }
2026-11-13T05:38:58.3576254Z         return final
2026-11-13T05:38:58.3576419Z     finally:
2026-11-13T05:38:58.3576596Z         socket.socket.connect = real_connect
2026-11-13T05:38:58.3576741Z 
2026-11-13T05:38:58.3576745Z 
2026-11-13T05:38:58.3576829Z def _repo_relative(path: Path) -> str:
2026-11-13T05:38:58.3577144Z     """Repo-relative when inside the checkout, absolute otherwise (``--out`` may
2026-11-13T05:38:58.3577526Z     legitimately point at a scratch directory outside the repository)."""
2026-11-13T05:38:58.3577817Z     try:
2026-11-13T05:38:58.3577996Z         return str(path.relative_to(REPO_ROOT))
2026-11-13T05:38:58.3578220Z     except ValueError:
2026-11-13T05:38:58.3578398Z         return str(path)
2026-11-13T05:38:58.3578507Z 
2026-11-13T05:38:58.3578510Z 
2026-11-13T05:38:58.3578602Z def summarise(bundle: dict) -> dict:
2026-11-13T05:38:58.3578997Z     rows = bundle.get("decisions") or []
2026-11-13T05:38:58.3579319Z     clusters: dict = {}
2026-11-13T05:38:58.3579494Z     for r in rows:
2026-11-13T05:38:58.3579668Z         cid = r.get("cluster_id")
2026-11-13T05:38:58.3579859Z         if cid is None:
2026-11-13T05:38:58.3580102Z             continue  # a None-keyed bucket is not a cluster (audit D3)
2026-11-13T05:38:58.3580383Z         clusters[cid] = clusters.get(cid, 0) + 1
2026-11-13T05:38:58.3580678Z     # RF1: the old test was `counter_status.startswith("candidate")`, which is
2026-11-13T05:38:58.3581038Z     # both too narrow (it misses `abstained_unevidenced`, a real counter status
2026-11-13T05:38:58.3581412Z     # the frozen counter-anchor classifier emits) and definitionally wrong. Use
2026-11-13T05:38:58.3581757Z     # the accepted single source of truth and publish both counts.
2026-11-13T05:38:58.3582048Z     counter_authorities = counter_authority_count(rows)
2026-11-13T05:38:58.3582342Z     counter_status_bearing = counter_status_bearing_count(rows)
