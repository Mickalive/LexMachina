{
  "schema": "frontier-query-conditioned-map-geometry/non-vacuity-divergence/1",
  "charter_requirement": "acceptance check (4): a permuted-cluster-label control must FAIL the coherence criteria, and a second control in which coordinates are shuffled must fail PROJ_RANK / PROJ_SPEARMAN; if a control passes the harness is vacuous and the run is void.",
  "charter_literal_satisfied": false,
  "why_charter_literal_not_satisfiable": {
    "PROJ_RANK_is_coordinate_invariant": true,
    "mechanism": "The frozen scorer computes PROJ_RANK as the Spearman correlation between the retrieval 'rank' field and the TF-IDF cosine distance to the query vector (vendored metrics.py: rank_rho). It never reads the 2-D coordinates x/y, so no coordinate permutation -- shuffled or otherwise -- can change it, for any candidate geometry. STRUCTURE_SEP is coordinate-invariant for the same reason: it is computed from X and cluster_id, not from the layout.",
    "PROJ_SPEARMAN_and_PROJ_KNN10_do_read_coordinates": "Both move sharply under coordinate permutation, which is the positive evidence that the harness is not vacuous. They do not flip their verdict only because both variants already score below the bar (PROJ_SPEARMAN 0.50, PROJ_KNN10 0.40) on all three bundles, so corruption can only push the value further down.",
    "consequence": "The charter's second control is unsatisfiable as written, for a reason internal to the frozen rule and independent of the variants under test. It was NOT worked around: it is reported as unsatisfied here."
  },
  "frozen_rule_is_the_binding_authority": {
    "rule_non_vacuity": {
      "control": "Permute cluster_id assignment across rows (seed 0) and permute label texts across cluster ids; recompute all criteria. Identical otherwise.",
      "required": "Corrupted geometry must flip >= 2 criteria verdicts (passed=true). Each non-vacuity number attached to its control; flips reported per control (RF4)."
    },
    "max_verdict_flips_from_permutation_control": 2,
    "frozen_rule_requirement_met": true,
    "per_control": {
