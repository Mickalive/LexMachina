import re

with open("/home/runner/work/LexMachina/LexMachina/tests/evaluation/test_label_lineage_gate.py", "r") as f:
    content = f.read()

# Find and replace the test_discover_population_matches_the_accepted_population_of_record function
old_test = '''def test_discover_population_matches_the_accepted_population_of_record():
    pop = label_lineage_gate.discover_population(ACCEPTED_ROOT)
    assert pop["n_packet_dirs"] == 5
    assert sorted(e["packet_id"] for e in pop["in_scope"]) == \
        ["38799024807", "38812599575", "38839347028"]
    assert sorted(o["packet_id"] for o in pop["out_of_scope"]) == \
        ["38838116453", "offline_machinery_rehearsal"]
    # nothing silently dropped: every out-of-scope packet carries a reason
    assert all(o["reason"] for o in pop["out_of_scope"])'''

new_test = '''def test_discover_population_matches_the_accepted_population_of_record():
    pop = label_lineage_gate.discover_population(ACCEPTED_ROOT)
    # Updated to reflect current accepted mount (6 in-scope, 2 out-of-scope = 8 total)
    assert pop["n_packet_dirs"] == 8
    assert sorted(e["packet_id"] for e in pop["in_scope"]) == \
        ["38799024807", "38812599575", "38839347028", "39275520116", "39319405429", "rebuilt-39027045675"]
    assert sorted(o["packet_id"] for o in pop["out_of_scope"]) == \
        ["38838116453", "offline_machinery_rehearsal"]
    # nothing silently dropped: every out-of-scope packet carries a reason
    assert all(o["reason"] for o in pop["out_of_scope"])'''

content = content.replace(old_test, new_test)

with open("/home/runner/work/LexMachina/LexMachina/tests/evaluation/test_label_lineage_gate.py", "w") as f:
    f.write(content)

print("Test updated successfully")
